{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/browser/**/*.ts",
    "src/protocol/messages.ts",
    "src/editor/client/**/*.ts",
    "src/editor/client/**/*.d.ts",
    "src/editor/schema.ts",
    "src/editor/palette.ts",
    "src/editor/glyph.ts",
    "src/editor/terminal-cell.ts",
    "src/editor/ascii-path.ts",
    "src/editor/art-cursor.ts",
    "src/editor/art-tabs.ts"
  ]
}
