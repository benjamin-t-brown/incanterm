{
  "name": "incanterm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-run terminal adventure",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,browser -c cyan,magenta \"tsx watch --clear-screen=false src/server/index.ts\" \"vite\"",
    "client": "tsx src/client/index.ts",
    "server": "tsx watch --clear-screen=false src/server/index.ts",
    "scene": "tsx src/game/preview.ts",
    "editor": "vite --config vite.editor.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:server && npm run build:client && npm run build:browser",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "build:client": "esbuild src/client/index.ts --bundle --platform=node --format=esm --outfile=dist/client.js --packages=external",
    "build:browser": "vite build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
