@@ -0,0 +1,47 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const { getDefinition } = require('../../../dist/rpgscript/definition');
+const { disableConsole } = require('../../../dist/logger');
+const { setCurrentSettings } = require('../../../dist/settings');
+
+const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'rpgscript-command-definition-'));
+try {
+  const file = path.join(directory, 'scene-commands.ts');
+  fs.writeFileSync(file, [
+    'const approachSlideProp = defineCommand({',
+    '  parse: (args) => ({ prop: args[0] }),',
+    '});',
+    'export const commands = {',
+    '  approachSlideProp,',
+    '};',
+  ].join('\n'));
+  disableConsole();
+  setCurrentSettings({ sceneCommandsPath: file });
+
+  const name = 'approachSlideProp';
+  const direct = getDefinition(`+${name}([instance])`, 1);
+  assert.equal(direct.targetUri, pathToFileURL(file).href);
+  assert.equal(direct.targetSelectionRange.start.line, 0);
+
+  for (const source of [
+    `+[ready]=${name}([instance])`,
+    `  +[ready] = +${name} ([instance]); // move first`,
+    `+puzzle.ready = ${name}("a//b");\r`,
+  ]) {
+    const start = source.indexOf(name);
+    assert.deepEqual(getDefinition(source, start), direct, source);
+    assert.deepEqual(getDefinition(source, start + name.length - 1), direct, source);
+    assert.equal(getDefinition(source, source.indexOf('ready')), undefined, source);
+    assert.equal(getDefinition(source, source.indexOf('(') + 1), undefined, source);
+  }
+
+  for (const rhs of [`"${name}()"`, `?${name}()`, `|${name}()|`, 'missing()']) {
+    const source = `+[ready]=${rhs}`;
+    assert.equal(getDefinition(source, source.indexOf('(') - 1), undefined, source);
+  }
+} finally {
+  fs.rmSync(directory, { recursive: true, force: true });
+}
