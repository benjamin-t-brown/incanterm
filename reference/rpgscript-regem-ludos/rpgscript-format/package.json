{
  "name": "rpgscript-format",
  "displayName": "rpgscript-format",
  "description": "",
  "version": "0.0.1",
  "publisher": "revirtualis",
  "engines": {
    "npm": ">=11.10.0",
    "vscode": "^1.6.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:rpgscript"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "languages": [
      {
        "id": "rpgscript",
        "aliases": [
          "RPGScript",
          "rpgscript"
        ],
        "extensions": [
          ".rpgscript"
        ]
      }
    ],
    "commands": [
      {
        "command": "extension.format-rpgscript",
        "title": "Format RPGscript Files"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "postinstall": "node ./node_modules/vscode/bin/install"
  },
  "devDependencies": {
    "@types/node": "*",
    "vscode": "1.1.37",
    "typescript": "^4.7.4"
  }
}
