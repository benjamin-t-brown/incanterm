#################################################################
## Iro
################################################################ 
##
## * Press Ctrl + '+'/'-' To Zoom in
## * Press Ctrl + S to save and recalculate... 
## * Documents are saved to web storage.
## * Only one save slot supported.
## * Matches cannot span lines.
## * Unicode chars must be defined in \u0000 to \uffff format.
## * All matches must be contained by a single group ( ... )
## * Look behinds not permitted, (?<= or (?<!
## * Look forwards are permitted (?= or (?!
## * Constants are defined as __my_const = (......)
## * The \= format allows unescaped regular expressions
## * Constants referenced by match \= $${__my_const}
## * Constants can reference other constants
## * You are free to delete all the default scopes.
## * Twitter : ainslec , Web: http://eeyo.io/iro
##
################################################################

name                   = rpgscript
file_extensions []     = rpgscript;

###########################or#####################################
## Constants
################################################################

__MY_CONSTANT \= (\b[a-z][a-z0-9]*)
__LOGICKEYWORD \= (\?)
__LOGIC \= (\b(isnot|gt|lt|is|all|any|else|oncePerInstance|one|as|once|eq|this|with|func)\b)
__TRIGGERNAME \= (^#(.)+$)
__SCENENAME \= (^(\s)*@[^\s()]+)
__INLINE \= (^(\s)*\+(.)+$)
__DIALOG \= ((^(\s)*[\w &]*:)|(^(\s)+([\w&])+:))
__TRIGGERTYPE \= (^(\s)*(action|step|item|step-first|step-off|load|timer),)
__STORAGE \= (^(\s)*(\+setStorage))
__INLINE_SCRIPT \= (^(\s)*(\+:([\w-]*)))

################################################################
## Styles
################################################################

styles [] {

.comment : style {
   color                 = light_green
   italic                = true
   ace_scope             = comment
   textmate_scope        = comment
   pygments_scope        = Comment
}

.other : style {
   color                 = white
   ace_scope             = other
   textmate_scope        = other
   pygments_scope        = Keyword
}

.number : style {
   color                 = purple
   textmate_scope        = variable.other.constant
   ace_scope             = other
   pygments_scope        = Keyword
}

.punctuation : style {
   color                 = grey
   ace_scope             = punctuation
   textmate_scope        = punctuation.terminator.statement
   pygments_scope        = Punctuation
}

.text : style {
   color                 = brown
   ace_scope             = text
   textmate_scope        = string
   pygments_scope        = String
}

## Call parentheses use .control or .inline_function to match the call type.
## Keep parentheses out of language-configuration.json's colorizedBracketPairs
## so VS Code/Cursor uses
## these TextMate scopes instead of overriding them with nesting-depth colors.
.control : style {
   color                 = red
   ace_scope             = control
   textmate_scope        = keyword.operator.assignment
   pygments_scope        = Keyword
}

.function : style {
   color                 = cyan
   ace_scope             = function
   textmate_scope        = storage.type.function
   pygments_scope        = Keyword
}

.inline_function : style {
   color                 = green
   ace_scope             = function
   textmate_scope        = entity.name.function
   pygments_scope        = Keyword
}

.scene : style {
   color                 = purple
   ace_scope             = constant
   textmate_scope        = constant
   pygments_scope        = Keyword
}

.dialog : style {
   color                 = purple
   ace_scope             = storage
   textmate_scope        = entity.name.function
   pygments_scope        = Keyword
}

.parameter : style {
   color                 = orange
   ace_scope             = parameter
   textmate_scope        = variable.parameter
   pygments_scope        = Keyword
}

.illegal : style {
   color                 = white
   background_color      = red
   ace_scope             = invalid
   textmate_scope        = invalid
   pygments_scope        = Generic.Error
}

}

#################################################
## Parse contexts
#################################################

contexts [] {

##############################################
## Main Context - Entry point context
##############################################

main : context {
   : pattern {
      regex          \= (?:^\s*|(?<=:)\s*)(\+?)(!(?:break|continue|returnempty)\b)
      styles []       = .control, .control;
   }
   : inline_push {
      regex          \= (^\s*<)
      styles []       = .control;
      : eol_pop {}
      : include "in_parens" ;
   }
   : inline_push {
      regex          \= $${__STORAGE}
      styles []       = .control;
      : eol_pop {}
      : pattern {
         regex       \= (\()
         styles []    = .control;
      }
      : pattern {
         regex       \= (\))
         styles []    = .control;
      }
      : include "in_parens" ;
   }
   
   : inline_push {
      regex          \= $${__INLINE_SCRIPT}
      styles []       = .inline_function;
      : eol_pop {}
      : pattern {
         regex       \= ([()])
         styles []    = .inline_function;
      }
      : include "in_parens" ;
   }

   : inline_push {
      regex          \= $${__SCENENAME}
      styles []       = .function;
      : eol_pop {}
      : pattern {
         regex       \= ([()])
         styles []    = .function;
      }
      : include "in_parens" ;
   }
   
   : pattern {
      regex          \= $${__TRIGGERNAME}
      styles []       = .dialog;
   }

   : pattern {
      regex          \= $${__DIALOG}
      styles []       = .function;
   }

   : push {
      regex          \= $${__TRIGGERTYPE}
      styles []       = .dialog;
      context []      = trigger;
   }

   : inline_push {      
      regex          \= (\?)
      styles []       = .control;
      : pop {
         regex       \= (:)
         styles []    = .control;
      }
      : include "logic" ;

   }

   : inline_push {
      regex          \= (^(\s)*\+)
      styles []       = .control;
      : eol_pop {}
      : include "storage_assignment" ;
      : inline_push {
         regex          \= (')
         styles []       = .punctuation;
         : pop {
            regex       \= (')
            styles []    = .punctuation;
         }
         : include "in_dialog" ;
      }
      : inline_push {
         regex          \= (\()
         styles []       = .control;
         : pop {
            regex       \= (\))
            styles []    = .control;
         }
         : pattern {
            regex       \= (,)
            styles []    = .punctuation;
         }
         : include "in_parens" ;
      }
      : inline_push {
         regex          \= (\?)
         styles []       = .control;
         : pop {
            regex       \= (:)
            styles []    = .control;
         }
         : include "logic" ;
      }
      : inline_push {
         regex          \= (\{)
         styles []       = .punctuation;
         : pop {  
            regex       \= (\})
            styles []    = .punctuation;
         }
         : include "main" ;
      }
   }
   
   : inline_push {
      regex          \= (\{)
      styles []       = .punctuation;
      : pop {  
         regex       \= (\})
         styles []    = .punctuation;
      }
      : include "main" ;
   }
   
   : inline_push {
      regex          \= (\")
      styles []       = .punctuation;
      // default_style   = .text
      : pop {
         regex       \= (\")
         styles []    = .punctuation;
      }
      : include "in_dialog" ;
   }
   
   : include "multi_line_comment" ;
   
   : pattern {
      regex          \= (//.*)
      styles []       = .comment;
   }
   
   : inline_push {
      regex          \= (^(\s)*=)
      styles []       = .comment;
      : eol_pop {}
      : include "in_eq" ;     
   }
   
   : pattern {
      regex          \= ([^\s])
      styles []       = .illegal;
   }
   
}

#################################################
## End of Contexts
#################################################

storage_assignment : context {
   : inline_push {
      regex          \= (?=\^?(?:[A-Za-z_][\w-]*(?:\.[A-Za-z_][\w-]*)*|\{[A-Za-z_][\w-]*(?:\.[A-Za-z_][\w-]*)*\}|\[[A-Za-z_][\w-]*\])\s*(?:=|<(?=\s*\+:)))
      : eol_pop {}
      : pattern {
         regex       \= (\^|=|<)
         styles []    = .control;
      }
      : inline_push {
         regex       \= (\+:[\w-]+)
         styles []    = .inline_function;
         : eol_pop {}
         : pattern {
            regex    \= ([()])
            styles [] = .inline_function;
         }
         : include "in_parens" ;
      }
      : include "in_parens" ;
   }
}

logic_prefix : context {
   : inline_push {
      regex          \= (\+?\?)
      styles []       = .control;
      : pop {
         regex       \= (:)
         styles []    = .control;
      }
      : include  "logic";
   }
}

logic : context {
   : pattern {
      regex          \= (\belse\b(?=\s*:))
      styles []       = .control;
   }
   : pattern {
      regex          \= (\b(?:elseif|while)\b(?=\s))
      styles []       = .control;
   }
   : inline_push {
      regex          \= $${__LOGIC}
      styles []       = .control;
       : pop {
          regex       \= (\))
          styles []    = .control;
       }
       : pattern {
          regex \= (\()
          styles []    = .control;
       }
      : include "logic";
      : include "in_parens";
   }
}

trigger : context {
   : eol_pop {}
   : include "logic_prefix" ;
   : pattern {
      regex \= ([\w ]+(?=,\s*-?[0-9]+\s*$))
      styles [] = .function;
   }
   : pattern {
      regex \= ((?<=,)\s*-?[0-9]+(?=\s*(?:,|$)))
      styles [] = .number;
   }
   : pattern {
      regex \= ([\w ]*,)
      styles [] = .parameter;
   }
   : pattern {
      regex \= ([\w-]+)
      styles [] = .function;
   }
}

in_dialog : context {
   : pattern {
      regex \= (<.+?>)
      styles [] = .parameter;
   }
   : pattern {
      regex \= (\{[\w\d_\-\. ]*\})
      styles [] = .punctuation;
   }
   : pattern {
      regex \= (\[[\w\d_\-\. ]*\])
      styles [] = .punctuation;
   }
   : pattern {
      regex \= (.)
      styles [] = .text;
   }
}

in_parens : context {
   : pattern {
      regex          \= (,)
      styles []       = .punctuation;
   }
   : inline_push {
      regex          \= (')
      styles []       = .punctuation;
      // default_style   = .text
      : pop {
         regex       \= (')
         styles []    = .punctuation;
      }
      : pattern {
         regex \= (\{[\w\d_\-\. ]*\})
         styles [] = .punctuation;
      }
      : pattern {
         regex \= (\[[\w\d_\-\. ]*\])
         styles [] = .punctuation;
      }
      : pattern {
         regex          \= (\w\.*)
         styles []       = .text;
      }
   }
      : inline_push {
      regex          \= (")
      styles []       = .punctuation;
      // default_style   = .text
      : pop {
         regex       \= (")
         styles []    = .punctuation;
      }
      : pattern {
         regex \= (\{[\w\d_\-\. ]*\})
         styles [] = .punctuation;
      }
      : pattern {
         regex \= (\[[\w\d_\-\. ]*\])
         styles [] = .punctuation;
      }
      : pattern {
         regex          \= (\w\.*)
         styles []       = .text;
      }
   }
   : pattern {
      regex \= (\{[\w\d_\-\. ]*\})
      styles [] = .punctuation;
   }
   : pattern {
      regex \= (\[[\w\d_\-\. ]*\])
      styles [] = .punctuation;
   }
   :  pattern {
      regex          \= (-?[0-9]|\b(true|false)\b(?![\w.-]))
      styles []       = .number;
   }
   :  pattern {
      regex          \= ([a-zA-Z_\-][\w.-]*)
      styles []       = .parameter;
   }
   : inline_push {
      regex          \= (\{)
      styles []       = .punctuation;
      : pop {  
         regex       \= (\})
         styles []    = .punctuation;
      }
      : pattern {
         regex          \= (\w)
         styles []       = .number;
      }
   }
}

multi_line_comment : context {
   description        = multiline
   : inline_push {
      regex          \= (/\*)
      styles []       = .comment;
      default_style   = .comment
      : pop {
         regex       \= (\*/)
         styles []    = .comment;
      }
   }
}

in_eq : context {
   :  pattern {
      regex          \= ([,\s]-?[0-9]+)
      styles []       = .number;
   }
   : pattern {
      regex \= ([,\s][\w]*)
      styles [] = .parameter;
   }
   : inline_push {
      regex          \= (')
      styles []       = .punctuation;
      // default_style   = .text
      : pop {
         regex       \= (')
         styles []    = .punctuation;
      }
      : pattern {
         regex \= (\{[\w\d_\-\. ]*\})
         styles [] = .punctuation;
      }
      : pattern {
         regex \= (\[[\w\d_\-\. ]*\])
         styles [] = .punctuation;
      }
      : pattern {
         regex          \= (\w\.*)
         styles []       = .text;
      }
   }
   : inline_push {
      regex          \= (")
      styles []       = .punctuation;
      // default_style   = .text
      : pop {
         regex       \= (")
         styles []    = .punctuation;
      }
      : pattern {
         regex \= (\{[\w\d_\-\. ]*\})
         styles [] = .punctuation;
      }
      : pattern {
         regex \= (\[[\w\d_\-\. ]*\])
         styles [] = .punctuation;
      }
      : pattern {
         regex          \= (\w\.*)
         styles []       = .text;
      }
   }
   : pattern {
      regex \= ([\w]+)
      styles [] = .punctuation;
   }
}
   
}
