{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "sourceMap": true,
    "rootDir": ".",
    "strictNullChecks": true,
    "allowJs": false,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true
  },
  "exclude": ["dist", "node_modules", ".vscode-test", "../../node_modules"]
}
