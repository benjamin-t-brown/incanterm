#test-setStorageCond
  action,this
@this
  +setStorage('someValue', 1)
  +setStorageCond('result', 'eq(someValue, 2)')
  +setConversation(Ada)
  +?is(result):{
    Ada: "The result is true."
  }
  +?isnot(result):{
    Ada: "The result is false."
  }
  +endConversation()

