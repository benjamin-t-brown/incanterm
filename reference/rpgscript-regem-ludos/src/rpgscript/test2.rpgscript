#test-portraits-with-emotions
  action,this
@this
  +setConversation(Ada)
  Ada: "This is my default portrait."
  Ada&2: "This is my old portrait."
  Ada: "This is my default portrait."
  Ada&2: "This is my default old portrait."
  +endConversation(100, true)
  +setConversation2(Ada, Conscience)
  Ada: "This is my default portrait."
  Conscience: "Hey there!"
  Ada&2: "This is my old portrait."
  Conscience: "Hey there again!"
  Ada: "This is back to my default portrait."
  +endConversation()

