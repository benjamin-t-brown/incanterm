  Conscience: "Hey there!"
  Ada&2: "This is a portrait with blink."
  Conscience: "Hey there again!"
  Ada: "This is back to my default portrait."
  Conscience: "Hey there again again!"
  Ada&2: "This is back to my blink portrait."
  Conscience: "Hey there again again again!"
  +endConversation()

