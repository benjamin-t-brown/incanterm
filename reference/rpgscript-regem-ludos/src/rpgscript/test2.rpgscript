// ARG0 = marker
// ARG1 = distance to apply z transform
@testPlatform_tilesLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +log("Apply z transform MarkerPlatform1, {ARG0}, {ARG1}, {tmp.x}, {tmp.y}, 1000, true")
  +applyZTransformTileAtMarkerEx({ARG0}, {ARG1}, {tmp.x}, {tmp.y}, 1000, true)

// ARG0 = marker
// ARG1 = tileLayerPrefix
@testPlatform_tilesLayerLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +swapTileLayerTileAtMarker({ARG1}, {ARG0}, {tmp.x}, {tmp.y})

@testPlatformDown_TilesLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +applyZTransformTileAtMarkerEx(MarkerPlatform1, -84, {tmp.x}, {tmp.y}, 1000, true)
@testPlatformDown_TileLayerLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +swapTileLayerTileAtMarker('Default', MarkerPlatform1, {tmp.x}, {tmp.y})
  
#testPlatformDown
  action,this
@this
  +setStorageEval('tmp.zFloor', -(64*2))
  +setStorageEval('tmp.cameraOffset', '-({tmp.zFloor}/2)')
  +setUnskippableConversation(Ada)
  +walkToMarker(Party, MarkerPlatform1)
  +:w(100)
  +:ld(Ada, up)
  +walkPartyToFormation(false, 8)
  +panCameraRelativeToPlayer(0, {tmp.cameraOffset}, 1000, true)
  +applyZTransform('Party', {tmp.zFloor}, 1000, false, true)
  +setStorageEval(tmp.offsets, "[[0, 0], [16, 16], [16, -16], [-16, 16], [-16, -16], [16, 0], [0, 16], [-16, 0], [0, -16]]")
  // +loop("testPlatformDown_TilesLoop", 9)
  +loop("testPlatform_tilesLoop(MarkerPlatform1, {tmp.zFloor})", 9)
  +:w(1000)
  // +loop("testPlatformDown_TileLayerLoop", 9)
  +loop("testPlatform_tilesLayerLoop(MarkerPlatform1, Default)", 9)
  +setRoomTileLayer('Default')
  +panCameraBackToPlayer(1)
  +endConversation()
  // +setStorageEval

@testPlatformUp_TilesLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +applyZTransformTileAtMarkerEx(MarkerPlatform2, 84, {tmp.x}, {tmp.y}, 1000, true)
@testPlatformUp_TileLayerLoop
  +setStorageValueAt(tmp.x, tmp.offsets.{i}.0)
  +setStorageValueAt(tmp.y, tmp.offsets.{i}.1)
  +swapTileLayerTileAtMarker('Top', MarkerPlatform2, {tmp.x}, {tmp.y})

#testPlatformUp
  action,this
@this
  +setStorageEval('tmp.zFloor', (64*2))
  +setStorageEval('tmp.cameraOffset', '-({tmp.zFloor}/2)')
  +setUnskippableConversation(Ada)
  +walkToMarker(Party, MarkerPlatform2)
  +:w(100)
  +:ld(Ada, up)
  +walkPartyToFormation(false, 8)
  +panCameraRelativeToPlayer(0, {tmp.cameraOffset}, 1000, true)
  +applyZTransform('Party', {tmp.zFloor}, 1000, false, true)
  +setStorageEval(tmp.offsets, "[[0, 0], [16, 16], [16, -16], [-16, 16], [-16, -16], [16, 0], [0, 16], [-16, 0], [0, -16]]")
  // +loop("testPlatformUp_TilesLoop", 9)
