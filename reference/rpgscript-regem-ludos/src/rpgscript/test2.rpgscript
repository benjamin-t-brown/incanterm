  +loop("testPlatform_tilesLoop(MarkerPlatform2, {tmp.zFloor})", 9)
  +:w(1000)
  // +loop("testPlatformDown_TileLayerLoop", 9)
  +loop("testPlatform_tilesLayerLoop(MarkerPlatform2, Top)", 9)
  +setRoomTileLayer('Top')
  +panCameraBackToPlayer(1)
  +endConversation()

#test2_weird_camera
  action,this
@this
  +setConversationGroup(Ada, Test2TestWeirdCamera)
  Ada: "Testing weird camera."
  +none()
  +walkToOffset(Party, 0, 16)
  +:w(200)
  +setSpeed(Party, 1.5)
  +walkToOffset(Party, 0, 16)
  +:w(100)
  +panCameraBackToPlayer()
  +despawnPartyMembers()
  +setPlayerVisibility(false)
  +:w(500)

  +panCameraRelativeToCurrentPosition(30, -30, 1000)
  
  +spawnCharacterAtMarker(Bartolo, MarkerInvisibleWall2)
  +:face(Bartolo, rightdown)
  +:w(1000)
  +walkToOffset(Bartolo, 39, 0)
  +:leach(Test2TestWeirdCamera, Bartolo)
  +endConversation(100)
  +setConversationGroup(Bartolo, Test2TestWeirdCamera)
  Bartolo: "Well done."
  Test2TestWeirdCamera: "Did it work?"
  +none()
  +spawnPartyMembers(true)
  +setPlayerVisibility(true)
  +panCameraBackToPlayer()
  +endConversation()

