  +setAiState(Floor1PingPongGuyA, pingpong_interrupted, true)
  +setAiState(Floor1PingPongGuyB, pingpong_interrupted, true)
  +lookAtEachOther(Ada, Floor1PingPongGuyB)
  +lookAtEachOther(Ada, Floor1PingPongGuyA)
