  +setConversation('Ada')
  // +stopSkipCutscene();
  Atrium Employee Jason: "Ready to start the tutorial?"
  +awaitChoice('Yes, start the tutorial.', 'No, I am not ready yet.')
  +?eq(lastChoiceIndex, 0):{
