  Ada: "But then NO MORE side-tracks.  I have to go see what <color=LIGHTRED>Carl-Arnold</> wants."
  +setConversationSpeaker(none)
  +waitMS(500)
  +callScript('utils-character-jump', 'Conscience')
  Conscience: "Yay!"
  +:happy(Conscience)
  Conscience: "It'll be worth it, I promise!"
  +startQuest(Tutorial)
  +:ld(Conscience, right)
  Conscience: "I think that <color=LIGHTBLUE>Employee Jason</> guy is over there.  Let's go talk to him!"
  +callScript('utils-stop-Conscience-dialogue')
  +endConversation()
  +setStorage(quest_floor1-atrium_acquire-haptic-bracer)
  +resetAi(AtriumGreeterEmployee)
