  +walkPartyToFormation()
  Atrium Desk Employee: "Hello and welcome to the <color=ORANGE>Regem Ludos Arcade</>! Have you been here before?"
  +setConversationSpeaker(none)
  +setAnimationAndWait('Ada', 'ada_shake_head_down')
  +lookAtEachOther('Ada','Atrium Desk Employee')
  +waitMS(500)
  Ada: "I have not."
  Atrium Desk Employee: "A newcomer? <delay=300 scale=1.25> Wonderful! <delay=300 cascade> Let's get you signed in."
  +setAnimation('Atrium Desk Employee', employee-girl_ovr_gesture_rightup)
  +waitMS(250)
  +:bumpY('Atrium Desk Employee', -2)
  +playSound('blip')
  +waitMS(1000)
  Atrium Desk Employee: "Excellent, <delay=500 cascade> I already see a profile for you."
  +:shakeZ(Atrium Desk Employee)
  Atrium Desk Employee: "Here's some courtesy tokens to get you started on the games here."
  +setConversationSpeaker(none)
  +setAnimationAndWait('Atrium Desk Employee', employee-girl_ovr_gesture_rightup)
  +modifyTokens(10)
  +:happy(Atrium Desk Employee)
