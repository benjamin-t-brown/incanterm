#floor1-east1OpenStorageDoor
  action,this
  load,floor1-east1OpenStorageDoor_load
@floor1-east1OpenStorageDoor_load
  +setStorage(vars.floor1-east1OpenStorageDoor_open, false)
@this
  +setUnskippable(true)
  +setConversation(Ada)
  +?once('d24a628c'):{
    Ada: "There is some kind of strange impression on this door..."
  }
  +walkToMarker(Ada, MarkerFromStorage)
  +:ld(Ada, leftdown)
  +walkPartyToFormation()
  +?is(vars.floor1-east1OpenStorageDoor_open):{
    +playSound(sliding_door_close)
    +:closeDoor(MarkerDoorStorage, DARK_BLOCK_BCK)
    +endConversation()
    +setStorage(vars.floor1-east1OpenStorageDoor_open, false)
    +sbreak()
  }
  +?isnot(vars.floor1-east1OpenStorageDoor_open):{
    +playSound(sliding_door_open)
    +:openDoor(MarkerDoorStorage, DARK_BLOCK_BCK)
    +endConversation()
    +setStorage(vars.floor1-east1OpenStorageDoor_open, true)
    +sbreak()
  }

#floor1-east1StorageOpenStorageDoor
  step-first,this
  step-off,floor1-east1StorageOpenStorageDoor_off
@this
  +playSound(sliding_door_open)
  +:openDoor(MarkerDoor, DARK_BLOCK_BCK)
@floor1-east1StorageOpenStorageDoor_off
  +playSound(sliding_door_close)
  +:closeDoor(MarkerDoor, DARK_BLOCK_BCK)

