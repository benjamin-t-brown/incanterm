
@floor0entrance
  +?once('af197dca'):{
    +fadeOut(1)
  }
#floor0_load
  load,this
@this
  +?once('9574c2e5'):{
    +setPartyWalkBehindLeaderEnabled(false)
    +:floor0_enterRoom()
    // +:floor0_prePhone()
  }

#floor0_employeeTalk
  action,?once('0db7c83e'):floor0_pre1
  action,this
@this
  +setConversation(Ada)
  +:leach(Employee, Ada)
  Employee: "Have fun!"
  +endConversation()

#floor0_ConscienceTalk
  action,this
@this
  +setConversation(Conscience)
  +:leach(Conscience, Ada)
  Conscience: "Hurry up and talk to the employee lady at the front desk!"
  +endConversation()

@floor0_enterRoom
  +setAtMarker(Conscience, MarkerConscience)
  +setAtMarker(Ada, MarkerAdaStart)
  +:face(Ada, rightup)
  +setWallCollisionEnabled(false)
  +setAnimation(Employee, 'characters/employee-entrance_bored_phone')
  +panCameraRelativeToPlayer(75, -75, 1)
  +panCameraRelativeToCurrentPosition(0, 25, 5000, true)
  +setSpeed(Ada, 0.5)
  +:openDoor(MarkerDoor0, WOOD_DOOR_BCK)
  +setConversationGroup(Ada, Employee)
  Ada: "Am I... in the right place?"
  +none()
  +fadeIn(3000, true)
  +playMusic(music_outside_arcade)
  +:w(1000)
  +walkToOffset(Ada, 0, -24)
  +:w(200)
  +walkToOffset(Ada, 0, -32)
  +:w(500)
  +playSound(locked)
  +:closeDoor(MarkerDoor0, WOOD_DOOR_BCK)
  +:question(Ada)
  Ada: "Um.  Excuse me?"
  +:none()
  +:w(200)
  +setAnimation(Employee, 'characters/employee-entrance_bored_look')
  +:exclaim(Employee)
  +:shakeZ(Employee)
  Employee: "Huh?"
  Employee: "Oh.  Sorry.  Didn't see you there."
  +setAnimation(Employee, 'characters/employee-entrance_bored_phone_away')
  +:w(500)
  +setAnimationState('Employee', 'idle')
  +walkToOffset(Employee, 12, 12)
  +:la(Employee, Ada)
  +walkToOffset(Ada, 0, -12)
