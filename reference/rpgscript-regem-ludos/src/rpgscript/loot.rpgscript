// ARG0 the name of the item to acquire
@acquireLoot
  +setConversation(Ada)
  +?once('2a25c1bc'):{
    Ada: "It looks like there is something in here..."
  }
  +none()
  +playSound(get_item)
  +acquireItem([ARG0])
  +endConversation()

@noLoot
  +setConversation(Ada)
  Ada: "Nothing is in there."
  +endConversation()

#loot5Tickets
  action,?oncePerInstance():acquireLoot("TicketCache5")
  action,noLoot

