    +:leach(Anjana, Ada)
    Anjana: "That thing is pretty loud..."
  }
// +setStorage(quest.misc.floor2LaptopGonnaExplode, true);
  +endConversation()

#floor2GuestroomsLaptop
  action,?func(questNotStarted, AFunExpectedJourney):floor2GuestroomsLaptop
@floor2GuestroomsLaptop
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerLaptop1)
  +?func(inParty, Anjana):{
    +walkToMarker(Anjana, MarkerLaptop2, 0, 0, true)
    +onChWalkCompleted(Anjana, "+:face(Anjana, leftdown)")
  }
  +?func(inParty, Skye):{
    +walkToMarker(Skye, MarkerLaptop2, 16, 0, true)
    +onChWalkCompleted(Skye, "+:face(Skye, leftdown)")
  }
  +:floor2GuestroomsLaptop_scene()
#floor2GuestroomsLaptop_walk
  action,?isnot(quest.misc.floor2Laptop):floor2GuestroomsLaptop_walk
@floor2GuestroomsLaptop_walk
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerLaptop2)
  +walkToMarker(Ada, MarkerLaptop1)
  +?func(inParty, Anjana):{
    +walkToMarker(Anjana, MarkerLaptop2)
    +:ld(Anjana, leftdown)
  }
  +:floor2GuestroomsLaptop_scene()
@floor2GuestroomsLaptop_scene
  +:ld(Ada, rightdown)
  +:laptopSound()
  LAPTOP: "YOU HAVE <color=LIGHTRED>1</> NEW NOTIFICATION(S)."
  Ada: "Somebody has left their laptop on this table."
  +?all(func(inParty, Anjana),once('f328b639')):{
    +:shakeZ(Anjana)
    Anjana: "Can you stop that thing from beeping so much?  It's getting on my nerves."
  }
  +?once('c20bddf8'):{
    Ada: "Maybe I can turn the volume down or something."
  }
  +panCameraRelativeToPlayer(0, 0, 1)
  Ada: "Let me see..."
  +none()
  +playSound("terminal_beep")
  +:bumpX(Ada, 2)
  +playSound("terminal_beep")
  +:bumpX(Ada, 2)
  +:w(500)
  +:laptopSound()
  LAPTOP: "<cascade-letters=0.25>USER REQUEST DENIED.\n</> <cascade-letters=0.25>UNREAD MESSAGES MUST BE MARKED AS READ."
  +:teardrop(Ada)
  Ada: "Okay then..."
  +playSound("terminal_beep")
  +:bumpX(Ada, 2)
  +:w(500)
  +:laptopSound()
  LAPTOP: "<cascade-letters=0.25>MESSAGE WILL NOW BE PLAYED."
  +playSound(static)
  LAPTOP: "<cascade-letters=0.25>......"
  +:laptopSound2()
  Voice From Laptop: "<color=LIGHTGREY />Hello."
  Voice From Laptop: "<color=LIGHTGREY />If you are hearing this message then you have entered a room with an inconspicuous laptop, and nobody else is around."
  Voice From Laptop: "<color=LIGHTGREY />Do not be alarmed, this is by design."
  Voice From Laptop: "<color=LIGHTGREY />My name is <color=ORANGE>Dr. Allison<color=LIGHTGREY />.  I am from the future."
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    +:shakeZ(Anjana)
    Anjana: "What is thiiis?  Do they think we're stupid or something?"
    +:ld(Anjana, leftdown)
    +:ld(Ada, rightdown)
  }
  +:laptopSound2()
  Voice From Laptop: "<color=LIGHTGREY />I am supposed to be giving a symposium on time travel in this very room all week, but something has gone terribly awry."
  Voice From Laptop: "<color=LIGHTGREY />During a routine demonstration, something unexpected occurred, and it caused me to become trapped in a <color=LIGHTRED>time loop</>."
  Voice From Laptop: "<color=LIGHTGREY />The only thing I have been able to manipulate from this loop is the laptop you are listening to right now."
  Voice From Laptop: "<color=LIGHTGREY />Please, whomever you are that is seeing this, I implore you to assist me.  You are likely my only hope of escape."
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    +:question(Anjana)
    Anjana: "This has to be some kind of joke."
    +:ld(Anjana, leftdown)
    +:ld(Ada, rightdown)
  }
  Voice From Laptop: "<color=LIGHTGREY />I don't have much space left in this recording.  If you believe me, then please perform this action:"
  Voice From Laptop: "<color=LIGHTGREY />In the <color=LIGHTPURPLE>Caf8teria<color=LIGHTGREY /> there is a <italic>certain suspicious individual<color=LIGHTGREY /> whom you must find."
  Voice From Laptop: "<color=LIGHTGREY />You will know who it is when you encounter them."
  Voice From Laptop: "<color=LIGHTGREY />You must </>offer to buy them a slice of pizza<color=LIGHTGREY />.  Do so, then return to this laptop for further instruction."
  Voice From Laptop: "<color=LIGHTGREY />You are the only one whom this message will reach."
  Voice From Laptop: "<color=LIGHTGREY />Not only my fate lies in the balance here, but potentially the fate of the whole second floor."
  Voice From Laptop: "<color=LIGHTGREY />Please heed my words.  Godspeed, traveler."
  +none()
  +playSound(static)
  Voice From Laptop: "<cascade-letters=0.25>......"
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    +:bored(Anjana)
    Anjana: "The things these kids come up with..."
    Anjana: "We should just leave this alone.  It's clear that somebody just wants a free lunch."
    +:flat(Ada)
    Ada: "That would be quite an elaborate ruse."
    +:ld(Ada, down)
    +:shakeZ(Anjana)
    Anjana: "Bah, do whatever you want.  That pizza will be on your tab, though."
  }
  +?func(inParty, Skye):{
    Skye: "Why pizza?  The pizza here isn't even any good."
  }
  +panCameraBackToPlayer()
  +startQuest(AFunExpectedJourney)

  +endConversation()
