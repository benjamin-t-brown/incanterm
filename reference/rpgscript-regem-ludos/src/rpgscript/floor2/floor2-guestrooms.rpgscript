@floor2_preThroneRoomGuestroomPortal
  +?once(floor2_has_tp_to_ca_realm):{
    +endConversation(1)
    +setConversation(Ada)
    +spawnCharacterAtMarker(Lotte, MarkerFromHallway, -32, -32)
    +setStorage(floor2_guestroom_portal_prevent_leave, true)
    +walkToMarker(Ada, MarkerFromHallway, -16, -16, 0, 0, true)
    +walkToMarker(Lotte, MarkerTerminal)
    +walkPartyToFormation()
    +fadeIn(500)
    +:leach(Ada, Lotte)
    +panCameraToFitCharacters(1000, false, Ada, Lotte)
    +:ld(Lotte, leftup)
    +:smallPause()
    +:ld(Lotte, rightdown)
    +:smallPause()
    +:ld(Lotte, down)
    // +stopSkipCutscene()
    +:exhale(Lotte)
    Lotte: "He always leaves it in such a disgraceful state..."
    +none()
    +:smallPause()
    +:ld(Lotte, rightup)
    +playSound(terminal_beep)
    +:bumpY(Lotte, -2)
    +:smallPause()
    +:ld(Lotte, leftdown)
    +:ld(Ada, leftup)
    +panCameraRelativeToPlayer(-32, -32)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', -16, -16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, -16, -16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', -16, 0)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, -16, 0)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', -16, 16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, -16, 16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 0, -16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 0, -16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 0, 0)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 0, 0)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 0, 16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 0, 16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 16, -16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 16, -16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 16, 0)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 16, 0)
    +waitMS(75)
    +playSound('spawn_enemy')
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerPortal, 'normal', 16, 16)
    +changeTileAtMarker(MarkerPortal, VR_PORTAL_FLOOR, 16, 16)
    +waitMS(75)
    +playSound('spawn_enemy')
    +:smallPause()
    +:smallPause()
    +:question(Ada)
    Ada: "A <color=LIGHTBLUE>Portal</>?  In here?"
    +:shakeZ(Lotte)
    Lotte: "Okay, in you go."
    +:shakeZ(Lotte)
    Lotte: "And be quick about it."
    +panCameraBackToPlayer()
    +endConversation()
  }

#floor2_preThroneRoomGuestroomPortal_standOnPortal
  step-first,?once('59afe425'):this
@this
  +setConversation(Ada)
  +setStorage(floor2_guestroom_portal_prevent_leave, false)
  +walkToMarker(Ada, MarkerPortal)
  +:ld(Ada, down)
  +walkToMarker(Conscience, MarkerPortal, 16, 0)
  +:face(Conscience, down)
  +panCameraRelativeToPlayer(16, -16)
  +:shakeZ(Lotte)
  Lotte: "Wonderful, we can proceed."
  +stopMusic()
  +none()
  +:ld(Lotte, rightup)
  +playSound(terminal_beep)
  +:bumpY(Lotte, -2)
  +:smallPause()
  +panCameraBackToPlayer(1000, true)
  +walkToMarker(Lotte, MarkerPortal, 16, -16)
  +:ld(Lotte, down)

  // had to copy pasta fade out/in so Lotte would come with them
  +setConversation(Ada)
  +none()
  +stopMusic(500)
  // +walkToMarker('Ada', MarkerVRLanding)
  // +setFacing('Ada', 'down')
  // +walkPartyToFormation()
  +playSound('vr_portal_buzz')
  +:w(500)
  +setPlayerVisibility(false)
  +playSound('spawn_enemy')
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Lotte, 'normal')
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  +despawnCharacter(Party)
  +despawnCharacter(Lotte)
  +:w(1000)
  +fadeOut(500)

  +playSound('vr_portal_landed')
  +changeRoom(floor2PreThroneRoomPortal, MarkerPortal)
  +spawnPartyMembersInFormation()
  +:face(Party, down)
  +spawnCharacterAtMarker(Lotte, MarkerPortal, 16, -16)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Lotte, 'normal')
  +:ld(Lotte, down)
  +setPlayerVisibility(true)
  +fadeIn(500)
  +:w(200)
  // +playSound('spawn_enemy')
  +waitMS(1000)
  +setAnimationState('Ada', 'idle')
  +enableAnimationSounds()
  +walkToMarker(Lotte, MarkerLotte)
  +:ld(Lotte, down)
  +:floor2_preThroneRoom_lotte2()

@floor2_postThroneRoom
  +fadeOut(1)
  +panCameraBackToPlayer(1)
// +:utils-transition-to-vr-fade-in(floor2GuestroomPortal, MarkerPortal, false);

  +setConversation(Ada)
  +playSound('vr_portal_landed')
  +changeRoom(floor2GuestroomPortal, MarkerPortal)
  +setAnimationState('Ada', 'idle')
  +:face(Ada, down)
  +setAnimation(Ada, ada_headache)
  +stopMusic(1)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_PORTAL_SPAWN, 'Ada', 'normal')

  +fadeIn()
// +playMusic(music_fallout2);
//wait for the spawn particles to finish
  +waitMS(1000)
  +setAnimation(ada, ada_headache)
  Ada: "<cascade-letters>My head..."
  +:smallPause()
  +setAnimationState(Ada, idle)
  +:ld(Ada, leftdown)
  +:shakeZ(Ada)
  Ada: "<cascade-letters>Conscience..."
  +:smallPause()
  +:ld(Ada, up)
  Ada: "<cascade-letters>Conscience...!"
  +none()
  +:ld(Ada, rightup)
  +:w(100)
  +:ld(Ada, rightdown)
  +:w(100)
  +:ld(Ada, leftdown)
  +:w(100)
  +:ld(Ada, down)
  +:w(500)
  +:sad(Ada)
  Ada: "I cannot believe he would stoop so low."
  +startQuest(MainQuest)
  Ada: "<color=LIGHTGREY italic cascade-letters>I need to get her back."
  +none()
  +endConversation()

#floor2_postThroneRoomEmployee
  step-first,?all(func(questIsStarted, MainQuest), once('2ba99051')):floor2_postThroneRoomEmployee2
  action,floor2_postThroneRoomEmployee1
@floor2_postThroneRoomEmployee1
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerAdaEmployee)
  +:leach(Employee, Ada)
  +:question(Employee)
  Employee: "Can I help you?"
  +:teardrop(Ada)
  Ada: "No... clearly you cannot."
  +endConversation()
@floor2_postThroneRoomEmployee2
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerAdaEmployee)
  +:leach(Employee, Ada)
  +:question(Employee)
  Employee: "Can I help you?"
  Ada: "Yes!"
  +:ld(Ada, rightup)
  Ada: "How do I get back into that <color=LIGHTBLUE>Instance</>?"
  +:ld(Employee, rightup)
  Employee: "In that room?"
  Employee: "That's the room <color=ORANGE>Miss Lotte</> reserved."
  +:ld(Employee, rightdown)
  Employee: "I believe she requested that a one-time portal be made to <color=LIGHTRED>Carl-Arnold's Penthouse Shard</>."
  +:la(Ada, Employee)
  Ada: "Yes, yes, whatever.  How do I get back in there?"
  +:teardrop(Employee)
  Employee: "Um.  Since it's the <color=LIGHTRED>Penthouse Shard</> you'd have to go to the <color=LIGHTPURPLE>Housing Hub</> on the next floor..."
  +:exclaim(Ada)
  Ada: "What?  But I was just in there a second ago!"
  Employee: "<color=ORANGE>Miss Lotte</> only reserved a one-way trip, so you'd have to ask her to get you back up there."
  +:ld(Ada, down)
  Ada: "<scale=0.75 />Somehow I do not see that happening."
  +:la(Ada, Employee)
  Ada: "How do I get to the <color=LIGHTPURPLE>Housing Hub</>?"
  Employee: "Well, unless you've been up there before, you'll have to go through the <color=LIGHTBLUE>3rd Floor Instance</> to get to the next floor</>."
  +:doubt(Ada)
  Ada: "You cannot be serious."
  Employee: "Rules are rules, miss.  The only one who could maybe change that is <color=LIGHTRED>Carl-Arnold</> himself!"
  +:ld(Ada, down)
  Ada: "<scale=0.75 />So that was his plan all along."
  +:la(Ada, Employee)
  Ada: "Thank you for the information."
  +:ld(Ada, down)
  +:jump(Employee)
  Employee: "Um.  Good luck!  The <color=LIGHTBLUE>3rd Floor Instance</> is at the other end of this floor.  It's notoriously difficult!"
  +walkToOffset(Ada, 42, 42)
  +:ld(Ada, rightdown)
  Ada: "<italic />How encouraging..."
  +stopSkipCutscene()
  +setSpeed(Ada, 0.25)
  +walkToOffset(Ada, 24, 0, true)
  +:floor2-transitionFromHallwayToFloor2_openDoors()
  +fadeOut(2000)
  +changeRoom(floor2South, MarkerFromHallway)
  +fadeIn(1500, true)
  +setSpeed(Ada)
  +:floor2_AnjanaJoinsAda()
// +endConversation(100);
// +endConversation();

#floor2-transitionFromGuestRoomToHallway_preventLeave
