  step,?once('6dff0b7c'):floor2GuestroomsLaptop_enterRoom_step
@floor2GuestroomsLaptop_enterRoom_step
  +stopMusic()
  +setConversation(Ada)
  +panCameraRelativeToPlayer(-10, -50, 2000)
  +:laptopSound()
  LAPTOP: "YOU HAVE <color=LIGHTRED>1</> NEW NOTIFICATION(S)."
  +:laptopSound()
  LAPTOP: "<cascade-letters=0.25>PLEASE REVIEW IMMEDIATELY."
  +panCameraBackToPlayer(500)
