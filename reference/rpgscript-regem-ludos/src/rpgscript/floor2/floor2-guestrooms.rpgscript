  action,floor2-guestroomPortalExamineTerminal
@this
  +setConversation(Ada)
  +:leach(Ada, Lotte)
  +panCameraToFitCharacters(500, false, Ada, Lotte)
  +panCameraRelativeToCurrentPosition(0, -35, 400)
  +:jump(Lotte)
  Lotte: "You must stand on the portal; I have little time to waste."
  +:ld(Lotte, leftdown)
  +?is([ARG0]):{
    +walkToOffset(Ada, -16, -16)
