  +playSound(terminal_beep)
  +:bumpY(Ada, -2)
  +:smallPause()
  +:smallPause()
  +playSound(terminal_cancel)
  +:smallPause()
  +:smallPause()
  Ada: "It is no use..."
  +endConversation()

