#floor2Cafeteria_SaladStore
  action,?once('e85f2df9'):floor2Cafeteria_SaladStore1
  action,floor2Cafeteria_SaladStore2
@floor2Cafeteria_SaladStore1
  +:ld(Ada, leftup)
  +setConversation(Ada)
  SaladEmployee: "You're actually interested in this?  Alright, whatddya want?"
  +endConversation()
  +showStore(SECOND_FLOOR_CAFETERIA_SALAD_STORE)
@floor2Cafeteria_SaladStore2
