#floor2Cafeteria_employeeDoorLockedRight
  action,this
@this
  +setConversation(Ada)
  +:face(Ada, rightup)
  Ada: "The sign next to the door says 'Employees Only'."
  +endConversation()

#floor2Cafeteria_PizzaLineTalk
  action,this
@this
  +setStorageIfNotSet(vars.cafeteriaPizzaTalkCtr, 0)
  +setConversation(Ada)
  +?eq(vars.cafeteriaPizzaTalkCtr, 0):{
    Person In Line: "This line is really long."
  }
  +?eq(vars.cafeteriaPizzaTalkCtr, 1):{
    Person In Line: "I'm not even really sure if I want pizza, honestly."
  }
  +?eq(vars.cafeteriaPizzaTalkCtr, 2):{
    Person In Line: "If there are so many people in line, the food must be good, right?"
  }
  +?eq(vars.cafeteriaPizzaTalkCtr, 3):{
    Person In Line: "I wonder if they have good toppings available..."
  }
  +?eq(vars.cafeteriaPizzaTalkCtr, 4):{
    Person In Line: "I want a deep dish!  No actually a round sounds better."
  }
  +?eq(vars.cafeteriaPizzaTalkCtr, 5):{
    Person In Line: "I think they should have cantaloupe as a topping.  That's much better than pineapple."
  }
  +incrementStorage(vars.cafeteriaPizzaTalkCtr, 1)
  +?gt(vars.cafeteriaPizzaTalkCtr, 5):{
    +setStorage(vars.cafeteriaPizzaTalkCtr, 0)
  }
  +endConversation()

#floor2Cafeteria_PizzaLineTalk0
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, Person0)
  Person0: "Hey!  I'm next in line!  If you want your own pizza, go to the back and wait like the rest of us!"
  +endConversation()

#floor2Cafeteria_BurgerStore
  action,?once('cd4aece7'):floor2Cafeteria_BurgerStore1
  action,floor2Cafeteria_BurgerStore2
@floor2Cafeteria_BurgerStore1
  +:ld(Ada, leftup)
  +setConversation(Ada)
  BurgerEmployee: "Order up! How'd you like it cooked? (And don't say anything other than *well*)."
  +endConversation()
  +showStore(SECOND_FLOOR_CAFETERIA_BURGER_STORE)
@floor2Cafeteria_BurgerStore2
  +:ld(Ada, leftup)
  +showStore(SECOND_FLOOR_CAFETERIA_BURGER_STORE)

#floor2Cafeteria_RamenStore
  action,?once('a0262f52'):floor2Cafeteria_RamenStore1
  action,floor2Cafeteria_RamenStore2
@floor2Cafeteria_RamenStore1
