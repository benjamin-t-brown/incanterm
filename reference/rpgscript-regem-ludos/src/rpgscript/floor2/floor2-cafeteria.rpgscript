#floor2North_openSouthDoor
  step-first,floor2North_mainSouthDoorOpen
  step-off,floor2North_mainSouthDoorClose
@floor2North_mainSouthDoorOpen
  +playSound(sliding_door_open)
  +:openDoor(MarkerDoorSouth2, PINK_DOOR_BCKL)
  +:openDoor(MarkerDoorSouth1, PINK_DOOR_BCKR)
@floor2North_mainSouthDoorClose
  +playSound(sliding_door_close)
  +:closeDoor(MarkerDoorSouth2, PINK_DOOR_BCKL)
  +:closeDoor(MarkerDoorSouth1, PINK_DOOR_BCKR)

