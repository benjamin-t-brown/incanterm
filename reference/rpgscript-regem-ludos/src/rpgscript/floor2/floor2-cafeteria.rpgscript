#floor2Cafeteria_PizzaOnTheBar
  action,?once('5697dc42'):floor2Cafeteria_PizzaOnTheBar1
  action,floor2Cafeteria_PizzaOnTheBar2
@floor2Cafeteria_PizzaOnTheBar1
  +:ld(Ada, leftup)
  +setConversation(Ada)
  +?func(inParty, Skye):{
    +:ld(Skye, leftup)
    Skye: "Oh man, it smells <italic>really</> good over here."
  }
  +?func(inParty, Anjana):{
    +:ld(Anjana, leftup)
    +:teardrop(Anjana)
    Anjana: "I think I could dip that in a vat of lard and it would come out <italic>less</> greasy."
  }
  Ada: "These pizzas look like they have been sitting out here for some time."
  +endConversation()
@floor2Cafeteria_PizzaOnTheBar2
  +:ld(Ada, leftup)
  +setConversation(Ada)
  Ada: "I do not believe I should take any of these..."
  +endConversation()

#floor2CafeteriaCashierEmployeeTalk
  action,this
@this
  +setConversation(Ada)
  +:ld(Ada, leftup)
  +:ld(Floor2CafeteriaCashierEmployee, rightdown)
  Floor2CafeteriaCashierEmployee: "Welcome to the <color=LIGHTGREEN>Caf8teria</>! Feel free to peruse our selection of fine foods!"
  +endConversation()

#floor2CafeteriaFoodPersonsTalk
  action,this
@this
  // +walkToCharacter(Party, Floor2CafeteriaFoodPerson1, -16, 16)
  // +:la(Ada, Floor2CafeteriaFoodPerson1)
  // +walkPartyToFormation()
  +setConversation(Ada)
  +:sad(Floor2CafeteriaFoodPerson1)
  Floor2CafeteriaFoodPerson1: "I'm not sure what I want to eat..."
  Floor2CafeteriaFoodPerson2: "Maybe just get a salad?"
  Floor2CafeteriaFoodPerson1: "Nah, a salad seems a bit too light right now."
  Floor2CafeteriaFoodPerson2: "Well, everything looks like it will be good.  Might as well just pick something so we're not hungry anymore."
  +:shakeZ(Floor2CafeteriaFoodPerson1)
  +:ld(Floor2CafeteriaFoodPerson1, leftdown)
  Floor2CafeteriaFoodPerson1: "Yeah but I still just don't know what I want..."
  +:leach(Floor2CafeteriaFoodPerson1, Floor2CafeteriaFoodPerson2)
  +endConversation()

#floor2Cafeteria_SimplePatron
  action,this
@this
  +setConversation(Ada)
  +:la(Guy, Ada)
  Guy: "There used to be a pink sign with the number '9' on this table, but it was taking up too much space, so I removed it."
  +endConversation()

#floor2CafeteriaEast1_WindowPanePerson
  action,this
@this
  +setConversation(Ada)
  floor2CafeteriaEast1_WindowPanePerson: "I'm trying to figure out the best way to put this pane of glass back on the wall."
  floor2CafeteriaEast1_WindowPanePerson: "In this corner it's got a bit of a glare towards a few seats, but the other one just looks so dull."
  floor2CafeteriaEast1_WindowPanePerson: "I'll just leave it here for now."
  floor2CafeteriaEast1_WindowPanePerson: "Then again... maybe there is a better spot for it."
  +endConversation()

#floor2Cafeteria_tavernityMachine
  action,this
@this
  +setUnskippableConversation(Ada)
  +walkToMarker(Ada, MarkerTavernityMachine)
  +setFacing(Ada, rightup)
  +runArcadeCabinetGame(TAVERNITY)
  +setAtMarker(Ada, MarkerTavernityMachine)
  +endConversation()