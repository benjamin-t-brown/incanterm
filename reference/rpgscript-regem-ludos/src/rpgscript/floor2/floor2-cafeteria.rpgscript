@floor2cafeteria
  +:patternMatchmaking_setupMatchmaking()

@floor2cafeteriafood
  +:patternMatchmaking_placeMillieCafeteriaFood()

// TRANSITIONS

@floor2Cafeteria_transitionEffect
  +setConversationWithoutBars(Ada)
  +setAnimationState('Ada', 'idle')
  +fadeOut(500, true)
  +panCameraBackToPlayer(1)
  +waitMS(500, '', true)
  +fadeIn(500, true)
  +playSound('change_room')
  +playSound('move_wall')
  +changeRoom(black)
  +spawnParticleAtCharacter('EFFECT_TEMPLATE_VR_WHITE_PORTAL', 'Ada', 'normal')
  +:w(100)
  +playSound('purple_portal')
  +:w(900)

#floor2Cafeteria_transitionFromSouthToCafeteria
  step,this
@this
  // +:floor2Cafeteria_transitionEffect()
  +:utils-change-room(floor2CafeteriaHallway, MarkerDoorSouth)

