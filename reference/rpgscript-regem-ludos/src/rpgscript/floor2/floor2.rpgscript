#floor2-transitionFromRpsToFloor2
  step,this
@this
  +:utils-change-room(floor2South, MarkerFromRps)

#floor2-transitionFromFloor2ToRps
  step,this
@this
  +?isnot(func(questActive, RPS)):{
    +:utils-change-room(floor2Rps, MarkerFromFloor2South)
  }
  +?func(questActive, RPS):{
    +setConversation(Ada)
    +setPlayerVisibility(false)
    +despawnCharacter(Conscience)
    +stopMusic(500)
    +spawnCharacterAtMarker(Anjana, MarkerAnjanaSpawn)
    +:ld(Anjana, leftdown)
    +setSpeed(Anjana, 0.75)
    +walkToMarker(Anjana, MarkerAnjanaWalk1, 0, 0, true)
    +:w(1000)
    +playMusic(music_anjana)
    +panCameraToFitCharacters(2000, false, Anjana, Floor2Dummy)
    +:floor2-OpenRedDoorsToElevatorBCKOpen()
    +walkToMarker(Anjana, MarkerAnjanaWalk2)
    +:floor2-OpenRedDoorsToElevatorBCKClose()
    +panCameraToFitCharacters(500, false, Anjana)
    +:w(500)
    +:question(Anjana)
    +:ld(Anjana, up)
    +:w(500)
    +:ld(Anjana, right)
    +:w(500)
    +:ld(Anjana, down, 100)
    +:w(100)
    +:ld(Anjana, left)
    +:teardrop(Anjana)
    Anjana: "That's weird..."
    +none()
    +walkToOffset(Anjana, 8, 0)
    +:w(100)
    +walkToOffset(Anjana, 0, 8)
    Anjana: "Where's the usual crowd?"
    +:exclaim(Anjana)
    +walkToOffset(Anjana, 8, 0)
    +:ld(Anjana, rightdown)
    +:jump(Anjana)
    Anjana: "Don't tell me they've found another victim..."
    +none()
    +walkToOffset(Anjana, 0, -8)
    Anjana: "Why are there so many idiots who get caught in their stupid trap?"
    +none()
    +walkToOffset(Anjana, -8, -8)
    Anjana: "Ugh."
    +none()
    +:sigh(Anjana)
    +:w(100)
    +walkToMarker(Anjana, MarkerAnjanaWalk2)
    +:floor2-OpenRedDoorsToElevatorBCKOpen()
    +walkToMarker(Anjana, MarkerAnjanaWalk1, 0, 0, true)
    +fadeOut(1000)
    +setPlayerVisibility(true)
    +panCameraBackToPlayer(1)
    +stopMusic(500, false)
    +:utils-change-room(floor2Rps, MarkerFromFloor2South, true)
  }

#floor2-OpenRedDoorsToElevatorBCK
  step-first,?isnot(with('HapticBracer')):floor2-OpenRedDoorsNoBracer
  step-first,floor2-OpenRedDoorsToElevatorBCKOpen
  step-off,floor2-OpenRedDoorsToElevatorBCKClose
@floor2-OpenRedDoorsToElevatorBCKOpen
  +playSound(sliding_door_open)
  +:openDoor(MarkerRedDoorBCK2, RED_DOOR_BCKL)
  +:openDoor(MarkerRedDoorBCK1, RED_DOOR_BCKR)
@floor2-OpenRedDoorsToElevatorBCKClose
  +playSound(sliding_door_close)
  +:closeDoor(MarkerRedDoorBCK2, RED_DOOR_BCKL)
  +:closeDoor(MarkerRedDoorBCK1, RED_DOOR_BCKR)
@floor2-OpenRedDoorsNoBracer
  +setConversation(Ada)
  +playSound(deep_siren)
  +changePropAnim(PropDoorLight1, props_small_light_alert)
  +changePropAnim(PropDoorLight2, props_small_light_alert)
  +changePropAnim(PropDoorLight3, props_small_light_alert)
  +changePropAnim(PropDoorLight4, props_small_light_alert)
  +:exclaim(Ada)
  +:jump(Ada)
  +waitMS(33)
  +walkToOffset(Ada, 0, 24)
  +setFacing(Ada, rightup)
  +changePropAnim(PropDoorLight1, props_small_light_off)
  +changePropAnim(PropDoorLight2, props_small_light_off)
  +changePropAnim(PropDoorLight3, props_small_light_off)
  +changePropAnim(PropDoorLight4, props_small_light_off)
  +waitMS(100)
  Ada: "It seems I need a <color=LIGHTBLUE>Haptic Bracer</> to proceed through these doors."
  +endConversation()

@floor2_AnjanaJoinsAda
  +spawnCharacterAtMarker(Anjana, MarkerAnjanaSpawn2)
  +stopMusic(500, false)
  +playMusic(music_anjana)
  +setConversation(Ada)
  +:la(Anjana, Ada)
  +panCameraToFitCharacters(2000, false, Anjana)
  +:la(Anjana, Ada)
  +:smallPause()
  +:jump(Anjana)
  +:exclaim(Anjana)
  +walkToCharacter(Anjana, Ada, 16, -16)
  +:leach(Anjana, Ada)
  +panCameraToFitCharacters(500, false, Ada, Anjana)
  +setConversation2(Ada, Anjana)
  Anjana: "Hey."
  Anjana: "Sorry for prying, but..."
  +:ld(Anjana, leftup)
  Anjana: "I saw you walk in there with that <color=LIGHTBLUE>Lotte</> girl."
  +:la(Anjana, Ada)
  Anjana: "Where did she take you?"
  +:ld(Ada, leftup)
  +:shakeZ(Ada)
  Ada: "<cascade-letters>...</>She took me to... Some kind of space station, I guess... From one of the guestrooms back there."
  +:la(Ada, Anjana)
  Anjana: "I see."
  +:la(Anjana, Ada)
  Anjana: "I don't trust her."
  Anjana: "I've seen her and that conniving rat <color=LIGHTRED>Bartolo</> together.  Nothing good can come of a union like that."
  Ada: "Do you... know them?"
  Anjana: "They are classmates.  My year.  I'd rather not associate with them.  It's a long story."
  Anjana: "What did they want with you?"
  Ada: "They did not seem particularly interested in me actually. It was <color=LIGHTRED>Carl-Arnold</> that wanted to speak with me."
  +:surprised(Anjana)
  Anjana: "<color=LIGHTRED>Carl-Arnold</>?  He's with them too?  That's <italic>definitely</> not good."
  Anjana: "That guy is the king here.  If you get too involved with him you're not going to have a good time."
  +:angry(Ada)
  Ada: "A good time?  I do not want a good time.  I want to get <color=YELLOW>Conscience</> back."
  +:ld(Ada, rightdown)
  Ada: "He trapped her in that space station somehow..."
  +:la(Ada, Anjana)
  +:question(Anjana)
  Anjana: "Conscience?"
  Anjana: "Oh, is that your... <color=LIGHTGREEN cascade-letters>Alternate</>?"
  +:ld(Anjana, rightdown)
  Anjana: "<scale=0.75 />Wow I didn't realize that thing was so ephemeral."
  +:la(Anjana, Ada)
  Anjana: "But how?  Shouldn't that be impossible?\n<scale=0.75>or something?  I honestly don't know how it works."
  +:ld(Ada, down)
  Ada: "He had some kind of gem thing.  It gave me a splitting headache and..."
  +:serious(Ada)
  +:la(Ada, Anjana)
  Ada: "Look it does not matter.  I <italic>need</> to get <color=YELLOW>Conscience</> back."
  Ada: "Do you know how to get to the <color=LIGHTPURPLE>Housing Hub</>?"
  Anjana: "Yeah sure.  It's on the 3rd floor..."
  Ada: "Can you point me in the right direction?"
  +:teardrop(Anjana)
  Anjana: "Um... forgive me for being forward, but it sounds like you don't really have a plan."
  Anjana: "I don't think you realize the kind of sway <color=LIGHTRED>Carl-Arnold</> has in this place."
  Anjana: "If he took something from you here, then it's as good as gone."
  +:angry(Ada)
  Ada: "I am not going to stand here and do nothing."
  Anjana: "Look.  I know your capable of handling yourself.  I've seen you do it."
  Anjana: "But you're going to need some help if you want to take on <color=LIGHTRED>Carl-Arnold</>."
  +:ld(Anjana, leftdown)
  Anjana: "I suppose I could go with you for now.  It's not like I'm really doing anything else."
  +:question(Ada)
  Ada: "You want to help me?"
  Anjana: "Yes.  I think I do..."
  Anjana: "Let me make it official."
  +:smallPause()
  +walkToCharacter(Anjana, Ada, 4, -4)
  +playSound(terminal_beep)
  +:bumpZ(Anjana, 2)
  +:smallPause()
  +:addPartyMember(Anjana)
  +acquireItem(TrWand, 0, true)
  +equipWeaponOrArmor(TrWand, Anjana)
  +walkToCharacter(Anjana, Ada, 16, -16)
  +:la(Anjana, Ada)
  Anjana: "There.  I may not have as much sway as <color=LIGHTRED>Carl-Arnold</>, but I'm decent at the battle system here."
  Anjana: "I just... prefer to stand in the back."
  +:surprised(Ada)
  Ada: "I..."
  +:ld(Ada, down)
  +:blush(Ada)
  Ada: "Thanks."
  +stopSkipCutscene()
  +:ld(Anjana, rightdown)
  Anjana: "We need to get to the 3rd floor.  It's past the <color=LIGHTPURPLE>Caf8teria</>, so let's head that way."
  +:none()
  +completeQuestStep(MainQuest, 0)
// +despawnPartyMembers();
  +panCameraBackToPlayer()
  +stopMusic()
  +playMusic(music_floor2)
  +endConversation()

#floor2_NPC1
  action,this
@this
  +setConversation(Ada)
  +:la(floor2_NPC1, Ada)
  floor2_NPC1: "In one of the conference rooms there's gonna be a symposium on time travel this week."
  floor2_NPC1: "It's supposed to start in a few hours, but I wanted to get here early."
  floor2_NPC1: "You know, <italic>just in case</> there's some kind of shenanigans going on."
  +?func(inParty, Anjana):{
    +:question(Anjana)
    Anjana: "Like what?"
    floor2_NPC1: "Oh you know.  Time travel stuff."
    +:lightbulb(floor2_NPC1)
    floor2_NPC1: "Maybe a time machine appears inside the building!  It makes a loud *CRASH*!"
    floor2_NPC1: "And, like, somebody get stabbed or something, and it starts this whole crazy timeline!"
    +:flat(Anjana)
    Anjana: "You've got quite a far-fetched imagination."
  }
  +endConversation()

