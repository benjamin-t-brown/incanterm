#floor2SouthEast_instanceStep
  step,?once('c58152ab'):this
@this
  +setConversation(Ada)
  +panCameraToFitCharacters(1000, false, Ada, floor2SouthEast_instanceEmployee)
  +:leach(Ada, floor2SouthEast_instanceEmployee)
  +:jump(floor2SouthEast_instanceEmployee)
  floor2SouthEast_instanceEmployee: "I sense a new player!! Come on over here, miss!"
  +walkToCharacter(Ada, floor2SouthEast_instanceEmployee, 0, 24)
  +:la(Ada, floor2SouthEast_instanceEmployee)
  +walkPartyToFormation()
  +panCameraBackToPlayer()
  +:leach(Ada, floor2SouthEast_instanceEmployee)
  +:shakeZ(floor2SouthEast_instanceEmployee)
  floor2SouthEast_instanceEmployee: "Behind me is a room with a <color=LIGHTBLUE>Portal</> to an <color=LIGHTBLUE>Instance</>."
  floor2SouthEast_instanceEmployee: "It's called the <color=LIGHTPURPLE>Forest Swamp Challenge</>!"
  floor2SouthEast_instanceEmployee: "You'll find a few of these challenges around the arcade."
  floor2SouthEast_instanceEmployee: "This one asks you to defeat the two bosses, one to the north and one to the south, and you'll receive today's <color=LIGHTBLUE>special prize</>."
  +:question(Ada)
  Ada: "What's the prize?"
  +:wink(floor2SouthEast_instanceEmployee)
  floor2SouthEast_instanceEmployee: "I don't know!  I'm just the <color=LIGHTBLUE shake>Instance Employee</>."
  floor2SouthEast_instanceEmployee: "Somebody inside will give it to you when you complete the challenge."
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    +endConversation(100)
    +setConversation2(Anjana, Ada)
    Ada: "What do you think?  Is it worth it?"
    +:shrug(Anjana)
    Anjana: "I've never really been interested in the <color=LIGHTBLUE>Challenge Instances</> here, so I haven't done any."
    Anjana: "It might make us more powerful, though."
    Anjana: "Some training might be helpful if you hope to defeat <color=LIGHTRED>Carl-Arnold</>."
    Ada: "Perhaps it is worth a try..."
    +:la(Ada, floor2SouthEast_instanceEmployee)
    +:la(Anjana, floor2SouthEast_instanceEmployee)
  }
  +startQuest(FLOOR2_INSTANCE1)
  +?func(inParty, Skye):{
    +:shakeZ(Skye)
    +:la(Skye, Ada)
    +setConversation(Skye)
    Skye: "Me and my hammer are ready whenever!"
  }
  +?func(numPartyMembersEQ, 2):{
    +:teardrop(floor2SouthEast_instanceEmployee)
    floor2SouthEast_instanceEmployee: "I can't help but notice that there are only two of you."
    floor2SouthEast_instanceEmployee: "This instance may be a bit hard if it's just you two.  It was designed for three or more."
    floor2SouthEast_instanceEmployee: "You can still try if you want to though, you just might have a tough time."
  }
  +endConversation()

