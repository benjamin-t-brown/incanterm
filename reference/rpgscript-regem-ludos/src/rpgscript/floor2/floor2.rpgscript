#floor2BallroomAPiano
  action,?once('8d33418a'):this
  action,floor2BallroomAPiano
@this
  +setConversation(Ada)
  Ada: "Oh, they have a piano here."
  +?func(inParty, Anjana):{
    +:leach(Ada, Anjana)
    +endConversation(1)
    +setConversation2(Ada, Anjana)
    Anjana: "Do you play?"
    Ada: "No, but I know somebody who does."
    Anjana: "Are they any good?"
    Ada: "I would certainly say so."
    Ada: "Although she would probably tell you <cascade-letters color=LIGHTGREY>otherwise</>."
    +?func(inParty, Skye):{
      +:la(Skye, Ada)
      +none()
      +:w(100)
      +:happy(Skye)
    // +endConversation(1);
      +setConversation(Skye)
      Skye: "You mean <color=LIGHTBLUE>Iroha</>, right?  Ya she'd probably bail at the site of this thing."
      +:la(Skye, Anjana)
      +none()
      +:w(100)
      +setConversation2(Ada, Anjana)
    }
    Anjana: "I took lessons through middle school but I could probably still have gotten a degree if I kept going."
    Anjana: "Just lost interest.  The piano is kind of a simple."
    +:ld(Ada, left)
    Ada: "Right.  <italic>Simple</>."
  }
  +?isnot(func(inParty, Anjana)):{
    Ada: "I would not have expected something like this at an arcade."
  }
  +endConversation()
@floor2BallroomAPiano2
  +setConversation(Ada)
  Ada: "Oh, they have a piano here."
  Ada: "I would not have expected something like this at an arcade."
  +endConversation()

