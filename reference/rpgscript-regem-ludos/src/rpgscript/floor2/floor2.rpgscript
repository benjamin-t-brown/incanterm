  action,?once('34f6b1b8'):this
  action,floor2BallroomASign2
@this
  +setConversation(Ada)
  +:ld(Ada, up)
  +walkPartyToFormation()
  Ada: "The sign says '<color=LIGHTGREY />Ballroom A is reserved this evening for a private event.</>'"
  Ada: "It looks like some kind of competitive karaoke?"
  +?func(inParty, Anjana):{
    +:leach(Ada, Anjana)
    +endConversation(1)
    +setConversation2(Ada, Anjana)
    Anjana: "Not that I think we should be distracted or anything but..."
    Anjana: "If we entered as contestants we'd probably win."
    +:question(Ada)
    Ada: "You can sing?"
    Anjana: "Of course.  It's not that hard, honestly."
    +:blush(Ada)
    Ada: "Yes well... <scale=0.75 />Good for you I suppose."
    Ada: "My family has never been very keen on the musical arts."
  }
  +?func(inParty, Skye):{
    +:leach(Ada, Skye)
    +setConversation(Skye)
    Skye: "You can count me out of that; I'm a terrible singer."
    Skye: "...unless you wanna hear some screechy punk rock.  I can do that no problem."
    Skye: "That used to be popular, you know."
  }
  +endConversation()
