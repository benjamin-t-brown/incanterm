  }
  +endConversation()

// [ARG0] First Marker To Walk To
// [ARG1] Second Marker To Walk To
// [ARG2] Door Marker
@floor2North_bathroom
  +setUnskippableConversation(Ada)
  +setWallCollisionEnabled(false)
  +walkToMarker(Party, {ARG0})
  +lookAtMarker(Ada, {ARG2})
  +walkPartyToFormation(false, 4)
  +:w(200)
  +playSound(sliding_door_open)
  +:openDoor({ARG2}, WOOD_DOOR_FWD)
  +walkToMarker(Party, {ARG1})
  +lookAtMarker(Ada, {ARG2})
  +walkPartyToFormation(false, 4)
  +playSound(sliding_door_close)
  +:closeDoor({ARG2}, WOOD_DOOR_FWD)
  +setWallCollisionEnabled(true)
  +endConversation()

