#floor2-transitionFromFloor2SouthWestToFloor2South
  step,this
@this
  +:utils-change-room(floor2South, MarkerFromFloor2SouthWest)
#floor2-transitionFromFloor2SouthWestToFloor2South_doors
  step-first,floor2-transitionFromFloor2SouthWestToFloor2South_openDoors
  step-off,floor2-transitionFromFloor2SouthWestToFloor2South_closeDoors
@floor2-transitionFromFloor2SouthWestToFloor2South_openDoors
  +playSound(sliding_door_open)
  +:openDoor(MarkerDoorFloor2South1, RED_DOOR_FWDL)
  +:openDoor(MarkerDoorFloor2South2, RED_DOOR_FWDR)
@floor2-transitionFromFloor2SouthWestToFloor2South_closeDoors
  +playSound(sliding_door_close)
  +:closeDoor(MarkerDoorFloor2South1, RED_DOOR_FWDL)
  +:closeDoor(MarkerDoorFloor2South2, RED_DOOR_FWDR)

#floor2-transitionFromFloor2SouthToFloor2SouthWest
  step,this
@this
  +:utils-change-room(floor2SouthWest, MarkerFromFloor2South)
#floor2-transitionFromFloor2SouthToFloor2SouthWest_doors
  step-first,transitionFromFloor2SouthToFloor2SouthWest_doors_openDoors
  step-off,transitionFromFloor2SouthToFloor2SouthWest_doors_closeDoors
@transitionFromFloor2SouthToFloor2SouthWest_doors_openDoors
  +playSound(sliding_door_open)
  +:openDoor(MarkerDoorSouthWest1, RED_DOOR_FWDL)
  +:openDoor(MarkerDoorSouthWest2, RED_DOOR_FWDR)
@transitionFromFloor2SouthToFloor2SouthWest_doors_closeDoors
  +playSound(sliding_door_close)
  +:closeDoor(MarkerDoorSouthWest1, RED_DOOR_FWDL)
  +:closeDoor(MarkerDoorSouthWest2, RED_DOOR_FWDR)

#floor2_elevator_call
  step,elevator_call_step
  action,?isnot(with('HapticBracer')):floor2-south-call-elevator-no-bracer
  action,this
@this
  +:elevator_call_action()
@floor2-south-call-elevator-no-bracer
  +setConversation(Ada)
  +panCameraRelativeToPlayer(0, 0, 1)
  +setFacing(Ada, rightup)
  +waitMS(100)
  +playSound(terminal_beep)
  +:bumpY(Ada, -1)
  +waitMS(100)
  +playSound(terminal_cancel)
  +waitMS(100)
  +:question(Ada)
  +waitMS(100)
  +playSound(terminal_beep)
  +:bumpY(Ada, -1)
  +waitMS(100)
  +playSound(terminal_cancel)
  +waitMS(100)
  +playSound(terminal_beep)
  +:bumpY(Ada, -1)
  +waitMS(100)
  +:angry(Ada)
  Ada: "I think I need a <color=LIGHTBLUE>Haptic Bracer</> to use this elevator!"
  +panCameraBackToPlayer(1)
  +endConversation()

#floor2-transitionFromFloor2ToGuestRoomHallway_doors
  step-first,floor2-transitionFromFloor2ToGuestRoomHallway_doors_openDoors
  step-off,floor2-transitionFromFloor2ToGuestRoomHallway_doors_closeDoors
@floor2-transitionFromFloor2ToGuestRoomHallway_doors_openDoors
  +playSound(sliding_door_open)
  +:openDoor(MarkerDoorHallway1, RED_DOOR_FWDL)
