#floor2SouthEast_storeEmployee
  action,?func(questNotStarted, NiceTrySkye):floor2SouthEast_storeEmployee_1
  action,?func(questStepEQ, NiceTrySkye, 1):floor2SouthEast_storeEmployee_1
  action,?func(questStepEQ, NiceTrySkye, 2):floor2SouthEast_storeEmployee_2
  action,floor2SouthEast_storeEmployee_3
  load,?once('0fd7ab02'):floor2SouthEast_storeEmployee_setTicketCost
@floor2SouthEast_storeEmployee_setTicketCost
// this is basically a const value declared in one spot, and used in several other spots
  +setStorage(vars.FlatheadScrewdriverCost, 350)
@floor2SouthEast_storeEmployee_1
  +stopAi(StoreEmployee)
  +:leach(Ada, StoreEmployee)
  +setConversation(Ada)
  +walkToMarker(StoreEmployee, MarkerStoreEmployee1, 0, 0, true)
  +:ld(Ada, rightup)
  +walkPartyToFormation()
  +:w(500)
  +:la(StoreEmployee, Ada)
  +?once('a7c538e8'):{
    StoreEmployee: "Hello there!  Welcome to the <color=LIGHTPURPLE />Second Floor Store</>."
    +:teardrop(StoreEmployee)
    StoreEmployee: "You might've noticed, but this store is in the process of being restocked."
    +:ld(StoreEmployee, rightup)
    StoreEmployee: "We don't have a lot of stuff available. <scale=0.75 />Unless you want some <scale=0.75 italic>tools<scale=0.75 /> or something."
    +:la(StoreEmployee, Ada)
    StoreEmployee: "However, we have set up another temporary location on the other side of the <color=LIGHTPURPLE>Caf8teria</>!"
    StoreEmployee: "They've got a lot of cool items over there!"
    StoreEmployee: "But we are still able to sell potions and a few snacks."
  }
  StoreEmployee: "Did you want to buy something?"
  +setStorage(vars.buySomething, true)
  +?func(questStepEQ, NiceTrySkye, 1):{
    +setStorage(vars.buySomething, false)
    +:question(Ada)
    Ada: "Did you mention that you have some tools?"
    +:ld(StoreEmployee, up)
    StoreEmployee: "Um... Yeah I've got a toolbox here.  That's it though."
    +:la(StoreEmployee, Ada)
    StoreEmployee: "You want to buy it?"
    +:shakeZ(Ada)
    Ada: "I just need a <color=LIGHTBLUE>flathead screwdriver</>. Can I borrow that from you?"
    +:teardrop(StoreEmployee)
    StoreEmployee: "Borrow?  No, I'm sorry I'm not allowed to let any patron borrow anything from the store."
    StoreEmployee: "There's a clause in the employee handbook for specifically prohibiting that sort of thing."
    StoreEmployee: "But I can of course let you buy it, <italic cascade-letters>for a price."
    Ada: "How much?"
    StoreEmployee: "For a <color=LIGHTBLUE>flathead screwdriver</>?  I have no idea why you would want that..."
    StoreEmployee: "Let's say, <color=YELLOW>{vars.FlatheadScrewdriverCost} Tickets</>."
    +?func(inParty, Anjana):{
      +:la(Ada, Anjana)
      +:exclaim(Anjana)
      Anjana: "What?"
      Anjana: "That's an absurd amount!"
      Anjana: "I've seen rare armor for a quarter of that cost!"
      +:la(Ada, StoreEmployee)
      +:shrug(StoreEmployee)
      StoreEmployee: "Well this is probably the only place you'll find one.  And you seem kind of desperate."
      StoreEmployee: "I can also only assume you want to break something in here. So, if you want me to look the other way, I'd of course be entitled to some more."
      +:la(Ada, Anjana)
      +:shakeZ(Anjana)
      Anjana: "<color=GREY scale=0.75>...tch."
      Anjana: "And what about bribery, is there something about that in the <italic>employee handbook</>?"
      Anjana: "You're all vultures."
    }
    +:la(Ada, StoreEmployee)
    +:question(Ada)
    Ada: "They are just tickets, why do you want them that much?"
    +:smirk(StoreEmployee)
    StoreEmployee: "You're new, eh?"
    StoreEmployee: "I'm sure if you walk around here some more you wouldn't need to ask me that."
    StoreEmployee: "Speak to me again if you're interested."
    +completeQuestStep(NiceTrySkye, 1)
  }
  +?is(vars.buySomething):{
    +showStore(SECOND_FLOOR_STORE)
    +?once('e4bf0709'):{
      +setConversation()
      StoreEmployee: "Thanks for your business!"
    }
  }
  +endConversation()
  +resetAi(StoreEmployee)
@floor2SouthEast_storeEmployee_2
  +:floor2SouthEast_storeEmployee_setTicketCost()
  +stopAi(StoreEmployee)
  +:leach(Ada, StoreEmployee)
  +setConversation(Ada)
  +walkToMarker(StoreEmployee, MarkerStoreEmployee1, 0, 0, true)
  +walkPartyToFormation()
  // +:leach(Ada, StoreEmployee)
  StoreEmployee: "Ah, you're the one who wants the <color=LIGHTBLUE>flathead screwdriver</>."
  StoreEmployee: "Did you want to buy it for <color=YELLOW>{vars.FlatheadScrewdriverCost} Tickets</>?  Or are you here to buy something else?"
  +awaitChoice('Yes (pay {vars.FlatheadScrewdriverCost} tickets)', 'No.', 'Buy something else.')
  +?eq(lastChoiceIndex, 0):{
    +?isnot(func(hasEnoughTickets, {vars.FlatheadScrewdriverCost})):{
      +:teardrop(StoreEmployee)
      StoreEmployee: "Umm, you don't have enough."
      StoreEmployee: "Come back when you have <color=YELLOW>{vars.FlatheadScrewdriverCost} Tickets</>."
    }
    +?func(hasEnoughTickets, {vars.FlatheadScrewdriverCost}):{
      +modifyTickets(-{vars.FlatheadScrewdriverCost})
      +:happy(StoreEmployee)
      StoreEmployee: "Wonderful!  And as promised here is your <color=LIGHTBLUE>flathead screwdriver</>."
      +acquireQuestItem(FlatheadScrewdriver)
      +completeQuestStep(NiceTrySkye, 2)
      +?func(inParty, Anjana):{
        +:ld(Anjana, down)
        Anjana: "<color=LIGHTGREY scale=0.75>What a waste.  I hope that girl is worth the cost."
      }
    }
  }
  +?eq(lastChoiceIndex, 1):{
    StoreEmployee: "Come back if you change your mind."
  }
  +?eq(lastChoiceIndex, 2):{
    +showStore(SECOND_FLOOR_STORE)
  }
  +resetAi(StoreEmployee)
  +endConversation()
@floor2SouthEast_storeEmployee_3
  +stopAi(StoreEmployee)
  +:leach(Ada, StoreEmployee)
  +setConversation(Ada)
  +walkToMarker(StoreEmployee, MarkerStoreEmployee1, 0, 0, true)
  +walkPartyToFormation()
  // +:leach(Ada, StoreEmployee)
  +setConversation(Ada)
  StoreEmployee: "Hello there!  Wares are limited as we are moving this store front, but we still have some stuff on clearance!"
  +showStore(SECOND_FLOOR_STORE)
  +resetAi(StoreEmployee)
  +endConversation()

