
#floor2_skyeFirstEncounter
step,?all(func(questIsNotStarted, NiceTrySkye), func(inParty, Anjana)):this
@this
+setConversation('Ada');
+:la(Ada, skye);
+panCameraToFitCharacters(2000, false, Skye);
Skye: "Grr..."
Skye: "This DUMB! STUPID. BOX!"
+none();
+:bumpX(Skye, -2);
+playSound(thunk);
+shakeScreen(250);
+waitMS(1000);
Skye: "GAH! HYA!"
+none();
+:bumpX(Skye, -2);
+playSound(thunk);
+shakeScreen(250);
+waitMS(500);
// +setConversation2('Ada', 'Skye');
+:ld(Skye, rightup);
Skye: "Ouch, <color=LIGHTGREY scale=0.75 cascade-letters>that stings..."
+walkToMarker(Anjana, MarkerSkye0, 22, 0, true);
+walkToMarker(Ada, MarkerSkye0, 0, 0, false);
+walkToMarker(Anjana, MarkerSkye1, 32, 0, true);
+walkToMarker(Ada, MarkerSkye1, 0, 0, false);
+:la(Ada, Skye);
+:la(Anjana, Skye);
+:la(Skye, Ada);
+panCameraToFitCharacters(1000, false, Skye, Ada);
+:lightbulb(Skye);
Skye: "Oh, hey <color=ORANGE>Ada</>!"
+:shakeZ(Skye);
Skye: "Haven't seen <italic>you</> around here before."
Skye: "Come to blow off some steam or something?"
Skye: "I slipped out of detention to come here."
+:smirk(Skye);
Skye: "Went right out the window.  <color=LIGHTBLUE>Mr. Ralgo</> was actually cursing at me as I ran away."
+:teardrop(Ada);
+:teardrop(Anjana);
+:la(Skye, Anjana);
+:shakeZ(Skye);
Skye: "Who's that with you?"
+none();
+walkToOffset(Skye, 24, 0);
+:leach(Skye, Anjana);
+:la(Skye, Ada);
+:la(Skye, Anjana);
Skye: "I don't think I know you."
Skye: "Are you here with <color=ORANGE>Ada</>?"
Skye: "I'm Skye."
+:bumpZ(Skye, -2);
+:teardrop(Anjana);
Anjana: "<cascade-letters>......"
Anjana: "Anjana."
+:question(Anjana);
Anjana: "<italic>You</> are a friend of Ada's?"
Skye: "Yeah. We both go to <color=LIGHTPURPLE>Erran Valley</>.  Classmates.  We sit next to each other."
Anjana: "I see..."
+:doubt(Ada);
Ada: "Why are you hitting that vending machine?"
+:ld(Skye, leftup);
Skye: "What?  This dumpster?"
+:none();
+walkToMarker(Skye, MarkerSkye2);
+:bumpX(Skye, -2);
+playSound(thunk);
+:w(500);
+:la(Skye, Ada);
+:angry(Skye);
Skye: "It keeps eating my tickets!"
Skye: "I've given like 1000 and it still doesn't work!"
+:la(Anjana, Skye);
+:smirk(Anjana);
Anjana: "You could try hitting the machine a bit harder?"
+:ld(Skye, leftup);
Skye: "I've already given it a few good whomps..."
+:leach(Skye, Ada);
+:shakeZ(Ada);
Ada: "Look, Skye, do you know about this place?  This arcade?"
Ada: "I have suddenly found myself in need of getting to the 10th floor."
Skye: "Huh?  Can't you just take an elevator up there?"
Ada: "Apparantly not.  Supposedly one must fight through the arcade's <color=LIGHTBLUE>Revirtualis</> in order to advance in floors."
Skye: "Ya?  I haven't really been there a lot.  Seems kinda like you need to grind through it."
Skye: "I did the tutorial though!"
+:lightbulb(Skye);
Skye: "Couldn't you have <color=ORANGE>Conscience</>, like, hack the elevator or something?"
+:ld(Ada, left);
+:worried(Ada);
Ada: "<color=LIGHTGREY scale=0.8 />If only it were that easy."
+:la(Ada, Skye);
Ada: "Conscience is... trapped.  In the <color=LIGHTBLUE>Revirtualis</> here."
Ada: "It was <color=LIGHTRED>Carl-Arnold</>.  He did something to prevent her from coming with me."
Ada: "I am trying to get her out."
Skye: "I always knew that guy was a tool."
Skye: "Okay.  If you want, I can help you out.  I got some time to kill."
+:teardrop(Anjana);
+:blush(Ada);
Ada: "You would?"
Skye: "Yeah! I owe you anyway; you've always helped me a ton."
+:ld(Skye, leftup);
Skye: "But first..."
+:ld(Skye, leftup);
Skye: "<cascade-letters italic>I need a drink."
+:bumpX(Skye, -2);
+playSound(thunk);
+:teardrop(Ada);
Ada: "Perhaps you should find a different machine."
Ada: "I am guessing that one is... broken?"
+:la(Skye, Ada);
Skye: "No way.  I can't let this thing steal from me!"
Skye: "It's become <italic>personal</>."
+:ld(Skye, left);
Skye: "And besides, the other one is broken or something."
+:ld(Skye, leftup);
Skye: "I'll go with you as soon as I've beaten a drink out of this trash can."
+:teardrop(Ada);
+stopSkipCutscene();
+walkToOffset(Ada, 32, 32, true);
+walkToOffset(Anjana, 32, 32);
+setConversation2(Ada, Anjana);
+:leach(Ada, Anjana);
+panCameraBackToPlayer();
Anjana: "So.  Is it true?"
Ada: "Is what true?"
Anjana: "Are you really friends with that girl?"
Ada: "Yes.  Why do you ask?"
+:teardrop(Anjana);
Anjana: "She seems somewhat <italic>beneath</> you."
Anjana: "Honestly I doubt she'll last another semester at <color=LIGHTPURPLE>Erran Valley</>."
Anjana: "I can already tell."
+:serious(Ada);
Ada: "I <italic>assure</> you that Skye is indeed capable of being a good student, if that is what you are implying."
+:ld(Ada, up);
Ada: "Now.  How do we go about fixing that vending machine?"
+:exhale(Anjana);
Anjana: "You could try asking an employee."
+:la(Ada, Anjana);
+:flat(Ada);
Ada: "Considering the incompetence I have seen on display here, I am not keen on that idea.  What else?"
Anjana: "Then you need to fix it yourself."
+startQuest(NiceTrySkye);
+:ld(Anjana, up);
+:shakeZ(Anjana);
Anjana: "Let's go examine the machine."
+endConversation();

