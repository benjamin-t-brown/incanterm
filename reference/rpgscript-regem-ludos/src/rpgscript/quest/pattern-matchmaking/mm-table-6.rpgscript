#patternMatchmaking_Table6
  action,?func(questNotStarted, PatternMatchmaking):patternMatchmaking_Couple_NotStarted
  action,?func(questActive, PatternMatchmaking):patternMatchmaking_Table6
@patternMatchmaking_Table6
  +:patternMatchmaking_Table6_SetupConv()
  +setStorage(tmp.primaryCh, Liv)
  +setStorage(tmp.secondaryCh, {quest.aux.PatternMatchmaking.Table6SecondaryCh})
  +setStorageCond(tmp.onceKey, "once(mm_convo_{tmp.primaryCh}{tmp.secondaryCh}_{tmp.NextRoundNumber})")
  +?is(tmp.onceKey):{
    +callScript(patternMatchmaking_{tmp.primaryCh}And{tmp.secondaryCh})
  }
  +?isnot(tmp.onceKey):{
    +:patternMatchmaking_SecondConvoForTable(6)
  }

@patternMatchmaking_Table6_SetupConv
  +setWallCollisionEnabled(false)
  +walkToMarker(Party, MarkerTables11, -24, 24)
  +:face(Ada, rightdown)
  +walkPartyToFormation()
  +setWallCollisionEnabled(true)
  +stopAi({tmp.primaryCh})
  +stopAi({tmp.secondaryCh})

@patternMatchmaking_Table6_EndConvo
  +?func(questStepEQ, PatternMatchmaking, 0):{
    +completeQuestSubStep(PatternMatchmaking, 0, 5)
  }
  +?func(questStepEQ, PatternMatchmaking, 2):{
    +completeQuestSubStep(PatternMatchmaking, 2, 5)
  }
  +?func(questStepEQ, PatternMatchmaking, 4):{
    +completeQuestSubStep(PatternMatchmaking, 4, 5)
  }
  +:patternMatchmaking_checkSubTasksForN({quest.aux.PatternMatchmaking.NextRoundNumber})
  +panCameraBackToPlayer(500, true)
  +startAi({tmp.primaryCh})
  +startAi({tmp.secondaryCh})
  +endConversation()

@patternMatchmaking_LivAndScott
  +setConversationGroup(Liv, Scott)
  +:patternMatchmaking_Table6_SetupConv()
  +panCameraToFitCharacters(1000, false, Liv, Scott)
  +?eq(quest.aux.PatternMatchmaking.NextRoundNumber, 2):{
    +:happy(Liv)
    Liv: "Hello! I'm <color=PINK>Liv</>! Nice to meet you!"
    +:la(Scott, Liv)
    Scott: "Yeah.  Hi.  I'm <color=LIGHTBLUE>Scott</>.  <color=LIGHTGREY scale=0.8 cascade-letters>Not that it really matters."
    Liv: "What was that?  Could you speak up?"
    +:nervous(Scott)
    Scott: "Look, <scale=0.8 />I'm not really part of this dating event thing."
    +:ld(Scott, leftup)
    Scott: "I'm just saving a seat for my friend."
    Liv: "Your friend?"
    +:la(Scott, Liv)
    Scott: "Yes.  My friend!  He's late!  He told me to go sign up for him and chill here until he comes back."
    Liv: "Oh, that's nice of you!"
    Scott: "Yeah, well, I'm not really into this sort of thing."
    Scott: "If you don't mind, I'd rather not pretend like we're here for the same reason."
    Scott: "Let's just... chill for a bit or something."
    Liv: "Okay!  I can do that!"
    +?func(inParty, Skye):{
      +:leach(Ada, Skye)
      Skye: "He should at least try to talk to her.  I mean, he's here, right?"
    }
    +?func(inParty, Anjana):{
      +:leach(Ada, Anjana)
      Anjana: "Somehow I doubt his 'friend' was being entirely truthful.  I doubt he's coming back."
    }
  }
  +:patternMatchmaking_Table6_EndConvo()

