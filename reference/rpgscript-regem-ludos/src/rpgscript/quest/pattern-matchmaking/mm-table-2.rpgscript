#patternMatchmaking_Table2
  action,?func(questNotStarted, PatternMatchmaking):patternMatchmaking_Couple_NotStarted
  action,?func(questActive, PatternMatchmaking):patternMatchmaking_Table2
@patternMatchmaking_Table2
  +:patternMatchmaking_Table2_SetupConv()
  +setStorage(tmp.primaryCh, Junlia)
  +setStorage(tmp.secondaryCh, {quest.aux.PatternMatchmaking.Table2SecondaryCh})
  +setStorageCond(tmp.onceKey, "once(mm_convo_{tmp.primaryCh}{tmp.secondaryCh}_{tmp.NextRoundNumber})")
  +?is(tmp.onceKey):{
    +callScript(patternMatchmaking_{tmp.primaryCh}And{tmp.secondaryCh})
  }
  +?isnot(tmp.onceKey):{
    +:patternMatchmaking_SecondConvoForTable(2)
  }

@patternMatchmaking_Table2_SetupConv
  +setWallCollisionEnabled(false)
  +walkToMarker(Party, MarkerTables3, -4, -16)
  +:face(Ada, left)
  +walkPartyToFormation()
  +setWallCollisionEnabled(true)
  +stopAi({tmp.primaryCh})
  +stopAi({tmp.secondaryCh})

@patternMatchmaking_Table2_EndConvo
  +?func(questStepEQ, PatternMatchmaking, 0):{
    +completeQuestSubStep(PatternMatchmaking, 0, 1)
  }
  +?func(questStepEQ, PatternMatchmaking, 2):{
    +completeQuestSubStep(PatternMatchmaking, 2, 1)
  }
  +?func(questStepEQ, PatternMatchmaking, 4):{
    +completeQuestSubStep(PatternMatchmaking, 4, 1)
  }
  +:patternMatchmaking_checkSubTasksForN({quest.aux.PatternMatchmaking.NextRoundNumber})
  +panCameraBackToPlayer(500, true)
  +startAi({tmp.primaryCh})
  +startAi({tmp.secondaryCh})
  +endConversation()

@patternMatchmaking_JunliaAndAnders
  +setConversationGroup(Junlia, Anders)
  +:patternMatchmaking_Table2_SetupConv()
  +?eq(quest.aux.PatternMatchmaking.NextRoundNumber, 2):{
    Ada: "Her name-tag says 'Junlia'."
    +:flat(Ada)
    Ada: "She's sitting here, alone...?"
    +panCameraToFitCharacters(1000, false, Junlia)
    Junlia: "So I really like apple pies, that's one thing about me you really should know."
    +:ld(Junlia, down)
    Junlia: "I used to go apple picking with my grandmother when I was a kid, and we'd make pies together.  They were <shake>soooooo</> yummy.  You have no idea."
    +:ld(Junlia, right)
    Junlia: "Oh!  And also hiking.  Love that.  I like to get out early.  Like, <italic>really</> early.  Like, before the sun comes up.  I like to watch the sun rise over the mountains."
    Junlia: "Soooooo</> pretty."
    +:ld(Junlia, rightdown)
    Junlia: "Like I have no idea how the sun can look that way, you know?"
    +:ld(Junlia, down)
    Junlia: "It really puts into perspective how small we are in the universe."
    +:ld(Junlia, rightdown)
    Junlia: "Have you ever just sat down on the carpet and had a good cry?</>  I mean, like, really let it all out?"
    +:ld(Junlia, rightdown)
    Junlia: "I'm trying to meet somebody who has.  I've never done it myself.  But I think it would be a good experience.</>"
    +:worried(Ada)
    Ada: "<color=LIGHTGREY />(Is she just sitting here and talking to herself?)"
  }
  +?eq(quest.aux.PatternMatchmaking.NextRoundNumber, 2):{
    Junlia: "I don't have a very good singing voice, or so I've been told."
    Junlia: "But I like to sing anyway.  I think it's good for the soul."
    Junlia: "La, la, la, la, laaaaaa.  See?  Not very good. Hehehe."
  }
  +:patternMatchmaking_Table2_EndConvo()

