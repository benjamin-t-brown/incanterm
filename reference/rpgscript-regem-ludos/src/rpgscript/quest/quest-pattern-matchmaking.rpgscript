    // table 5
    +setStorage(tmp.mm8, Floor2Cafeteria_MM_Bernie)
    +setStorage(tmp.mm9, Floor2Cafeteria_MM_{quest.aux.PatternMatchmaking.Table5_Round2_TertiaryCh})
    +setStorage(quest.aux.PatternMatchmaking.Table5TertiaryCh, {quest.aux.PatternMatchmaking.Table5_Round2_TertiaryCh})

    // table 6
