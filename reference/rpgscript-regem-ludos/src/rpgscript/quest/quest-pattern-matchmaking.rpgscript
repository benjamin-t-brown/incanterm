  // if round 3
  +?any(func(questStepEQ, PatternMatchmaking, 4), func(questStepEQ, PatternMatchmaking, 5)):{
    +setStorageIfNotSet(quest.aux.PatternMatchmaking.NextRoundNumber, 4)

    // table 1
    +setStorage(tmp.mm0, Floor2Cafeteria_MM_StefaniGwen)
    +setStorage(tmp.mm1, Floor2Cafeteria_MM_{quest.aux.PatternMatchmaking.Table1_Round2_TertiaryCh})
