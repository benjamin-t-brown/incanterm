  }
  +?all(eq(ARG0, Millie), eq(ARG1, Bobby)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Stefani),eq(quest.aux.PatternMatchmaking.Table1_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Junlia),eq(quest.aux.PatternMatchmaking.Table2_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Jill),eq(quest.aux.PatternMatchmaking.Table3_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Saiki),eq(quest.aux.PatternMatchmaking.Table4_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Bernie),eq(quest.aux.PatternMatchmaking.Table5_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Liv),eq(quest.aux.PatternMatchmaking.Table6_Round2_SecondaryCh, ARG1)):{
    +incrementStorage(tmp.pairingCount, 1)
  }
  +?all(eq(ARG0, Robin),eq(quest.aux.PatternMatchmaking.Table7_Round2_SecondaryCh, ARG1)):{
