    // table 2
    +setStorage(tmp.mm2, Floor2Cafeteria_MM_Junlia)
    +setStorage(tmp.mm3, Floor2Cafeteria_MM_{quest.aux.PatternMatchmaking.Table2_Round2_TertiaryCh})
