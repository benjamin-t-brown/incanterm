    // table 7
    +setStorage(tmp.mm12, Floor2Cafeteria_MM_Robin)
    +setStorage(tmp.mm13, Floor2Cafeteria_MM_{quest.aux.PatternMatchmaking.Table7_Round2_TertiaryCh})
