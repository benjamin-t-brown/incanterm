    // table 3
    +setStorage(tmp.mm5, Floor2Cafeteria_MM_Jill)
    +setStorage(tmp.mm4, Floor2Cafeteria_MM_{quest.aux.PatternMatchmaking.Table3_Round2_TertiaryCh})
    +setStorage(quest.aux.PatternMatchmaking.Table3TertiaryCh, {quest.aux.PatternMatchmaking.Table3_Round2_TertiaryCh})

    // table 4
