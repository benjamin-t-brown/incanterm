  +panCameraToFitCharacters(500, false, Ada, Employee)
  +lookAtEachOther(Ada, Employee)
  +:shakeZ(Employee)
  +:smirk(Employee)
  Employee: "Hey, I didn't give you permission to go down there!"
  +panCameraBackToPlayer()
  +resetAi(Employee)
  +walkToOffset(Ada, 0, -8)
  +endConversation()

