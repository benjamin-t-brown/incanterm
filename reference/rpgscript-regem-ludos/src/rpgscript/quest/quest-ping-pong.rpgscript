  }
  +none()
  +panCameraBackToPlayer()
  +endConversation()

#Floor1East1Storage_Employee_preventStealing
  action,this
@this
  +stopAi(Employee)
  +setConversation(Ada)
  +waitMS(100)
  +playSound(aggro_alert)
  +:jump(Ada, true)
  +panCameraToFitCharacters(500, false, Ada, Employee)
  +lookAtEachOther(Ada, Employee)
  +:shakeZ(Employee)
  +:smirk(Employee)
  Employee: "Careful there hun, wouldn't want to get caught stealing anything, would you?"
  +panCameraBackToPlayer()
  +resetAi(Employee)
  +endConversation()

#Floor1East1Storage_Employee_preventDownStairs
  step,this
@this
  +stopAi(Employee)
  +setConversation(Ada)
  +waitMS(100)
  +playSound(aggro_alert)
