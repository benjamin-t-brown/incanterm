#floor2ThroneRoom-overlay6
  step-first,?once('cc7b13ac'):this
@this
  +?isnot(Lotte):{
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
  }
  +:ld(Lotte, down)
  +:ld(Bartolo, down)
// +playSound(lightswitch_echo);
// +addOverlay('overlays/overlay-throne-room6', 'normal');
  +removeOverlay('overlays/overlay-throne-room6', 'normal', 400, true)
  +:floor2ThroneRoom-beginSequence()

@carlArnoldLaugh
  +none()
  +setAnimation(Carnold, ch_carl-arnold_laugh)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(200)
  +playSound(boy_laugh)
  +waitMS(350)
  +setAnimationState(Carnold, idle)

#floor2ThroneRoom-beginSequence
// step-first,?once('5d175550'):this
@this
  +?isnot(Lotte):{
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
  }
  +:ld(Lotte, down)
  +:ld(Bartolo, down)
  +setAnimation(Carnold, ch_carl-arnold_hands_behind_back_up)
  +playSound(lightswitch_echo)
// +removeOverlays(750, true);
  +spawnCharacterAtCharacter('Conscience', 'Ada')
  +walkToMarker(Ada, MarkerAda0, 0, 0, true)
  +walkToMarker(Conscience, MarkerConscience0, 0, 0)
  +:ld(Conscience, up)
  +:ld(Ada, up)
  +waitMS(200)
  +:throneRoomCutscenePart1()

@throneRoomCutscenePart1
  +setConversation(Ada)




// START BLOCK
  +panCameraToFitCharacters(1500, false, Lotte, Bartolo, Carnold)
  +panCameraRelativeToCurrentPosition(0, -20, 1000)
  +:shakeZ(Carnold)
  Carnold: "Hello there, <color=ORANGE cascade-letters>Adalais<cascade>."
  Carnold: " I've been expecting you."
  +:ld(Ada, up)
  +none()
  +panCameraRelativeToCurrentPosition(0, 20, 500)
  +:ld(Ada, up)
  +:flat(Ada)
  +:ld(Conscience, up)
  Ada: "I certainly hope so."
  Ada: "You managed to <italic>drag</> me in here.  What is it that you want?"
  +none()
  +panCameraRelativeToCurrentPosition(0, -20, 500)
  +:shakeZ(Carnold)
  Carnold: "<scale=0.75 />What do I want...?"
  +none()
  +waitMS(1000)
  +setAnimationState(Carnold, idle)
  +:face(Carnold, up)
  +waitMS(100)
  +:face(Carnold, rightup)
  +waitMS(100)
  +:face(Carnold, right)
  +waitMS(100)
  +:face(Carnold, rightdown)
  +waitMS(100)
  +:face(Carnold, rightdown)
  +waitMS(100)
  +setAnimation(Carnold, ch_carl-arnold_hands_behind_back_down)
  +:shakeZExtended(Carnold)
  Carnold: "I desire so much.  And yet, also, so little."
  +none()
  +stopMusic(1000, true)
  +:smallPause()
  +playSound(terminal_beep)
  +waitMS(100)
  +applyZTransform(Carnold, -96, 1500, true, true)
  +playSound(sliding_door_open)
  +waitMS(50)
  +playSound(robot_clank4)
  +waitMS(50)
  +playSound(robot_clank2)
  +waitMS(900)
  +playSound(robot_clank3)
  +waitMS(50)
  +playSound(robot_clank4)
  +waitMS(50)
  +playSound(robot_clank2)
  +waitMS(400)
  +playSound(robot_clank)
  +waitMS(500)
  +walkToMarker(Carnold, MarkerCarnoldWalk0)
  +panCameraRelativeToCurrentPosition(0, 60, 500)
  +waitMS(500)
  +playMusic(music_carl_arnold_theme)
  Carnold: "So..."
  Carnold: "The widely-labeled <italic>smartest</> girl in all of <color=LIGHTPURPLE>Erran Valley High School</> has entered my domain."
  +:shakeZ(Carnold)
  Carnold: "This is a wondrous opportunity."
  Ada: "<cascade-letters>......"
  +:shakeZ(Carnold)
  Carnold: "Before we get to all the serious business..."
  Carnold: "I wanted to ask <italic>you</>, a certain question."
  +none()
  +:lookAround(Carnold)
  Carnold: "What do you think of this place?"
  +:grumpy(Ada)
  +:ld(Ada, right)
  +waitMS(250)
  +:ld(Ada, rightdown)
  +waitMS(250)
  Ada: "What exactly is it?"
  +:ld(Ada, up)
  +:shakeZ(Carnold)
  Carnold: "It's my throne room."
  Carnold: "My <color=LIGHTPURPLE>status</> in this arcade allows me certain freedoms within the <color=LIGHTBLUE>Revirtualis</> here."
  Carnold: "I created this place, among others, to serve as a monument to my many achievements."
  +:teardrop(Ada)
  Ada: "It is <italic>quite</> gaudy."
  Ada: "But, as a <italic>throne room</> it seems to be missing something quite important."
  Ada: "A throne, perhaps?"
  +:ld(Carnold, leftdown)
  +:happy(Carnold)
  Carnold: "It's around here somewhere, you just have to look hard for it."
  +:ld(Carnold, down)
  +:grumpy(Ada)
  Ada: "Is this all you wanted to show me?  Your throne room?"
  +:carlArnoldLaugh()
  +setAnimationState(Carnold, idle)
  +:shakeZ(Carnold)
  Carnold: "Of course not!"
  Carnold: "I wanted you to see something I had achieved by myself."
  +:question(Ada)
  Ada: "What do you mean?"
  +:shakeZ(Carnold)
  Carnold: "I mean just what I said. <scale=1.25 italic>I alone</> built this place."
  +:exclaim(Carnold)
  +:shakeZ(Carnold)
  +:la(Carnold, Ada)
  Carnold: "It took a lot of effort you know."
  +:shakeZ(Carnold)
  Carnold: "I need to maintain intimate knowledge of the <color=LIGHTBLUE>Revirtualis</>: its inner workings, its quirks, its caveats..."
  +:shakeZ(Carnold)
  Carnold: "But, honestly it's trivial for a student at the top of the class, like me."
  +:question(Carnold)
  Carnold: "What about you?  Have you achieved anything <italic>by yourself</> like this?"
  +:bored(Ada)
  +:ld(Ada, right)
  Ada: "Have I built a virtual throne room?  Goodness no."
  +:ld(Ada, down)
  Ada: "I would like to think my common sense would stop my head from getting so large."
