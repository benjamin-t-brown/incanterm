@floor2ThroneRoom
  +stopMusic(500)
  +:ld(Carnold, down)
  +offsetCharacter(Carnold, 0, 0, 96)
  +:floor2-throne-room-lotte1()
// +:floor2ThroneRoom-beginSequence();

@floor2-throne-room-lotte1
  +waitMS(500)
  +playMusic(music_c_ambience)
  +setConversation(Ada)
  +:smallPause()
  Ada: "It is quite dark in here..."
  +none()
  +spawnCharacterAtCharacter(Lotte, Ada, 16, -16)
  +:ld(Lotte, up)
  +walkToMarker(Lotte, MarkerLotteWalk0)
  +:ld(Lotte, down)
  +:shakeZ(Lotte)
  Lotte: "This way, please."
  +none()
  +:ld(Lotte, up)
  +:shakeZ(Lotte)
  +walkToMarker(Lotte, MarkerLotteWalk1)
  +walkToMarker(Lotte, MarkerLotte, 0, 0, true)
  +endConversation()

#floor2ThroneRoom_ForceField
  action,this
@this
  +:ld(Ada, down)
  +setConversation(Ada)
  Ada: "It looks like some kind of force-field."
  +endConversation()


#floor2ThroneRoom-overlay2
  step-first,?once('04ca1ed7'):this
@this
  +playSound(lightswitch_echo)
  +addOverlay('overlays/overlay-throne-room2', 'normal')
  +removeOverlay('overlays/overlay-throne-room1', 'normal', 750, true)

#floor2ThroneRoom-overlay3
  step-first,?once('d5bffb28'):this
@this
  +playSound(lightswitch_echo)
  +addOverlay('overlays/overlay-throne-room3', 'normal')
  +removeOverlay('overlays/overlay-throne-room2', 'normal', 750, true)

