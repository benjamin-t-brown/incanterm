    ThugLeader: "Oh, really?"
    ThugLeader: "Fine.  I don't care."
    +:ld(Conscience, rightup)
    +panCameraToFitCharacters(1000, false, Ada, ThugLeader)
    +walkToMarker(Conscience, MarkerRPSAdaWalk1)
    +walkToOffset(Ada, 16, 0)
    +:la(Ada, ThugLeader)
    +:ld(Conscience, rightup)
