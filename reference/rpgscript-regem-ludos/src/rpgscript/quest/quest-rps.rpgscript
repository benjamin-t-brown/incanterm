#floor2Rps_primaryCutscene
  load,?func(questActive, RPS):this
@floor2Rps_primaryCutscene
  +stopSkipCutscene()
  +setCharacterAtCharacter(Conscience, Ada, -8, -8)
  +walkToOffset(COnscience, 8, 0)
  +fadeIn(300)
  +stopMusic(500, false)
  +playMusic(music_snoop)
  +endConversation(100)
  +setConversationGroup(Ada, ThugLeader)
  +:ld(Party, right)
  +setSpeed(Ada, 1)
  +setSpeed(ThugLeader, 0.75)
  +panCameraToFitCharacters(2000, false, Ada, ThugLeader)
  +walkToOffset(ThugLeader, 8, 0)
  +:ld(ThugLeader, leftdown)
  +:shakeZ(ThugLeader)
  +:smirk(ThugLeader)
  ThugLeader: "So, our little challenger has arrived."
  +none()
  +walkToMarker(ThugLeader, MarkerThugLeader)
  +:ld(ThugLeader, leftdown)
  ThugLeader: "C'mon over here and let's get this little game started."
  +none()
  +walkToMarker(Ada, MarkerRPSAdaWalk1)
  +walkToMarker(Conscience, MarkerRPSAdaWalk1, 24, 24)
  +:ld(Conscience, up)
  +:floor2Rps_thugsLookAtSomething(Ada)
  +:ld(Ada, rightup)
  +panCameraToFitCharacters(500, false, Ada, ThugLeader)
  +:question(Ada)
  Ada: "I presume this is your <italic>hideout</>?"
  +:ld(ThugLeader, rightdown)
  ThugLeader: "That's right!"
  ThugLeader: "It's more a <italic>den</> than a <italic>hideout</>, but that ain't here nor there."
  +:ld(ThugLeader, leftdown)
  +:smallPause()
  +:ld(Ada, right)
  +:shakeZ(Ada)
  Ada: "It looks like some kind of storage room."
  +:ld(Ada, rightup)
  Ada: "Does the staff know that you have apprehended this place?"
  ThugLeader: "<cascade-letters>The staff...?"
  +:shakeZ(ThugLeader)
  ThugLeader: "Don't make me laugh!  I'd be surprised if any of the staff even knew this room exists."
  ThugLeader: "If you don't know, they're kinda <italic>clueless</>."
  +:ld(Ada, rightdown)
  Ada: "<italic>No kidding...</>"
  +:ld(Ada, rightup)
  +:shakeZ(ThugLeader)
  ThugLeader: "But they do know that we, <color=LIGHTBLUE>The Sashes</>, exist!"
  ThugLeader: "And they respect us!"
  +:exhale(Ada)
  Ada: "Look, I have neither the time, nor desire to deal with you right now."
  Ada: "Just get on with whatever <color=LIGHTBLUE>stupid thing you have concocted</>."
  +:shakeZ(ThugLeader)
  ThugLeader: "Of course, milady."
  ThugLeader: "Why don't you check out the little box between us."
  ThugLeader: "This right here's a machine we went through a painstakingly precise process to procure."
  +panCameraToFitCharacters(500, false, Thug1)
  +:shakeZ(Thug1)
  Thug1: "Wait, didn't <color=ORANGE>Bartolo</> just <italic>give</> that to us?"
  +:la(ThugLeader, Thug1)
  +:jump(ThugLeader)
  ThugLeader: "<shake>SILENCE!"
  +panCameraToFitCharacters(500, false, Ada, ThugLeader)
  +:la(ThugLeader, Ada)
  ThugLeader: "It's an arcade game console.  Top of the line, of course.  It lets us play <italic>a certain head-to-head game</> you might have heard of..."
  +:jump(ThugLeader)
  ThugLeader: "<cascade=250 color=YELLOW>Rock! Paper! Scissors!"
  +:teardrop(Ada)
  Ada: "You cannot be serious."
  +:smirk(ThugLeader)
  ThugLeader: "Ah, but I am!"
  Ada: "You are <italic>really</> going to make me play you in Rock-Paper-Scissors just so I can get get my <color=LIGHTBLUE>Haptic Bracer</> back?"
  ThugLeader: "Yup.  And I can assure you.  You won't beat me."
  +:flat(Ada)
  Ada: "You cannot possibly make such a strong assurance."
  Ada: "It is a straightforward game of rote probability.  If you play it enough times we will both win equally."
  ThugLeader: "If you believe that, you'll wanna come to terms with the fact that you'll not get your little, precious item back."
  ThugLeader: "Why don't we set up some rules then?"
  ThugLeader: "I wanna savor this, so..."
  ThugLeader: "Best of five?  So you gotta win <color=LIGHTBLUE>three games</> to win."
  Ada: "Do we really have to use this box to play?  Can we not just use our hands or something?"
  +:angry(ThugLeader)
  ThugLeader: "No!  We have the technology.  No need to be so <italic>old-fashioned."
  Ada: "Fine.  Whatever."
  ThugLeader: "It's easy.  Just walk up and make your selection when the time comes."
  ThugLeader: "And - just so you know - it's on 'shoot!'"
  +stopSkipCutscene()
  +setUnskippable(true)
  +none()
  +walkToOffset(Ada, 0, -8, true)
  +walkToOffset(ThugLeader, 0, 8, false)
  +:bumpY(ThugLeader, 2)
  +playSound(terminal_beep)
  +:smallPause()
  +changePropAnim(PropRPSMachine, props-anims-square-machine)
  +playSound(ready_arcade_game)
  +:smallPause()
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>INITIALIZING GAME OF <color=ORANGE cascade-letters=13>Rock! Paper! Scissors!</>"
  +playSound(click)
  +none()
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>TWO PLAYERS DETECTED..."
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>PLAYER 1: <color=ORANGE>GUEST</>."
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>PLAYER 2: <cascade-letters=13 color=LIGHTRED>THE SASHES <color=LIGHTPURPLE>(WARNING: NAME OVERRIDDEN BY CONFIG)"
  +playSound(click)
  +none()
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>READY TO PLAY?"
  +:serious(ThugLeader)
  ThugLeader: "Let's do this."
  +:rps-setup-new-game()


@rps-setup-new-game
  +setStorage('rps.playerWins', 0)
  +setStorage('rps.cpuWins', 0)
  +setStorage('rps.cheating', true)
  +setStorage('rps.adaCheating', false)
  +setStorage('rps.round', 0)
  +:rps-do-round()

@rps-do-round
  +setUnskippable(true)
  +playSound(rps)
  Narrator: "<cascade=325>ROCK! PAPER! SCISSORS! <color=LIGHTBLUE italic scale=1.25>SHOOT!"
  +none()
  +awaitChoice('Rock!', 'Paper!', 'Scissors!')
  +?is(rps.adaCheating):{
    +:shakeZ(Conscience)
  }
  +?isnot(rps.adaCheating):{
    +:shakeZ(Ada)
  }
  +:shakeZ(ThugLeader)
  +?is(rps.adaCheating):{
    +:shakeZ(Conscience)
  }
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>CHOICE RECORDED."
  +playSound(monitor_talk)
  Narrator: "<cascade-letters=13>CALCULATING RESULT..."
  +?eq(lastChoiceIndex, 0):{
    +setStorage('rps.playerChoice', 'rock')
    +?is('rps.cheating'):{
      +setStorage('rps.cpuChoice', 'paper')
      +?is('rps.adaCheating'):{
        +setStorage('rps.playerChoice', 'scissors')
      }
    }
  }
  +?eq(lastChoiceIndex, 1):{
    +setStorage('rps.playerChoice', 'paper')
    +?is('rps.cheating'):{
      +setStorage('rps.cpuChoice', 'scissors')
      +?is('rps.adaCheating'):{
        +setStorage('rps.playerChoice', 'rock')
      }
    }
  }
  +?eq(lastChoiceIndex, 2):{
    +setStorage('rps.playerChoice', 'scissors')
    +?is('rps.cheating'):{
      +setStorage('rps.cpuChoice', 'rock')
      +?is('rps.adaCheating'):{
        +setStorage('rps.playerChoice', 'paper')
      }
    }
  }
  +playSound(terminal_beep)
  +:smallPause()
  +playSound(terminal_beep)
  +:smallPause()
  +playSound(terminal_beep)
  +:smallPause()
  +playSound(monitor_talk)
  Narrator: "RESULTS ARE READY!"
  +playSound(monitor_talk)
  Narrator: "PLAYER 1 <color=ORANGE>GUEST</>: {rps.playerChoice}.\nPLAYER 2 <color=LIGHTRED>THE SASHES</>: {rps.cpuChoice}."
  +playSound(chime)
  +?is('rps.cheating'):{
    +?is('rps.adaCheating'):{
      +incrementStorage(rps.playerWins, 1)
      +playSound(monitor_talk)
      Narrator: "WINNER IS <color=ORANGE>GUEST</>!"
    }
    +?isnot('rps.adaCheating'):{
      +incrementStorage(rps.cpuWins, 1)
      +playSound(monitor_talk)
      Narrator: "WINNER IS <color=LIGHTRED>THE SASHES</>!"
    }
  }
  +playSound(monitor_talk)
  Narrator: "THE SCORE IS - \n<color=ORANGE>GUEST</>: {rps.playerWins} \n<color=LIGHTRED>THE SASHES</>: {rps.cpuWins}"
  +incrementStorage(rps.round, 1)

  +?eq('rps.round', 1):{
    +:exclaim(ThugLeader)
    ThugLeader: "Aha! First win is us!"
    ThugLeader: "Not unexpected."
    +none()
  }
