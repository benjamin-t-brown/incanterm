#floor2_rpsMachineOff
  action,this
@this
  +setConversation(Ada)
  Ada: "The machine is off and does turn on."
  +endConversation()

#floor2_rpsMachineInStorage
  action,this
@this
  +setConversation(Ada)
  Ada: "It looks like an unused arcade machine."
  +endConversation()

