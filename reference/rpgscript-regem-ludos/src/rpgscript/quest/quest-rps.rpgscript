    +:ld(ThugLeader, leftdown)
  }

  +?eq('rps.playerWins', 3):{
    +playSound(monitor_talk)
    Narrator: "Match concluded."
    +playSound(monitor_talk)
    Narrator: "PLAYER 1 <color=ORANGE>ADALAIS ELDRIDGE</> is the winner."
    +playSound(monitor_talk)
    Narrator: "The machine will now shut down."
    +none()
    +changePropAnim(PropRPSMachine, props_square_machine_off)
    +playSound(dialog_start)
    +:smallPause()
    +:smallPause()
    +:floor2_rps_completed()
  }
  +?lt('rps.playerWins', 3):{
    +playSound(monitor_talk)
    Narrator: "<cascade-letters=13>PROCEEDING TO NEXT ROUND."
    +:rps-do-round()
  }

