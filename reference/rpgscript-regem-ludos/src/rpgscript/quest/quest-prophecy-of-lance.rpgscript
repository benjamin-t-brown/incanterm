  +?all(func(questIsStarted, TheProphecyOfLance), once('ab9dc5d1')):{
    +setConversation(Ada)
    +walkToMarker(Ada, MarkerAdaWalkNorth1)
    +:ld(Ada, up)
    +walkPartyToFormation()
    +:surprised(Ada)
    Ada: "A different room?"
    +?func(inParty, Anjana):{
      +:ld(Anjana, up)
      Anjana: "I'm not convinced this was here the whole time and we hallucinated what was here before."
    }
    +?func(inParty, Skye):{
      +:ld(Skye, up)
      Skye: "Where did that green dude go?"
    }
    +endConversation()
  }

@floor2SouthWestNarrowHallwayRoom
