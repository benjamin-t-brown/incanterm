#junkyardSewer1_load
  load,this
@this
  +?is(vars.junkyardSewer1.leverPulled):{
    +removeWallAtMarker(MarkerGate1)
    +removeWallAtMarker(MarkerGate2)
    +changePropAnim(PropLever, props_small_lever_on)
  }
  +?once('4a26621e'):{
    +:junkyardSewer1_firstCutscene()
  }

@junkyardSewer1_firstCutscene
  // +assert("+?all(func(inParty, Skye), func(inParty, Anjana))");
  +fadeOut(1)
  +setConversation(Ada)
  +setAtMarker(Ada, MarkerParty)
  +setPartyAtFormation(19)
  +:face(Party, left)
  +setAnimationState(Party, battle_dead)
  +fadeIn(2000)
  +:w(1000)
  // +:teardrop(Ada)
  +:shakeZ(Skye)
  Skye: "Not my best landing..."
  +:shakeZ(Ada)
  Ada: "Ugh...  What happened?"
  +none()
  +:w(100)
  +setAnimationState(Ada, battle_revive)
  +:w(500)
  +setAnimationState(Ada, idle)
  +setAnimationState(Skye, battle_revive)
  +:w(500)
  +setAnimationState(Skye, idle)
  +:la(Skye, Ada)
  +setAnimationState(Anjana, battle_revive)
  +:w(500)
  +setAnimationState(Anjana, idle)
  +:la(Anjana, Ada)
  +:w(500)
  +:leach(Anjana, Ada)
  Anjana: "That <italic>snake</>!"
  Anjana: "He sent us down here!"
  +:lookAround(Ada)
  Ada: "Where <italic>exactly</> is here?"
  +none()
  +:ld(Skye, leftdown)
  +panCameraRelativeToPlayer(-30, 30)
  Skye: "Looks like some kind of sewer...?"
  +:shakeZ(Anjana)
  Anjana: "<cascade-letters scale=0.8 italic>Gross."
  Skye: "I guess we should look for a way out?"
  +none()
  +panCameraBackToPlayer()
  +:lockCamera()
  +:jump(Ada)
  +:angry(Ada)
  +setAnimation(ada, ada_tantrum_single)
  Ada: "Why is nothing ever <italic>straightforward</> with this stupid arcade!"
  +:la(Skye, Ada)
  +setAnimation(ada, ada_tantrum)
  Ada: "I <shake>NEED</> to get <color=YELLOW>Conscience</> back!"
  +:jump(Ada)
  Ada: "<cascade-letters=50 scale=1.25>Right now!!!"
  +:teardrop(Skye)
  Skye: "Whoah. Chill out.  That's what we're trying to do, remember?"
  +endConversation(100)
  +setConversation2(Ada, Anjana)
  +setAnimation(ada, ada_tantrum_single)
  +:la(Anjana, Ada)
  +:question(Anjana)
  Anjana: "What's so urgent about it?"
  Anjana: "If it's such a big deal why don't you leave the arcade and get somebody else to help out?"
  Anjana: "<color=LIGHTRED>Carl-Arnold</> can't keep her in here forever."
  +setAnimationState(Ada, idle)
  +:w(500)
  +:la(Ada, Anjana)
  Ada: "I cannot just leave with <color=YELLOW>Conscience</> still in here."
  Ada: "For one thing, she will think I abandoned her, and will be insufferable about it."
  Ada: "And for another..."
  +walkToOffset(Ada, -8, 0)
  Ada: "<color=ORANGE>Father</> would be <italic>furious</> if I lost her."
  +:teardrop(Anjana)
  Anjana: "Well, you did lose her, didn't you?"
  +lookAtCharacter(Ada, Anjana)
  +:angry(Ada)
  // NOTE: Intended rare instance of Ada using a contraction
  Ada: "<cascade-letters=65 italic>He doesn't need to know that!"
  +:serious(Anjana)
  Anjana: "So it's obvious what to do then.  We deal with all this nonsense as efficiently as possible."
  Anjana: "No use throwing a tantrum about it."
  +:ld(Ada, leftdown)
  Ada: "<italic scale=0.85>I am not throwing a tantrum..."
  // Ada rubs head
  Ada: "I just... have a headache..."
  +endConversation(100)
  +setConversation(Skye)
  +:leach(Skye, Anjana)
  +:la(Ada, Skye)
  Skye: "So <color=YELLOW>Anjana</>... Do you know who that guy was?  <color=YELLOW>Bartolo</>?"
  +:ld(Anjana, down)
  +:shakeZ(Anjana)
  Anjana: "Yes.  He is my...\n<cascade-letters lightblue italic>classmate</>."
  +:la(Anjana, Ada)
  Anjana: "He's a rat of a person.  Always trying to get ahead by cheating."
  +:leach(Skye, Anjana)
  Skye: "What is so bad about him?  <color=LIGHTGREY />Other than the obvious fact that he is friends with <color=LIGHTRED>Carl-Arnold<color=LIGHTGREY>."
  +:ld(Anjana, down)
  Anjana: "Just trust me, okay.  He's a bad person."
  Anjana: "He is always finding ways to cheat at school to get ahead."
  Anjana: "I have to keep him in check."
  Anjana: "And he has this thing for robots, if you can't already tell."
  Skye: "Why's that bad?"
  Anjana: "He's just obsessed with them.  It's creepy.  I think he want's the world to be run by robots."
  +:la(Anjana, Ada)
  Anjana: "Come on, let's go.  We need to get back up there if we expect to be able to get <color=YELLOW>Conscience</> back into <color=YELLOW>Ada's</> hands."
  +panCameraBackToPlayer(500)
  +endConversation()

#junkyardSewer1_pullLever
  action,?once('dae17d70'):this
  action,junkyardSewer1_pullLever2
@this
  +setConversation(Ada)
  +:bumpZ(Ada, 1)
  +playSound(robot_clank2)
  +changePropAnim(PropLever, props_small_lever_on)
  +panCameraRelativeToPlayer(-25, -25)
  +playSound(robot_clank3)
  +playSound(despawn_tut_wall)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_BOMB_EXPL, MarkerGate1, normal)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_BOMB_EXPL, MarkerGate2, normal)
  +:w(100)
  +removeWallAtMarker(MarkerGate1)
  +removeWallAtMarker(MarkerGate2)
  +:w(400)
  +panCameraBackToPlayer()
  +endConversation()
  +setStorage(vars.junkyardSewer1.leverPulled)
@junkyardSewer1_pullLever2
  +setConversation(Ada)
  Ada: "I already pulled that lever."
  +endConversation()

#junkyardSewer1_transitionTo2
  step,this
@this
  +:utils-change-room(junkyardSewer2, MarkerFrom1)

#junkyardSewer2_transitionTo1
  step,this
@this
  +:utils-change-room(junkyardSewer1, MarkerFrom2)

#junkyardSewer2_load
  load,this
@this
  +?is(vars.junkyardSewer2.leverPulled):{
    +removeWallAtMarker(MarkerGate1)
    +removeWallAtMarker(MarkerGate2)
    +changePropAnim(PropLever, props_small_lever_on)
  }

#junkyardSewer2_pullLever
  action,?func(carryingProp, PropGrease):junkyardSewer2_pullLever_greased
  action,?is(vars.junkyardSewer2.leverPulled):junkyardSewer2_wallOpen
  action,?once('fc71f9a0'):junkyardSewer2_pullLever_broken
  action,junkyardSewer2_pullLever_brokenRepeat
@junkyardSewer2_wallOpen
  +setConversation(Ada)
  Ada: "I have already pulled this lever."
  +endConversation()
@junkyardSewer2_pullLever_greased
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerLeverPull)
  +:ld(Ada, leftup)
  +walkPartyToFormation()
  Ada: "Maybe this grease will get it unstuck."
  +none()
  +setAnimationState(Ada, propdrop)
  +playSound(thunk)
  +dropHeldProps(MarkerLeverPull, -16, -12)
  +:w(100)
  +playSound(oil)
  +:w(200)
  +playSound(robot_clank4)
  +setAnimationState(Ada, idle)
  +:w(100)
  Ada: "Seems like that did the trick."
  +none()
  +:w(100)
  +:bumpZ(Ada, 1)
  +playSound(robot_clank2)
  +changePropAnim(PropLever, props_small_lever_on)
  +:w(500)
  +panCameraRelativeToPlayer(-175, 70)
  +playSound(robot_clank3)
  +playSound(despawn_tut_wall)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_BOMB_EXPL, MarkerGate1, normal)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_BOMB_EXPL, MarkerGate2, normal)
  +:w(100)
  +removeWallAtMarker(MarkerGate1)
  +removeWallAtMarker(MarkerGate2)
  +:w(400)
  +panCameraBackToPlayer()
  +?func(inParty, Skye):{
    +:happy(Skye)
    Skye: "Nice work!"
  }
  +setStorage(vars.junkyardSewer2.leverPulled, true)
  +endConversation()
@junkyardSewer2_pullLever_broken
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerLeverPull)
  +:ld(Ada, leftup)
  +walkPartyToFormation()
  +:bumpX(Ada, -1)
  +playSound(click)
  +:w(33)
  +playSound(click)
  +:w(33)
  +playSound(thunk)
  +:w(500)
  +:angry(Ada)
  Ada: "This lever is stuck!"
  +none()
  +panCameraRelativeToPlayer(-175, 70)
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    Anjana: "I guess we have to go around then. Not unless you want to go for a swim."
  }
  +panCameraBackToPlayer()
  +endConversation()
@junkyardSewer2_pullLever_brokenRepeat
  +setConversation(Ada)
  +:ld(Ada, leftup)
  Ada: "This lever is stuck."
  +endConversation()

