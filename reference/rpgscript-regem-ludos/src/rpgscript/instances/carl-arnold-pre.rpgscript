#floor2_preThroneRoom_transitionFrom2To3
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom3, MarkerFrom2)
#floor2_preThroneRoom_transitionFrom3To2
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom2, MarkerFrom3)
#floor2_preThroneRoom_transitionFrom3To4
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom4, MarkerFrom3)
#floor2_preThroneRoom_transitionFrom4To3
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom3, MarkerFrom4)
#floor2_preThroneRoom_transitionFrom4To5
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom5, MarkerFrom4)
  +?once('floor2PreThroneRoom5'):{
    +setStorage(floor2PreThroneRoom5_lotteCutsceneDone)
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
    +characterSetTalkTrigger(Lotte, floor2PreThroneRoom5LotteTalk)
    +setConversation(Ada)
    +walkToMarker(Lotte, MarkerLotteWalk0, 0, 0)
    +setFacing(Lotte, down)
    +panCameraToFitCharacters(1000, false, Lotte)
    +lookAtCharacter(Ada, Lotte)
    +:shakeZ(Lotte)
    Lotte: "Over here."
    +lookAtCharacter(Ada, Lotte)
    +panCameraBackToPlayer()
    +endConversation()
  }
#floor2_preThroneRoom_transitionFrom5To4
  step,this
@this
  +:utils-change-room(floor2PreThroneRoom4, MarkerFrom5)
#floor2_preThroneRoom_transitionFrom5ToThroneRoom
  step,this
@this
  +:utils-change-room(floor1ThroneRoom, MarkerFromPreThroneRoom)


#floor2PreThroneRoom_transitionFromPortalTo0
