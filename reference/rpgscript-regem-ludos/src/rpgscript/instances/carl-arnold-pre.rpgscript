#floor2_preThroneRoom3_statueSparkle
  action,?isnot(preThroneRoom3Item):this
  action,floor2_preThroneRoom3_statue4
@this
  +setConversation(Ada)
  Ada: "There is something lose on this statue's hand..."
  +none()
  +walkToMarker(Ada, MarkerAdaStatue0)
  +walkToMarker(Ada, MarkerAdaStatue1)
  +setFacing(Ada, rightup)
  +waitMS(250)
  +:jump(Ada, true)
  +waitMS(75)
  +playSound(click)
  +changePropAnim(PropSparkle, invisible)
  +waitMS(500)
  +setFacing(Ada, down)
  +acquireItem(BandOfMinorPower)
  +setStorage(preThroneRoom3Item)
  +endConversation()

#floor2_preThroneRoom4_boxYellow
  action,this
@this
  +setConversation(Ada)
  Ada: "This is a <color=YELLOW>yellow</> box with a label on the side: 'For Bartolo'."
  Ada: "It looks sealed shut with... heavy-duty nails?"
  +endConversation()

#floor2_preThroneRoom4_boxBlue
  action,this
@this
  +setConversation(Ada)
  Ada: "This is a <color=LIGHTBLUE>blue</> box with a label on the side: 'For Lotte'."
  Ada: "There a small seal on the box with a picture of a wand on it."
  +endConversation()

#floor2_preThroneRoom4_boxGreen
  action,this
@this
  +setConversation(Ada)
  Ada: "This is a <color=LIGHTGREEN>green</> box with a label on the side--"
  Ada: "Wait a second... The label is crossed out quite vigorously, but I might still be able to make some of it out..."
  Ada: "I think it says: 'For V-----na.'"
  +:question(Ada)
  Ada: "The box was sealed with tape that was hastily cut open.  It appears empty now."
  +endConversation()

#floor2_preThroneRoom4_boxRed
  action,?once('01c4b43b'):floor2_preThroneRoom4_boxRed1
  action,floor2_preThroneRoom4_boxRed2
@floor2_preThroneRoom4_boxRed1
  +setConversation(Ada)
  Ada: "This is a <color=LIGHTRED>red</> box with a label on the side: 'For the Illustrious Carl-Arnold'."
  Ada: "It looks like I might be able to open it..."
  +none()
  +walkToMarker(Ada, MarkerAdaBox0)
  +setFacing(Ada, up)
  +panCameraRelativeToCurrentPosition(0, 0, 1)
  +waitMS(250)
  +offsetCharacter(Ada, -2, -2)
  +waitMS(500)
  +offsetCharacter(Ada, -1, -1)
  +waitMS(500)
  +playSound(zap_quiet)
  +waitMS(50)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_BLUE_LIGHTNING_LEFT, MarkerAdaBox1, normal)
  +playSound(zap_medium)
  +setAnimation(Ada, 'ada_battle_damaged_left_f')
  +offsetCharacter(Ada, 8, 8)
  +waitMS(50)
  +offsetCharacter(Ada, 6, 6)
  +waitMS(50)
  +offsetCharacter(Ada, 4, 4)
  +waitMS(50)
  +offsetCharacter(Ada, 2, 2)
  +waitMS(500)
  +setAnimationState(Ada, 'idle')
  +:angry(Ada)
  Ada: "Ouch!!"
  +panCameraBackToPlayer()
  +endConversation()
@floor2_preThroneRoom4_boxRed2
  +setConversation(Ada)
  +none()
  +walkToMarker(Ada, MarkerAdaBox0)
  +setFacing(Ada, down)
  Ada: "I certainly do not want to touch that box again.  It zapped me quite thoroughly."
  +endConversation()

@floor2PreThroneRoom4
  +?once('bf0dd6c7'):{
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
