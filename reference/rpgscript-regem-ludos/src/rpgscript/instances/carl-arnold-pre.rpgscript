#floor2PreThroneRoom5_messyNote
  action,this
@this
  +setConversation(Ada)
  +:face(Ada, left)
  +walkPartyToFormation()
  +?func(inParty, Conscience):{
    +:ld(Conscience, leftup)
    Conscience: "Did <color=LIGHTRED>Carl-Arnold</> leave all this stuff here?  Isn't this his personal <color=LIGHTBLUE>Instance</>?"
  }
  Ada: "He really ought to take more pride in his quarters."
  +?func(inParty, Conscience):{
    Conscience: "It looks like he just moved in."
  }
  +endConversation()

#floor2PreThroneRoom5LotteTalk
  action,this
@this
  +setConversation(Lotte)
  +lookAtEachOther(Ada, Lotte)
  +:ld(Lotte, up)
  Lotte: "Proceed into this room."
  +:leach(Ada, Lotte)
  Lotte: "I will follow."
  +endConversation()

#floor2_preThroneRoom5_preventWalkWest
  step-first,this
@this
  +playSound(aggro_alert)
  +:jump(Ada, true)
  +:smallPause()
  +setConversation(Ada)
  +lookAtCharacter(Lotte, Ada)
  +panCameraToFitCharacters(500, false, Lotte)
  +:angry(Lotte)
  Lotte: "Do not go any further!  I didn't guide you here so that you could end up <italic>lost</>."
  +none()
  +walkToOffset(Ada, 32, -32)
  +panCameraBackToPlayer()
  +setFacing(Lotte, down)
  +endConversation()

#floor2_preThroneRoom5_lotteUsherIntoThroneRoom
  step-first,?once('77800b11'):this
  step,floor2_preThroneRoom5_lookAda
@this
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerAdaWalk0)
  +walkPartyToFormation()
  +lookAtEachOther(Lotte, Ada)
  +panCameraToFitCharacters(1000, false, Lotte, Ada)
  +:shakeZ(Lotte)
  +:ld(Lotte, up)
  Lotte: "Proceed into this room."
  +:leach(Ada, Lotte)
  Lotte: "I will follow."
  +:shakeZ(Lotte)
  Lotte: "And of course I needn't say this but..."
  Lotte: "Be sure to show proper respect."
  +panCameraBackToPlayer()
  +setFacing(Lotte, down)
  +endConversation()
@floor2_preThroneRoom5_lookAda
  +lookAtCharacter(Lotte, Ada)

#floor2_preThroneRoom5_transitionToThroneRoom
