#floor2PreThroneRoomPortal_OpenFancyDoor
  step-first,floor2_preThroneRoomPortal_OpenFancyDoor_Open
  step-off,floor2_preThroneRoomPortal_OpenFancyDoor_Close
@floor2_preThroneRoomPortal_OpenFancyDoor_Open
  +playSound(sliding_door_open)
  +:openDoubleDoorsFwd(MarkerDoor, FANCY_DOOR)
@floor2_preThroneRoomPortal_OpenFancyDoor_Close
  +playSound(sliding_door_close)
  +:closeDoubleDoorsFwd(MarkerDoor, FANCY_DOOR)

#floor2_mainQuestLotte
  step-first,?once('a587a5a1'):this
@this
  +spawnCharacterAtMarker(Lotte, MarkerLotteSpawn)
  +:face(Lotte, leftdown)
  +setConversation2("", Lotte)
  +:leach(Ada, Lotte)
  Lotte: "You there!"
  +:question(Ada)
  +none()
  +walkToMarker(Ada, MarkerAdaWalk1)
  +:ld(Ada, rightup)
  +walkPartyToFormation()
  +walkToCharacter(Lotte, Ada, 0, -49)
  +setConversation2("Ada", Lotte)
  +:leach(Ada, Lotte)
  +panCameraToFitCharacters(1000, false, Ada, Lotte)
  Lotte: "You are <color=ORANGE>Ada</>?"
  Ada: "Yes..."
  +none()
  +walkToOffset(Lotte, 16, 0)
  +:ld(Lotte, leftdown)
  Lotte: "And <color=YELLOW cascade-letters>Conscience</>?"
  +replaceConversationMember2(Conscience, left)
  +:happy(Conscience)
  Conscience: "That's me!"
  +:ld(Lotte, leftdown)
  Lotte: "Good.  I need you to come with me."
  +replaceConversationMember2(Ada, left)
  +:exclaim(Ada)
  Ada: "Wait a second!"
  Ada: "I have neither the time, nor the patience for another diversion!"
  Ada: "I am going to find <color=LIGHTRED>Carl-Arnold</> this moment!"
  +:sarcasm(Lotte)
  Lotte: "He told me you might give me some attitude."
  Lotte: "Don't worry.  My name is <color=ORANGE>Lotte</>.  I'm here to take you to him."
  Lotte: "But you will have to follow me to get there."
  +stopSkipCutscene()
  +:grumpy(Ada)
  Ada: "Fine."
  +none()
  +setSpeed(Party, 0.5)
  +setSpeed(Lotte, 0.5)
  +walkToOffset(Lotte, 0, -32, true)
  +walkToOffset(Party, 0, -32, true)
  +:w(500)
  +fadeOut(1000)
  +setSpeed(Party)
  +panCameraBackToPlayer(1)
  +:utils-change-room(floor2GuestroomPortal, MarkerFromHallway, true)

@floor2_preThroneRoom_lotte2
// Ada, Conscience, and Lotte have just come out of the portal.
  +setSpeed(Lotte, 1.5)
  +walkToCharacter(Conscience, Ada, 16, 0)
  +walkToOffset(Conscience, 0, 16)
  +spawnCharacterAtMarker(Lotte, MarkerLotte)
  +lookAtEachOther(lotte, ada)
  +lookAtEachOther(lotte, conscience)
  // +stopSkipCutscene()
  +setConversation('Lotte')
  +:shakeZ(Lotte)
  +:surprised(Lotte)
  +panCameraToFitCharacters(500, true, Ada, Conscience, Lotte)
  Lotte: "How curious..."
  +walkToOffset(Lotte, 0, 24)
  +walkToOffset(Lotte, 8, 0)
  +:shakeZ(Lotte)
  Lotte: "You look almost exactly the same."
  +none()
  +setFacing(Conscience, left)
  +waitMS(250)
  +setFacing(Conscience, down)
  +waitMS(250)
  +:question(conscience)
  Conscience: "We are plenty different, I assure you."
  +:la(Ada, Conscience)
  +:shakeZ(Ada)
  Ada: "<cascade-letters scale=0.75>Conscience..."
  +lookAtEachOther(lotte, conscience)
  +:la(Ada, Lotte)
  +:shakeZ(Lotte)
  Lotte: "Indeed you are."
  ++walkToOffset(Lotte, 0, -24)
  +:ld(Lotte, rightdown)
  +:la(Conscience, Lotte)
  +:la(Ada, Lotte)
  +:shakeZ(Lotte)
  Lotte: "You seem... quite normal."
  Conscience: "Thanks!  <scale=0.75 />I guess.</>"
  +:blush(Conscience)
  Conscience: "You've got a very <italic>alluring</> costume there, by the way."
  +:heart(Lotte)
  Lotte: "That's by design, dear. I'm glad you noticed."
  Lotte: "I prefer to make use of <italic>all my assets</>."
  Lotte: "This week there's a <color=LIGHTPURPLE>costume contest</> in the ballroom on floor 6."
  Lotte: "I'm testing out a few options...  Today I'm a <color=LIGHTBLUE>sorceress</>.  It suits me, does it not?"
  +:spin(Lotte)
  +waitMS(1000)
  +lookAtEachOther(lotte, ada)
  +endConversation(1)
  +setConversation2(Lotte, Ada)
  +:teardrop(Ada)
  Ada: "<cascade>Can you just hurry up and take us to <color=LIGHTRED>Carl-Arnold</>?"
  +:smallPause()
  +:sarcasm(Lotte)
  Lotte: "So.<delay=250 /> You are the infamous <color=ORANGE />Adalais Eldridge</> of <color=LIGHTPURPLE>Erran Valley</>."
  Lotte: "I thought you'd be taller."
  +:ld(Ada, left)
  Ada: "<color=LIGHTGREY scale=0.8 />And I thought you would be <italic>more helpful</>.  Where is <color=LIGHTRED>Carl-Arnold</>?"
  Lotte: "Well, well, well.  You've got some bite, don't you?"
  +:la(Ada, Lotte)
  Ada: "Sorry, but who exactly are you?"
  +:angry(Lotte)
  Lotte: "I am <color=LIGHTRED>Lotte</>.  Also a student of <color=LIGHTPURPLE>Erran Valley</>.  Anybody worth anything is from there of course."
  Ada: "Are you one of <color=LIGHTRED>Carl-Arnold</>'s lackeys or something?"
  Lotte: "One of his <italic>lackeys</>?  Of course not."
  Lotte: "I simply do him a few favors from time to time."
  Lotte: "Like shepherding you around for example."
  +stopSkipCutscene()
  +:ld(Lotte, leftdown)
  Lotte: "Let us proceed.  Follow me."
  +none()
  +walkToMarker(Lotte, MarkerLotteWalk1)
  +lookAtEachOther(lotte, ada)
  +lookAtEachOther(lotte, conscience)
  Lotte: "<color=LIGHTRED>Carl-Arnold</> is very <italic>eager</> to see you, after all."
  +none()
  +setFacing(Lotte, leftup)
  +:floor2_preThroneRoomPortal_OpenFancyDoor_Open()
  +walkToMarker(Lotte, MarkerLotteWalk2)
  +despawnCharacter(Lotte)
  +:floor2_preThroneRoomPortal_OpenFancyDoor_Close()
  +endConversation(100)
  +setConversation2(Ada, Conscience)
  +lookAtCharacter(Ada, Conscience)
  +:bored(Ada)
  Ada: "You are rather <italic>chummy</> today."
  +lookAtCharacter(Conscience, Ada)
  Conscience: "I'm just being polite."
  Ada: "Just stay close to me.  I have a bad feeling about this."
  // +:angry(Lotte)
  // +setConversation(Lotte)
  // +setFacing(Lotte, rightdown)
  // +panCameraToFitCharacters(1000, true, 'Lotte')
  // +waitMS(500)
  // +:shakeZ(Lotte)
  // Lotte: "Are you two going to follow me?  I am not known for my patience."
  +panCameraBackToPlayer(1000)
  // +setConversation(Conscience)
  // +:jump(Conscience)
  // Conscience: "We're coming!"
  +setStorage('tmp.floor2Pre_SpawnLotteNextRoom', true)
  +endConversation()

#floor2_preThroneRoom_lotte4_move
  step,?once('30d66288'):this
@this
  +setConversation(Ada)
  +:leach(Lotte, Ada)
  Lotte: "This way.  Don't stray too far from me."
  Lotte: "This place can be a little... unruly."
  +endConversation()
  +walkToMarker(Lotte, MarkerLotteWalk5, 0, 0, true)

#floor2_preThroneRoom_lotte5_move
  step,?once('35894cd4'):this
@this
  +walkToMarker(Lotte, MarkerLotteWalk5, 0, 0, true)

#floor2_preThroneRoom_lotte6_move
  step,?once('9bef66bd'):this
@this
  +setStorage(tmp.floor2PreSpawnLotteAtEnd, false)
  +setConversation(Ada)
  +panCameraRelativeToPlayer(-50, 50, 1000, true)
  +walkToMarker(Lotte, MarkerLotteWalk6, 0, 0)
  +setFacing(Lotte, rightup)
  +:jump(Lotte)
  Lotte: "This way."
  Lotte: "There might be some critters jumping around.  I'm <italic>sure</> a student of your calibre from <color=LIGHTPURPLE>Erran Valley</> can handle them without issue."
  +none()
  +walkToOffset(Lotte, 0, 48, true)
  +none()
  +setFacing(Lotte, leftdown)
  +waitMS(500)
  +despawnCharacter(Lotte)
  +panCameraBackToPlayer()
  +walkToMarker(Ada, MarkerAdaWalk2)
  +walkToCharacter(Conscience, Ada, 16, 16)
  +:lookAround(Ada)
  +lookAtEachOther(Ada, Conscience)
  Ada: "What is this place?"
  Conscience: "It's gotta be another <color=LIGHTBLUE>Instance</>, right?  Probably <color=LIGHTRED>Carl-Arnold's</> personal one."
  Conscience: "He is the <italic>king</> after all."
  Ada: "It is quite different than the last one though."
  Conscience: "Didn't they say their <color=LIGHTBLUE>Revirtualis</> can be made to represent <italic>anything</>?"
  Conscience: "It doesn't have to be that weird skyway thingy."
  +:worried(Ada)
  Ada: "Whatever it is, just make sure stick close to me."
  +endConversation()

#floor2_preThroneRoomExtra_terminal
  action,?once('c505c145'):this
  action,floor2_preThroneRoomExtra_terminal2
@this
  +setConversation(Ada)
  +:lockCamera()
  +:ld(Ada, rightup)
  +:bumpY(Ada, 1)
  +playSound(terminal_beep)
  +:smallPause()
  Narrator: "<cascade-letters>THANK YOU FOR USING THE BREAK ROOM.\nPLEASE PARTAKE IN ONE OF THE FREE MUFFINS."
  +none()
  +acquireItem(Muffin)
  +:unlockCamera()
  +endConversation()
@floor2_preThroneRoomExtra_terminal2
  +setConversation(Ada)
  +:lockCamera()
  +:ld(Ada, rightup)
  +:bumpY(Ada, 1)
  +playSound(terminal_beep)
  +:smallPause()
  Narrator: "<cascade-letters>THANK YOU FOR USING THE BREAK ROOM."
  Narrator: "<cascade-letters>THERE ARE NO MORE MUFFINS AVAILABLE.\nPLEASE TRY AGAIN AT A LATER TIME."
  +:unlockCamera()
  +endConversation()


#floor2PreThroneRoomRemoveLotte
  step-first,this
@this
  +?is(Lotte):{
    +despawnCharacter(Lotte)
  }

#floor2PreThroneRoom2_load
  load,this
@this
  +?once('7f8c1c51'):{
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
    +walkToMarker(Lotte, MarkerFrom3, 0, 0, true)
  }

#floor2_preThroneRoom2_lockedDoor
  action,this
@this
  +setConversation(Ada)
  Ada: "This door is locked."
  +endConversation()

#floor2_preThroneRoom2_infoPanel
  action,this
@this
  +setConversation(Ada)
  +:ld(Ada, leftup)
  +:lockCamera()
  +:bumpX(Ada, -1)
  +playSound(terminal_beep)
  +:w(1000)
  +playSound(terminal_cancel)
  +:w(200)
  Narrator: "<color=LIGHTGREY />The terminal says:\n</> Access to the <color=LIGHTPURPLE>Hall of Prizes</> is limited to admins only."
  +:unlockCamera()
  +endConversation()

#floor2_preThroneRoom2_trophyRoomOverflowMessy
  step,?once('a840b83c'):this
@this
  +setConversation(Ada)
  +:ld(Ada, leftup)
  +panCameraRelativeToPlayer(-50, -50, 1000, true)
  Ada: "A trophy room...?"
  +?func(inParty, Conscience):{
    +walkToCharacter(Conscience, Ada, -16, -16)
    +:ld(Conscience, leftup)
    Conscience: "It's kinda messy in here."
    Conscience: "Did he really win all these prizes?"
  }
  +panCameraBackToPlayer()
  +:ld(Ada, down)
  +:smirk(Ada)
  Ada: "One would think that the <color=LIGHTRED>Regem Ludos</> himself would have a more organized collection of accolades."
  +endConversation()

