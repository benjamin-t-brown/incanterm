#floor2PreThroneRoomBastionGate1_Load
  load,this
@this
  +?is(vars.BastionGate1Closed):{
    +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED_NO_ANIM)
    +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED_NO_ANIM, 16)
    +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED_NO_ANIM, -16)
  }

#floor2PreThroneRoom_BastionEntrance1_CloseGate
  step,?once('6faa55a7'):this
@this
  +setStorage(vars.BastionGate1Closed, true)
  +setConversation(Ada)
  +walkToCharacter(Ada, Ada)
  +panCameraRelativeToPlayer(25, -25, 300)
  +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED)
  +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED, 16)
  +changeTileAtMarker(MarkerGate, BASTION_GATE_CLOSED, -16)
  +playSound(sliding_door_close)
  +playSound(shing)
  +:w(100)
  +playSound(projector_close)
  +:w(100)
  +playSound(move_wall)
  +:w(100)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SMOKE_FAST, MarkerGate, normal, -12, 0)
  +playSound(battle_fireball_explosion2)
  +playSound(stone_bass)
  +walkToOffset(Party, 0, 32)
  +:ld(Ada, rightup)
  +panCameraBackToPlayer()
  Narrator: "Unauthorized intruder detected.  Lockdown engaged."
  +:leach(Ada, Conscience)
  +:worried(Ada)
  Ada: "That was uncomfortably close."
  Conscience: "Maybe we should have followed <color=LIGHTBLUE>Lotte</> after all."
  +endConversation()