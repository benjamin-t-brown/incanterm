  +setConversation(Ada)
  +fadeIn(300)
  +?once(floor2_preThroneRoom_transitionFrom5ToThroneRoom):{
    +:floor2-throne-room-lotte1()
  }

#floor2PreThroneRoom5ComputerEquipment
