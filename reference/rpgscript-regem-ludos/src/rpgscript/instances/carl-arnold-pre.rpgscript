#floor2PreThroneRoom1_Load
  load,this
@this
  +?is(tmp.floor2PreSpawnLotteAtEnd):{
    +spawnCharacterAtMarker(Lotte, MarkerLotteWalk5)
  }
  +?is(tmp.floor2Pre_SpawnLotteNextRoom):{
    +spawnCharacterAtMarker(Lotte, MarkerLotteSpawn)
    +:face(Lotte, down)
    +setStorage(tmp.floor2Pre_SpawnLotteNextRoom, false)
    +setStorage(tmp.floor2PreSpawnLotteAtEnd, true)
  }

#floor2_preThroneRoom1_OpenFancyDoorFWD
  step-first,floor2_preThroneRoom1_OpenFancyDoorFWD_Open
  step-off,floor2_preThroneRoom1_OpenFancyDoorFWD_Close
@floor2_preThroneRoom1_OpenFancyDoorFWD_Open
  +playSound(sliding_door_open)
  +:openDoubleDoorsFwd(MarkerFancyDoorFwd_1, FANCY_DOOR)
@floor2_preThroneRoom1_OpenFancyDoorFWD_Close
  +playSound(sliding_door_close)
  +:closeDoubleDoorsFwd(MarkerFancyDoorFwd_1, FANCY_DOOR)

#floor2_preThroneRoom1_OpenFancyDoorFWD2
  step-first,floor2_preThroneRoom1_OpenFancyDoorFWD2_Open
  step-off,floor2_preThroneRoom1_OpenFancyDoorFWD2_Close
@floor2_preThroneRoom1_OpenFancyDoorFWD2_Open
  +playSound(sliding_door_open)
  +:openDoubleDoorsFwd(MarkerFancyDoorFwd2_1, FANCY_DOOR)
@floor2_preThroneRoom1_OpenFancyDoorFWD2_Close
  +playSound(sliding_door_close)
  +:closeDoubleDoorsFwd(MarkerFancyDoorFwd2_1, FANCY_DOOR)

