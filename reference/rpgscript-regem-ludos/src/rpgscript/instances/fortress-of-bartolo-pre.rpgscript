  // }
  // +setWallCollisionEnabled(true)
  +:smirk(Bartolo)
  Bartolo: "<cascade-letters=33 italic>Hola."
  +:face(Ada, leftup)
  +:face(Anjana, leftup)
  +:face(Skye, up)
  +panCameraToFitCharacters(500, true, Bartolo, Ada)
  +none()
  // +?func(inParty, Anjana):{
  //   // +walkToOffset(Anjana, 16, 0)
  //   +:la(Anjana, Bartolo)
  //   +:jump(Anjana)
  //   Anjana: "You!  What are <italic>you</> doing here?"
