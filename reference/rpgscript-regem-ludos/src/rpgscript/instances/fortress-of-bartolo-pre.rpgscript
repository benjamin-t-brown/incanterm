// +stopSkipCutscene();
  // Bartolo: "<color=LIGHTRED>Carl-Arnold</> thought the normal instance might have been too easy, so on his behalf I made some modifications."
  +:ld(Bartolo, leftdown)
  Bartolo: "Behold: my newest creation!"
  +:none()
  +panCameraRelativeToCurrentPosition(-40, 0)
  +:w(500)
  +setAnimation(Bartolo, ch_bartolo_beep)
  +:w(1000)
  +playSound(click)
  +:w(500)
  +changeTileAtMarker(MarkerJail0, JAIL_OPENED_SLOW)
  +changeTileAtMarker(MarkerJail1, JAIL_OPENED_SLOW)
  +changeTileAtMarker(MarkerJail2, JAIL_OPENED_SLOW)
  +changeTileAtMarker(MarkerJail3, JAIL_OPENED_SLOW)
  +changeTileAtMarker(MarkerJail4, JAIL_OPENED_SLOW)
  +playSound(sliding_door_close)
  +playSound(shing)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(battle_fireball_explosion2)
  +playSound(stone_bass)
  +spawnCharacterAtMarker(RevirtualisBartoloGundam1, MarkerGundamSpawn)
  +playSound(spawn_enemy)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, RevirtualisBartoloGundam1, normal)
  +:w(500)
  +playSound(robot_staggered_damaged)
  +:w(200)
  +setAnimationState(Bartolo, idle)
  +:la(Bartolo, Ada)
  Bartolo: "It's work in progress, but I need somebody to give it a test run."
  +:la(Bartolo, Ada)
  +:jump(Bartolo)
  Bartolo: "Try to give me some valuable data."
  +:shakeZ(Ada)
  // Ada: "I suppose we have to fight now, right?"
  Ada: "<cascade-letters scale=0.75 color=LIGHTGREY>Let us get this over with."
  +none()
  +stopSkipCutscene()
  +stopMusic(100, true)
  +:w(100)
  +endConversation(500, true)
  +despawnCharacter(RevirtualisBartoloGundam1)
  +enterCombat(REVIRTUALIS_BARTOLO_BOSS_ENTRANCE)

@RevirtualisBartolo_spawnFrontGate
  +none()
  +:face(Ada, leftup)
  +?func(inParty, Anjana):{
    +:face(Anjana, leftup)
  }
  +?func(inParty, Skye):{
    +:face(Skye, leftup)
  }
  +:w(1000)
  +playSound(despawn)
  +setStorage(vars.tmp.particleName, EFFECT_TEMPLATE_BOMB_EXPL)
  +setStorage(vars.tmp.particlePause, 150)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SMOKE, MarkerWall1, rise, -16, -74)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -16)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -16)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -32)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -32)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -48)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -48)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -64)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -64)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -80)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -80)
  +spawnParticleAtMarker({vars.tmp.particleName}, MarkerWall1, normal, 0, -96)
  +:w({vars.tmp.particlePause})
  +playSound(despawn_tut_wall)
  +changeTileAtMarker(MarkerWall1, TUT_GATE, 0, -96)

@RevirtualisBartolo_Battle1Completed
  +?func(inParty, Skye):{
    +setCharacterAtCharacter(Skye, Ada, 0, 16)
    +:face(Skye, rightdown)
  }
  +offsetCharacter(Ada, -8, 0)
  +setConversation(Ada)
  +playMusic(music_c_ambience)
  +walkToOffset(Bartolo, -8, 0)
  +panCameraToFitCharacters(1000, false, Bartolo, Ada)
  +:leach(Bartolo, Ada)
  +?func(inParty, Anjana):{
    +:la(Anjana, Bartolo)
  }
  +?func(inParty, Skye):{
    +:la(Skye, Bartolo)
    Skye: "He talked a big game for such an easy fight."
  }
  +:jump(Bartolo)
  Bartolo: "Well! That test gave <italic>unexpected</> results."
  +walkToOffset(Bartolo, -16, 0)
  Bartolo: "I may need a little more time to fine tune..."
  +:ld(Bartolo, leftdown)
  Bartolo: "That means a further change of plans."
  Bartolo: "I'll have to leave you here for now.  Try not to break anything further."
  +:ld(Bartolo, down)
  +none()
  +:w(500)
  +setAnimation(Bartolo, ch_bartolo_beep)
  +:w(1000)
  +playSound(click)
  +:w(500)
  +panCameraRelativeToCurrentPosition(-40, 0, 200)
  +changeTileAtMarker(MarkerJail0, JAIL_CLOSED_SLOW)
  +changeTileAtMarker(MarkerJail1, JAIL_CLOSED_SLOW)
  +changeTileAtMarker(MarkerJail2, JAIL_CLOSED_SLOW)
  +changeTileAtMarker(MarkerJail3, JAIL_CLOSED_SLOW)
  +changeTileAtMarker(MarkerJail4, JAIL_CLOSED_SLOW)
  +playSound(sliding_door_close)
  +playSound(shing)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(move_wall)
  +:w(200)
  +playSound(battle_fireball_explosion2)
  +playSound(stone_bass)
  +panCameraToFitCharacters(500, false, Ada, Bartolo)
  // +
  // +walkToOffset(Ada, 8, 0)
  +:exclaim(Ada)
  Ada: "Oh no.  No no, you have to let us out of here!"
  +:none()
  +walkToMarker(Bartolo, MarkerBartoloWalk1)
  +playSound(sliding_door_open)
  +:openDoor(MarkerRedDoor1, RED_DOOR_FWDL)
  +:openDoor(MarkerRedDoor2, RED_DOOR_FWDR)
  +:w(100)
  +walkToMarker(Bartolo, MarkerBartoloSpawn)
  +despawnCharacter(Bartolo)
  +playSound(sliding_door_close)
  +:closeDoor(MarkerRedDoor1, RED_DOOR_FWDL)
  +:closeDoor(MarkerRedDoor2, RED_DOOR_FWDR)
  +:w(100)
  +panCameraBackToPlayer()
  +:jump(Ada)
  Ada: "So that is it then?  We are stuck?"
  +walkToMarker(Skye, MarkerSkyeWalk1)
  +:face(Skye, leftup)
  +:bumpX(Skye, -2)
  +playSound(thunk)
  +:w(500)
  +:ld(Skye, right)
  Skye: "Looks like it."
  +none()
  +stopMusic(1000)
  +fadeOut(2000)
  +changeRoom(floor2ThroneRoomAlt)
