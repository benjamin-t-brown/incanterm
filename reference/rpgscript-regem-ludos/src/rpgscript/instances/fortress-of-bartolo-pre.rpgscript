@RevirtualisBartolo_bartoloAppears
  +setConversation()
  +panCameraToMarker(MarkerBartoloWalk2)

  +playSound(sliding_door_open)
  +:openDoor(MarkerRedDoor1, RED_DOOR_FWDL)
  +:openDoor(MarkerRedDoor2, RED_DOOR_FWDR)
  +:w(100)
  +playMusic(music_mischief)
  // +setWallCollisionEnabled(false)
  +spawnCharacterAtMarker(Bartolo, MarkerBartoloSpawn)
  +:w(1000)
  +walkToMarker(Bartolo, MarkerBartoloWalk1)
  +walkToMarker(Bartolo, MarkerBartoloWalk2)


  // +offsetCharacter(Bartolo, 500, 500)
