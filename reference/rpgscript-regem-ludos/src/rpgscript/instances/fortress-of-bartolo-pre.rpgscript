#RevirtualisBartolo_test
  action,RevirtualisBartoloFirstFight
  load,this
@this
  +?once('01b2060c'):{
    +:RevirtualisBartoloFirstFight()
  }

@RevirtualisBartoloFirstFight
  +setConversation(Ada)
  +fadeOut(1)
  +panCameraBackToPlayer(1)

  +:w(500)
  +playSound('vr_portal_landed')
  +:w(200)
  +playSound('spawn_enemy')
  +setAtMarker(Party, MarkerPortal)
  +:face(Ada, down)
  +walkPartyToFormation()
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  +setPlayerVisibility(true)
  +fadeIn(500)
//wait for the spawn particles to finish
  +waitMS(300)
  +setAnimationState('Ada', 'idle')
  +enableAnimationSounds()

  +:w(1000)
  +:lookAround(Ada)
  Ada: "This is... different."
  +:ld(Ada, leftup)
  +:ld(Anjana, leftup)
  +:ld(Skye, up)
  +none()
  // +panCameraRelativeToPlayer(-100, -50, 2000, true)
  // +:w(500)
  +?func(inParty, Anjana):{
    +walkToOffset(Anjana, -24, 0)
    Anjana: "Something isn't right."
    +none()
    +:ld(Anjana, left)
    +panCameraRelativeToCurrentPosition(-70, -15)
    Anjana: "Are we locked in here?"
  }
  +none()
  +walkToOffset(Ada, -62, 0, true)
  +walkToOffset(Anjana, -42, -12, true)
  +walkToMarker(Skye, MarkerSkyeWalk1)
  +:ld(Ada, left)
  +:ld(Anjana, left)
  +:ld(Skye, leftup)
  +none()
  +:bumpX(Skye, -2)
  +playSound(thunk)
  +:angry(Skye)
  Skye: "Hey! Anybody out there?"
  +none()
  +:bumpX(Skye, -2)
  +playSound(thunk)
  Skye: "We could really use some <shake>HELP</> here!"
  +none()
  +:w(1000)
  +:la(Skye, Ada)
  +:sad(Skye)
  Skye: "I don't see anybody coming."
  +none()
  // +panCameraBackToPlayer()
  +walkToMarker(Anjana, MarkerPortal)
  +:ld(Anjana, down)
  +:jump(Anjana)
  +:smallPause()
  +:serious(Anjana)
  Anjana: "The portal is deactivated..."
  +:la(Ada, Anjana)
  +:flat(Ada)
  Ada: "<cascade-letters=100>Great."
  +walkToOffset(Anjana, -62, -12, true)
  +:ld(Anjana, down)
  Anjana: "Damn it! That employee must have done something to put us here."
  +:la(Anjana, Ada)
  Anjana: "There has to be some way out.  It's not as if they can keep us here forever."
  Anjana: "We can figure this out."
  // +:la(Ada, Anjana)
  +:ld(Ada, down)
  Ada: "Can something please just go right today!  For once?"
  +:none()
  +walkToOffset(Skye, 38, 0, true)
  +stopMusic()
  +:w(500)
  +:RevirtualisBartolo_bartoloAppears()

