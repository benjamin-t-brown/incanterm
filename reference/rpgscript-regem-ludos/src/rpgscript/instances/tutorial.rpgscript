  Bartolo: "Patronizing <italic>pendejo</>."
  +none()
  +fadeOut(2000)
  +setPlayerVisibility(true)
  +:floor1-tut-postBartoloLair()

@floor1-tut-postBartoloLair
  +stopSkipCutscene()
  +fadeOut(100)
  +changeRoom(floor1TutVRPreBoss, MarkerAdaPostBoss)
  +disableAnimationSounds()
  +panCameraBackToPlayer(100)
  +setFacing(Ada, leftup)
  +walkToOffset(Conscience, 0, 16)
  +fadeIn(1000)
  +setFacing(Ada, leftup)
  +:jump(Ada)
  +:ld(Conscience, leftup)
  +walkToOffset(Ada, -16, 0)
  Ada: "The portal is right there!"
  +:happy(Conscience)
  Conscience: "Yes!  Let's go."
  +panCameraBackToPlayer()
  +endConversation()

#floor1-tut-checkTerminalConscienceMessedWith
  action,this
@this
  +setConversation(Ada)
  Ada: "It looks exactly like all the other terminals in this VR."
  +endConversation()

#floor1-tut-refuseToGoBackToBoss
  step-first,this
@this
  +setConversation(Ada)
  +:jump(Ada)
  +walkToOffset(Ada, -16, 0)
  +setFacing(Ada, leftup)
  +:angry(Ada)
  Ada: "I refuse to go back there.  I am using the exit portal NOW."
  +endConversation()

#floor1-tut-VR-exit-portal
  step-first,this
  action,floor1-tut-VR-exit-portal-action
@this
  +callScript('utils-vr-step')
@floor1-tut-VR-exit-portal-action
  +walkPartyToFormation()
  +stopMusic(1000, true)
  +:utils-transition-to-instance-fade-out()
  +:utils-transition-to-instance-fade-in(floor1TutExit, MarkerVRLanding, true)
  // +callScript('utils-transition-to-vr', 'floor1TutExit', 'MarkerVRLanding', false)
  +endConversation(100)
  +setConversation(Ada)
  +:lookAround(Ada)
  +:exhale(Ada)
  Ada: "Finally."
  +modifyPartyRESV(99999)
  +modifyPartyHP(99999)
  +none()
  +completeQuestStep(Tutorial, 3)
  // +walkToOffset(Ada, -48, 0)
  +endConversation()

@quest_tutorial_complete

#floor1-transitionToEast1FromTutExit
  step,this
@this
  +:utils-change-room(floor1East1, MarkerFromVRPortal)
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerExit1)
  +:floor1-OpenRedDoorsFWDOpen2()
  +walkToMarker(Ada, MarkerExit2)
  +:floor1-OpenRedDoorsFWDClose2()
  +setFacing('Ada', up)
  +waitMS(250)
  +spawnCharacterAtCharacter('Conscience', 'Ada')
  +?isnot([ARG0]):{
    +walkToOffset('Conscience', -16, -16)
  }
  +lookAtEachOther('Ada', 'Conscience')
  +:exhale(Ada)
  Ada: "Finally we are out of that place."
  Conscience: "So, you've got the <color=LIGHTBLUE>Haptic Bracer</> now right?   Should we go to the second floor?"
  Ada: "<cascade-letters>Yes..."
  +:ld(Ada, leftup)
  Ada: "I really do hope that was the end of today's... <italic>chicanery</>."
  +setFacing(Conscience, leftdown)
  +:teardrop(Conscience)
  Conscience: "<scale=0.75 cascade>I kinda have a feeling it isn't."
  +:utils-stop-Conscience-dialogue()
  +endConversation()

@test-tut-battle
  +enterCombat(ENCOUNTER_TUT_BOSS)

#tut_brokenKiosk
  action,this
@this
  +setConversation(Ada)
  Ada: "I think this is broken."
  +endConversation()