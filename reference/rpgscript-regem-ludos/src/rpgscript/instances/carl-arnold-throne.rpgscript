@carlArnoldLaugh
  +none()
  +setAnimation(Carnold, ch_carl-arnold_laugh)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(150)
  +playSound(boy_laugh)
  +waitMS(200)
  +playSound(boy_laugh)
  +waitMS(350)
  +setAnimationState(Carnold, idle)

#floor2ThroneRoom-beginSequence
// step-first,?once('5d175550'):this
@this
  +?isnot(Lotte):{
    +spawnCharacterAtMarker(Lotte, MarkerLotte)
  }
  +:ld(Lotte, down)
  +:ld(Bartolo, down)
  +setAnimation(Carnold, ch_carl-arnold_hands_behind_back_up)
// +playSound(lightswitch_echo);
// +removeOverlays(750, true);
  +spawnCharacterAtCharacter('Conscience', 'Ada')
  +setConversation()
  +walkToMarker(Ada, MarkerAda0, 0, 0, true)
  +walkToMarker(Conscience, MarkerConscience0, 0, 0)
  +:ld(Conscience, up)
  +:ld(Ada, up)
  +waitMS(200)
  +:throneRoomCutscenePart1()

@throneRoomCutscenePart1
  +setConversation(Ada)




// START BLOCK
  +setWallCollisionEnabled(false)
  +panCameraToFitCharacters(1500, false, Lotte, Bartolo, Carnold)
  +:ld(Conscience, up)
  +:ld(Ada, up)
  +panCameraRelativeToCurrentPosition(0, -20, 1000)
  +:shakeZ(Carnold)
  Carnold: "Hello there, <color=ORANGE cascade-letters>Adalais<cascade>."
  Carnold: "I've been expecting you."
  +:ld(Ada, up)
  +none()
  +panCameraRelativeToCurrentPosition(0, 20, 500)
  +:ld(Ada, up)
  +:flat(Ada)
  +:ld(Conscience, up)
  Ada: "I certainly hope so."
  Ada: "What <italic>exactly</> is it that you want?"
  +none()
  +panCameraRelativeToCurrentPosition(0, -20, 500)
  +:shakeZ(Carnold)
  Carnold: "<scale=0.75 />What do I want...?"
  +none()
  +waitMS(1000)
  +setAnimationState(Carnold, idle)
  +:face(Carnold, up)
  +waitMS(100)
  +:face(Carnold, rightup)
  +waitMS(100)
  +:face(Carnold, right)
  +waitMS(100)
  +:face(Carnold, rightdown)
  +waitMS(100)
  +:face(Carnold, rightdown)
  +waitMS(100)
  +setAnimation(Carnold, ch_carl-arnold_hands_behind_back_down)
  // +stopSkipCutscene()
  +:shakeZExtended(Carnold)
  Carnold: "I desire so much.  And yet, also, so little."
  +none()
  +stopMusic(1000, true)
  +:smallPause()
  +playSound(terminal_beep)
  +waitMS(100)
  +applyZTransform(Carnold, -96, 1500, true, true)
  +playSound(sliding_door_open)
  +waitMS(50)
  +playSound(robot_clank4)
  +waitMS(50)
  +playSound(robot_clank2)
  +waitMS(900)
  +playSound(robot_clank3)
  +waitMS(50)
  +playSound(robot_clank4)
  +waitMS(50)
  +playSound(robot_clank2)
  +waitMS(400)
  +playSound(robot_clank)
  +waitMS(500)
  +setAtMarker(Carnold, MarkerCarnoldGround)
  +walkToMarker(Carnold, MarkerCarnoldWalk0)
  +panCameraRelativeToCurrentPosition(0, 60, 500)
  +waitMS(500)
  +playMusic(music_carl_arnold_theme)
  Carnold: "So..."
  Carnold: "<color=ORANGE cascade-letters>Adalais Eldridge</>."
  Carnold: "Only daughter of acclaimed <color=LIGHTBLUE>Revirtualis</> scientist <color=ORANGE>Dr. Dalton Eldridge</>..."
  Carnold: "The widely-labeled <italic>smartest</> girl in all of <color=LIGHTPURPLE>Erran Valley High School</>..."
  Carnold: "And my notorious classmate."
  +:la(Carnold, Ada)
  Carnold: "You have entered <italic>my domain</>."
  Ada: "<cascade-letters>......"
  Carnold: "You are standing in an <color=LIGHTBLUE>instance of the Regem Ludos Revirtualis</>.  A little section of the full world inside of the <color=LIGHTPURPLE>Regem Ludos Arcade</>."
  Carnold: "But this particular place is quite special."
  +:smirk(Carnold)
  Carnold: "I created it."
  Carnold: "Having achieved a large number of high scores in the games at this arcade, I have been alloted a certain status."
  Carnold: "I am <color=LIGHTRED>The King of Games</>."
  Carnold: "You see, when you have acquired this status, the <color=LIGHTPURPLE>Regem Ludos Arcade</> gives you a space in the <color=LIGHTBLUE>Revirtualis</>."
  Carnold: "In this space I'm allowed to do <italic>almost</> whatever I desire."
  Carnold: "Allow me to demonstrate."
  +walkToMarker(Carnold, MarkerCarnoldWalk2)
  +:ld(Carnold, down)
  Carnold: "It appears we are adrift in the void of space. And yet--"
  +none()
  +:minorPause()
  +setAnimation(Carnold, ch_carl-arnold_snap_right)
  +waitMS(100)
  +playSound(snap)
  +waitMS(100)
  +changePropAnim(PropTree, tree1_anim, 0, 0)
  +createPropAtMarker(PropTree, MarkerTree, tree1, 0, 0)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerTree, 'normal', 0, 0)
  +waitMS(500)
  +:ld(Carnold, right)
  Carnold: "Lo!  A tree hath appeared!"
  +setAnimationState(Carnold, idle)
  Carnold: "I've prepared this little patch of grass just for the occasion.  A little bit of life in the desolate landscape of space."
  Carnold: "The stark juxtaposition has always intrigued me."
  +:la(Carnold, Ada)
  +:ld(Ada, up)
  +:flat(Ada)
  Ada: "You dragged me in here to show me <italic>that?"
  +:la(Ada, Carnold)
  Ada: "You are such an insufferable show off."
  Ada: "May I leave now, or do you have more boasting to be about?"
// Ada: "You made a tree in virtual space.  How <italic>very impressive</>."
