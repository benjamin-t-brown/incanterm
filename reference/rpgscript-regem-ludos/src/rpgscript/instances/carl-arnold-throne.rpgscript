@throneRoomCutscenePart2
  +walkToMarker(Carnold, MarkerCarnoldWalk2)
  +lookAtCharacter(Ada, Carnold)
  +lookAtCharacter(Conscience, Carnold)
  +panCameraToFitCharacters(500, false, Carnold, Ada, Conscience)
  +:none()
  Carnold: "But, no, that's not why I asked you to come here."

// START BLOCK
  +setUnskippable(false)
  +stopMusic()
  +panCameraToFitCharacters(500, false, Carnold)
  +:w(500)
  +setAnimation(Carnold, ch_carl-arnold_raise_arms)
  +playSound(battle_cast)
  +waitMS(800)
  +playSound(battle_robot_charge_up, 8, 320)
  +waitMS(100)
  +:w(200)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_HAND_FLAME, Carnold, normal, -8, 2)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_HAND_FLAME, Carnold, normal, 12, 2)
  +waitMS(2400)
  +playSound(zap_medium)
  +waitMS(100)
  +setAnimation(Carnold, ch_carl-arnold_raise_arms_open_eyes)
  +waitMS(500)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_FLASH, MarkerConscience0, normal, 0, 0)
  +playSound(failure)
  +waitMS(100)
  +playSound(despawn_tut_wall)
  +createPropAtMarker(PropCageTop, MarkerConscience0, 'dynamic-props/cage_0', 99, 24, 24)
  +createPropAtMarker(PropCageFront, MarkerConscience0, 'dynamic-props/cage_1', 0, 24, 24)
  +createPropAtMarker(PropCageBack, MarkerConscience0, 'dynamic-props/cage_2', -20, 24, 24)
  +panCameraToFitCharacters(500, false, Conscience)
  +:exclaim(Ada)
  +:ld(Ada, left)
  +:exclaim(Conscience)
  +:ld(Conscience, right)
  +waitMS(500)
  +:ld(Conscience, rightdown)
  +waitMS(100)
  +:ld(Conscience, down)
  Conscience: "What is this...?"
  +none()
  +waitMS(100)
  +:ld(Conscience, leftdown)
  +waitMS(100)
  +:jump(Conscience)
  +:ld(Conscience, right)
  +walkToOffset(Ada, -24, 12)
  +:ld(Ada, leftdown)
  +:shakeZ(Ada)
  +panCameraToFitCharacters(500, false, Ada)
  +:exclaim(Ada)
  Ada: "<cascade-letters=33 color=YELLOW>Conscience!"
  +none()
  +panCameraToFitCharacters(500, false, Carnold)
  +walkToOffset(Ada, 32, -16)
  +lookAtCharacter(Ada, Carnold)
  +:ld(Conscience, down)
  +waitMS(1000)
  +:ld(Conscience, rightdown)
  +setAnimation(Carnold, ch_carl-arnold_lower_arms)
  +waitMS(250)
  +:ld(Conscience, rightup)
  +:bumpY(Conscience, 2)
  +waitMS(250)
  +lookAtCharacter(Conscience, Carnold)
  +stopSkipCutscene()
  +:shakeZ(Carnold)
  Carnold: "Lovely."
  // +none()
  // +:w(500)
  Carnold: "That takes care of one of you."
  +setAnimation(Carnold, ch_carl-arnold_gesture_right)
  // +:smallPause()
  Carnold: "As for the other."
  +stopMusic(1000)
  +none()
  +waitMS(500)
  +panCameraRelativeToCurrentPosition(25, 0, 500)
  +setAnimation(Carnold, ch_carl-arnold_snap_right)
  +playSound(snap)
  +:w(250)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerTree, 'normal', -8, -8)
  +removeProp(PropTree)
  +:w(1000)
  +setAnimation(Carnold, ch_carl-arnold_snap_right)
  +none()
  +playSound(snap)
  +:w(200)
  +createPropAtMarker(PropArckenstone, MarkerTree2, control_24, 99, -8, 8)
  +changePropAnim(PropArckenstone, arckenstone_spawn_anim)
  +playSound(projector_close)
  +:w(200)
  +playSound(projector_rise)
  +:w(100)
  +playSound(projector_rise)
  +:w(100)
  +playSound(projector_rise)
  +:w(100)
  +playSound(projector_rise)
  +:w(100)
  +playSound(projector_rise)
  +:ld(Ada, leftup)
  +waitMS(1000)
  Ada: "What... is that thing?"
  +none()
  +setAnimationState(Carnold, idle)
  +:w(200)
  +changePropAnim(PropArckenstone, arckenstone_active)
  +playSound(conscience_appear)
  +:w(50)
  +playSound(conscience_appear)
  +:w(50)
  +playSound(arckenstone_active)
  +panCameraBackToPlayer(300)
  +:ld(Ada, down)
  +:la(Conscience, Ada)
  +playSound(wobble)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_MISS, Ada, normal, 0, 0)
  +:exclaim(Ada)
  Ada: "Hey!"
  +none()
  +setAnimation(ada, ada_suspended)
