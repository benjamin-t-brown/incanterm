// Carnold: "You really don't know what I'm getting at, do you?"
// Carnold: "Right then.  I'll spell it out for you."
// Carnold: "<cascade-letters>You are a fraud."
// Carnold: "Everything you have ever done has been given to you by somebody else."
// +:smallPause();
// +:smallPause();
// Ada: "<cascade-letters>........"
  // +stopSkipCutscene()
  +:smirk(Carnold)
  Carnold: "Of course you'd never acknowledge my accomplishments."
  +setWallCollisionEnabled(true)
  +:throneRoomCutscenePart2()






