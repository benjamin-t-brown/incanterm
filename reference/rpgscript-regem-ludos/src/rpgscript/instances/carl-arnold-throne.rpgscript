@floor2throneroom
  +stopMusic(500)
  +:ld(Carnold, down)
  +offsetCharacter(Carnold, 0, 0, 96)
// +:floor2ThroneRoom-beginSequence();

@floor2-throne-room-lotte1
  +spawnCharacterAtCharacter(Lotte, Ada, 16, -16)
  +:ld(Lotte, up)
  +waitMS(250)
  +playMusic(music_c_ambience)
  +setConversation(Ada)
  Ada: "What is this place?"
  +none()
  +walkToMarker(Lotte, MarkerLotteWalk0)
  +:ld(Lotte, down)
  +:shakeZ(Lotte)
  Lotte: "This way, please."
  +none()
  +:ld(Lotte, up)
  +:shakeZ(Lotte)
  +walkToMarker(Lotte, MarkerLotteWalk1)
  +walkToMarker(Lotte, MarkerLotte, 0, 0, true)
  +endConversation()

#floor2ThroneRoom_ForceField
  action,this
@this
  +:ld(Ada, down)
  +setConversation(Ada)
  Ada: "It looks like some kind of force-field."
  +endConversation()


