@Floor2InstVr1_North2Boss
// +setConversation(Ada);
  Ada: "Is that the item we are supposed to retrieve?"
  +?func(inParty, Anjana):{
    Anjana: "This seems... too simple."
  }
  +?func(inParty, Skye):{
    +:la(Skye, Ada)
    Skye: "Aww we don't need to fight anything else?"
  }
  +none()
  +panCameraRelativeToCurrentPosition(-20, -20)
  +:w(1000)
  +playSound(deep_siren)
  +:w(500)
  +playSound(deep_siren)
  +:w(750)
  +playSound(deep_roar)
  +:w(100)
  +lookAtMarker(Party, MarkerBossSpawn)
  +:jump(Party, true)
  +:w(1000)
  +playSound('spawn_enemy')
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 0, 0)
  +waitMS(100)
  +playSound('spawn_enemy')
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 7, 0)
  +waitMS(100)
  +playSound('spawn_enemy')
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 13, 11)
  +waitMS(100)
  +playSound('spawn_enemy')
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 6, 17)
  +waitMS(100)
  +playSound('spawn_enemy')
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 11, 3)
  +waitMS(300)
  +playMusic(music_pre_tense_battle)
  +playSound(robot_staggered_damaged)
  +spawnCharacterAtMarker(Floor2InstanceVRBossNorth, MarkerBossSpawn)
  +none()
  +:w(1000)
  +?func(inParty, Skye):{
    +:confident(Skye)
    Skye: "Now <italic>that's</> more like it."
  }
// +stopMusic(500, true);
  +endConversation(500, true)
  +despawnCharacter(Floor2InstanceVRBossNorth)
  +enterCombat(INSTANCE1_BOSS1)

@Floor2InstVr1_North2BossWin
  +setConversation(Ada)
  +:w(500)
  +?func(inParty, Anjana):{
    +:la(Anjana, Ada)
    +:exhale(Anjana)
    Anjana: "Battles like that always make me weary."
  }
  +:ld(Party, down)
  +setStorage(vars.Floor2InstVr1_NorthBossDefeated, true)
  +?is(vars.Floor2InstVr1_SouthBossDefeated):{
    +completeQuestStep(FLOOR2_INSTANCE1, 0)
  }
  Ada: "Look!"
  +none()
  +panCameraRelativeToPlayer(0, 75)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerTerminal, normal)
  +changeTileAtMarker(MarkerTerminal, TERMINAL_TUT_RIGHT_DOWN)
  +playSound(spawn_enemy)
  +:w(100)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerTerminal3, normal)
  +changeTileAtMarker(MarkerTerminal3, FLOOR_TUT_MOVE_PLATFORM)
  +playSound(spawn_enemy)
  +:w(100)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerTerminal4, normal)
  +changeTileAtMarker(MarkerTerminal4, FLOOR_TUT_MOVE_PLATFORM)
  +playSound(spawn_enemy)
  +:w(100)
  Ada: "What is that?"
  +panCameraBackToPlayer()
  +endConversation()

#Floor2InstVr1_TeleportBackFromNorth
// action,?all(func(carryingProp, PropDisk), is(vars.Floor2InstVr1_NorthBossDefeated)):Floor2InstVr1_TeleportBackFromNorth3
  action,?is(vars.Floor2InstVr1_NorthBossDefeated):Floor2InstVr1_TeleportBackFromNorth2
  action,Floor2InstVr1_TeleportBackFromNorth1
@Floor2InstVr1_TeleportBackFromNorth1
  +setConversation(Ada)
  Ada: "This is a rather strange-looking structure."
  +?all(func(inParty, Anjana), once('d94c72d0')):{
    +:bored(Anjana)
    Anjana: "If you hadn't noticed, most places in a <color=LIGHTBLUE>Revirtualis</> are strange."
  }
  +endConversation()
@Floor2InstVr1_TeleportBackFromNorth2
  +setConversation(Ada)
  +:ld(Ada, leftup)
  +:lockCamera()
  +:bumpX(Ada, -1)
  +playSound(terminal_beep)
  +:unlockCamera()
  +:w(500)
  +playSound(phone_beep)
  +:w(500)
  +?once('7985fc6b'):{
    Narrator: "Congratulations on beating the boss of this area."
  }
  Narrator: "If you would like, you may use this terminal to teleport back to the starting room."
  +awaitChoice('Yes, teleport back.', 'No, stay here.')
  +?eq(lastChoiceIndex, 0):{
    Narrator: "Teleportation commencing."
    +none()
    +:w(500)
    +playSound(spawn_enemy)
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, normal)
    +fadeOut(500)
    +playSound('change_room')
    +waitMS(400)
    +changeRoom(floor2InstVr1, MarkerFromNorth)
    +walkPartyToFormation()
    +:ld(Ada, leftdown)
    +fadeIn(250, true)
    +:w(100)
    +playSound('vr_portal_landed')
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_PORTAL_SPAWN, Party, 'normal')
    +:w(150)
  }
  +?eq(lastChoiceIndex, 1):{
    Narrator: "You may continue to explore at your leisure."
  }
  +endConversation()
// Don't think this restriction is necessary anymore
