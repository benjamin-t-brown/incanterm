  Ada: "I think this disk needs to be taken north."
  +none()
  +walkToOffset(Ada, 0, -16)
  +endConversation()

#transitionFromFloor2InstEntranceToVr1
  step-first,this
  action,transitionFromFloor2InstEntranceToVr1-action
@this
  +callScript('utils-vr-step')
@transitionFromFloor2InstEntranceToVr1-action
  +setUnskippable(true)
  +dropHeldProps()
  +setConversation(Ada)
  +:utils-transition-to-vr-fade-out()
  +setConversationWithoutBars(Ada)
  +waitMS(100)
  +:utils-transition-to-vr-fade-in(floor2InstVr1, MarkerVRLanding, true)
  +endConversation()

#transitionFromFloor2ToVr1ToInstEntrance
