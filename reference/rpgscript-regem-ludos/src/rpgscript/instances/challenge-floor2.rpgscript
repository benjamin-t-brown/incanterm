#Floor2InstVr1SignNorth
  action,this
@this
  +setConversation(ada)
  +:ld(Ada, up)
  +walkPartyToFormation()
  Narrator: "The <color=LIGHTPURPLE>Pillars of Power</> to the north can be charged by transporting a <color=LIGHTBLUE>Disk of Power</> to its rightful resting spot."
  +endConversation()

@Floor2Inst1DiskBroke
  +?once('aee20ef6'):{
    +setStorage(vars.Floor2Inst1DiskBrokeCtr, 0)
  }
  +?eq(vars.Floor2Inst1DiskBrokeCtr, 0):{
    +log("This is in the script")
  }
  +?func(carryingProp, PropDisk):{
    +changePropAnim(PropDisk, invisible)
    +setConversation(ada)
    +?eq(vars.Floor2Inst1DiskBrokeCtr, 2):{
      +:ld(Ada, down)
      Ada: "The disk is gone again..."
    }
    +?eq(vars.Floor2Inst1DiskBrokeCtr, 1):{
      +:ld(Ada, down)
      +:exclaim(Ada)
      Ada: "The disk vanished again!"
      +setStorage(vars.Floor2Inst1DiskBrokeCtr, 2)
    }
    +?eq(vars.Floor2Inst1DiskBrokeCtr, 0):{
      +:ld(Ada, down)
      +:exclaim(Ada)
      Ada: "The disk vanished after we got attacked!"
      +?func(inParty, Skye):{
        +:la(Skye, Ada)
        Skye: "The terminal said it was fragile."
      }
      +?func(inParty, Anjana):{
        +:la(Anjana, Ada)
        Anjana: "So what? We have to go get another one now?"
        Anjana: "What a stupid mechanic..."
      }
      +setStorage(vars.Floor2Inst1DiskBrokeCtr, 1)
    }

  // Stupid quirk of rpgscript: This conditional gets HOISTED so it cannot happen first.
  // If you put it first, the func(carryingProp, PropDisk) condition resolves to false
  // for each subsequent check and this block essentially "breaks"
    +removeProp(PropDisk)
  }
  +endConversation()

#Floor2InstVr1NorthDiskDispenser
  action,this
@this
  +setUnskippable(true)
  +setConversation(ada)
  +:ld(Ada, leftup)
  +walkPartyToFormation()
  +panCameraRelativeToPlayer(0, 0, 1)
  +:bumpX(Ada, -1)
  +playSound(terminal_beep)
  +:w(100)
  +playSound(monitor_talk)
  +:w(500)
  Narrator: "This terminal can create a <color=LIGHTBLUE>Disk of Power</>.  Would you like to create one? <color=LIGHTGREY>(Limit one per party.)</>"
  +awaitChoice('Yes.', 'No.')
  +?eq(lastChoiceIndex, 0):{
    +none()
    +?func(roomHasProp, PropDisk):{
      +removeProp(PropDisk)
    }
    +createPropAtMarker(PropDisk, MarkerDiskSpawn, props_small_131, 16, 8, 8)
    +playSound(spawn_enemy)
    +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerDiskSpawn, 'normal', 8, 8)
    +?once('341bfcf5'):{
      +:w(1500)
      Narrator: "Take care.  The disk is fragile."
    }
  }
  +?eq(lastChoiceIndex, 1):{
    +none()
  }
  +panCameraBackToPlayer(1)
  +endConversation()

@Floor2InstVr1_DiskDeposit_hint
  +setConversation(Ada)
  Ada: "It looks like some sort of disk can be placed here."
  +endConversation()

@Floor2InstVr1_DiskDeposit_placed
  +setConversation(Ada)
  Ada: "I already placed a disk here."
  +endConversation()

// [ARG0] itemName
// [ARG1] storageName
// [ARG2] markerNameToSpawn
// [ARG3] markerNameOfPlacedDisk
// [ARG4] camX
// [ARG5] camY
// [ARG6] SKIP PAN
@Floor2InstVr1_SpawnItemFromDisk
  +setStorage([ARG1])
  +setConversation(Ada)
  +walkToMarker(Ada, [ARG3], 0, -16)
  +:ld(Ada, leftdown)
  +walkPartyToFormation()
  +dropHeldProps([ARG3])
  +changeTileAtMarker([ARG3], DISK_INSERTED)
  +playSound(robot_clank)
  +:w(200)
  +playSound(vr_portal_buzz)
  +:w(500)
  +panCameraRelativeToPlayer([ARG4], [ARG5])
  +:w(100)
  +playSound(robot_clank4)
  +lookAtMarker(party, [ARG2])
  +:w(100)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, [ARG2], 'normal', 0, 0)
  +createPropAtMarker([ARG0], [ARG2], '')
  +:w(500)
  Ada: "It worked!"
  +?isnot([ARG6]):{
    +panCameraBackToPlayer(500)
    +endConversation()
  }

