  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossSpawn, 'normal', 11, 3)
  +waitMS(300)
  +playMusic(music_pre_tense_battle)
  +spawnCharacterAtMarker(Floor2InstanceVRBossSouth, MarkerBossSpawn)
  +none()
  +:w(1000)
  +?func(inParty, Anjana):{
    Anjana: "Seems like we need to fight."
  }
// +stopMusic(500, true);
  +endConversation(500, true)
  +despawnCharacter(Floor2InstanceVRBossSouth)
  +enterCombat(INSTANCE1_BOSS2)

@Floor2InstVr1_SouthBossWin
  +setStorage(vars.Floor2InstVr1_SouthBossDefeated)
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerBossDefeated)
  +walkPartyToFormation()
  +:w(1000)
  +playSound(vr_portal_buzz)
  +:w(100)
  +playSound(robot_clank4)
  +lookAtMarker(party, MarkerBossItemSpawn)
  +:w(100)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerBossItemSpawn, 'normal', 0, 0)
  +createPropAtMarker(ItemCubIdol, MarkerBossItemSpawn, '')
  +:w(1000)
  +?func(inParty, Anjana):{
    Anjana: "I suppose that's what we're here to retrieve."
  }
  +?is(vars.Floor2InstVr1_NorthBossDefeated):{
    +completeQuestStep(FLOOR2_INSTANCE1, 0)
  }
  +?func(inParty, Anjana):{
    +:leach(Skye, Ada)
    +:happy(Skye)
    Skye: "Looks like I get to tell everyone I wrestled a couple of bears today!"
    // Ada: "Doesn't your brother play football?"
    // +?func(inParty, Anjana):{
    //   +:ld(Anjana, down)
    //   +:smirk(Anjana)
    //   Anjana: "There are a lot of bears there, for sure."
    //   +:la(Anjana, Skye)
    // }
    // +:angry(Skye)
    // Skye: "Pft.  I could pop a dude as hard as any of the dudes on that team."
    // Skye: "We fought actual <italic>Bears</>."
    // Skye: "He'll be mad for sure."
  }
  +endConversation()

#Floor2InstVr1_South_SpawnBossItem
  load,this
@this
  +?all(is(vars.Floor2InstVr1_SouthBossDefeated),isnot(with(CubIdol))):{
    +createPropAtMarker(ItemCubIdol, MarkerBossItemSpawn, '')
  }

#Floor2InstVr1_DiskDepositSouth
  action,?all(once('16da5079'),func(carryingProp, PropDisk)):this
  action,?isnot(vars.Floor2InstVr1_diskDepositedSouth):Floor2InstVr1_DiskDeposit_hint
  action,Floor2InstVr1_DiskDeposit_placed
  load,Floor2InstVr1_DiskDepositSouth_load
@this
  +:Floor2InstVr1_SpawnItemFromDisk(ItemPowerCardigan, vars.Floor2InstVr1_diskDepositedSouth, MarkerDiskDepositSouth, MarkerDiskPlacementSouth, 25, -25)
@Floor2InstVr1_DiskDepositSouth_load
  +?is(vars.Floor2InstVr1_diskDepositedSouth):{
    +changeTileAtMarker(MarkerDiskPlacementSouth, DISK_INSERTED)
  }

#Floor2InstVr1Dispenser
  action,?all(with(CubIdol), with(UrsaIdol), once('11ba78ec')):Floor2InstVr1_CompletedChallenge
  action,?all(with(CubIdol), with(UrsaIdol)):Floor2InstVr1_AlreadyCompletedChallenge
  action,this
@this
  +setConversation(Ada)
  +:ld(Ada, rightup)
  Ada: "I do not have the required items to put in this dispenser yet."
  +endConversation()
@Floor2InstVr1_AlreadyCompletedChallenge
  +setConversation(Ada)
  +:ld(Ada, rightup)
  Ada: "I have already used this dispenser to complete the challenge."
  +endConversation()
@Floor2InstVr1_CompletedChallenge
  +setConversation(Ada)
  +:ld(Ada, rightup)
  +walkPartyToFormation()
  Ada: "I assume we are supposed to deposit the <color=LIGHTBLUE>Ursa Idol</> and the <color=LIGHTBLUE>Cub Idol</> into here?"
  +none()
  +:lockCamera()
  +:bumpY(Ada, -1)
  +playSound(knock)
  +:w(50)
  +removeItem(UrsaIdol)
  +:none()
  +:w(500)
  +:bumpY(Ada, -1)
  +playSound(knock)
  +:w(50)
  +removeItem(CubIdol)
  +:none()
  +:w(500)
  +:w(1000)
  +playSound(chime)
  +:w(200)
  +:unlockCamera()
  +:ld(Party, right)
  +panCameraRelativeToPlayer(10, 0)
  +spawnCharacterAtMarker(GreenGuy, MarkerGreenGuy)
  +:face(GreenGuy, left)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerGreenGuy, 'normal', 8, 8)
  +:w(500)
  +:exclaim(GreenGuy)
  GreenGuy: "Congratulations!  You have completed the challenge in this instance."
  +:teardrop(Ada)
  Ada: "Who exactly are you?"
  +?func(inParty, Anjana):{
    Anjana: "And why are you so <color=LIGHTGREEN>Green</>?"
  }
  +:shakeZ(GreenGuy)
  GreenGuy: "I am the <color=LIGHTGREEN>Alternate</> who resides in this area.  I have been tracking your progress ever since you teleported in here."
  Ada: "You are an <color=LIGHTGREEN>Alternate</>?  Do you... work here?"
  GreenGuy: "Work?  No, I simply reside here."
  +:teardrop(Ada)
  Ada: "Then why have you been tracking us?"
  GreenGuy: "I am a <color=LIGHTGREEN>Watcher</>.  I watch."
  +?func(inParty, Skye):{
    Skye: "That's kinda creepy."
  }
  GreenGuy: "I see you've defeated the <italic>evil monsters</> in this area!"
  GreenGuy: "I feel compelled to give you a reward."
  GreenGuy: "I'll let you chose what you want though."
  GreenGuy: "Would you like a <color=ORANGE>Powerful Weapon</> or a <color=LIGHTPURPLE>Protective Vestment</>?"
  +awaitChoice('Powerful Weapon.', 'Protective Vestment.')
  +?eq(lastChoiceIndex, 0):{
    GreenGuy: "You choose the <color=ORANGE>Powerful Weapon</>?  Then I shall grant you one."
    +setStorage(vars.ItemChosen, SpeedyDagger)
  }
  +?eq(lastChoiceIndex, 1):{
    GreenGuy: "You choose the <color=LIGHTPURPLE>Protective Vestment</>?  Then I shall grant you one."
    +setStorage(vars.ItemChosen, RockVest)
  }
  +none()
  +walkToCharacter(GreenGuy, Ada, 8, 0)
  +:w(100)
  +playSound(terminal_beep)
  +:bumpZ(GreenGuy, 1)
  +acquireItem({vars.ItemChosen})
  +walkToMarker(GreenGuy, MarkerGreenGuy)
  +:ld(GreenGuy, left)
  GreenGuy: "Enjoy your prize."
  +:happy(GreenGuy)
  +:ld(GreenGuy, down)
  +:w(500)
  +despawnCharacter(GreenGuy)
  +playSound(spawn_enemy)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, MarkerGreenGuy, 'normal', 8, 8)
  +:w(500)
  +panCameraBackToPlayer()
  +?func(inParty, Anjana):{
    Skye: "That was kinda strange..."
    Skye: "I mean he was obviously working for the arcade.  Why else would he give us a prize?"
  }
  +:la(Ada, Skye)
  Ada: "I assume that was the <italic>prize</> that the employee outside mentioned?"
  +?func(inParty, Anjana):{
    +:la(Anjana, Ada)
    Anjana: "Are all <color=LIGHTGREEN>Alternates</> so eccentric?"
    Anjana: "I mean.  Why was he so green?"
    +:la(Ada, Anjana)
    Ada: "I would not know.  I am only familiar with <color=YELLOW>Conscience</>.  And I would not say she is particularly eccentric."
    +:ld(Ada, rightdown)
    Ada: "Not compared to that."
  }
  +:ld(Ada, right)
  Ada: "I am certain father would be interested in this application of an <color=LIGHTGREEN>Alternate</>."
  Ada: "<scale=0.8 color=LIGHTGREY />I am not certain he would approve, though."
  +none()
  +completeQuestStep(FLOOR2_INSTANCE1, 1)
  +endConversation()