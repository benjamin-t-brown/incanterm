// ARG0 = The name of the marker to spawn a bridge at
// ARG1 = The name of the marker where the button is
@Floor2InstVr1_South_ClickButtonAndSpawnBridge
  +changeTileAtMarker([ARG1], DUNGEON_BLUE_BUTTON_SPAWN)
  +playSound('click')
  +:w(40)
  +playSound('click')
  +:w(40)
  +playSound('click')
  +:w(500)
  +panCameraToFitCharacters(1000, false, Invisible)
  +:w(500)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SPAWN, [ARG0], normal)
  +changeTileAtMarker([ARG0], DUNGEON_BRIDGE_SPAWN_NORTH_SOUTH)
  +playSound(spawn_enemy)
  +:w(1000)
  +panCameraBackToPlayer()

