  action,transitionFromFloor2ToVr1ToInstEntrance-action
@this
  +callScript('utils-vr-step')
@transitionFromFloor2ToVr1ToInstEntrance-action
  +setUnskippable(true)
  +dropHeldProps()
  +setConversation(Ada)
  +:utils-transition-to-vr-fade-out()
  +modifyPartyRESV(99999)
  +modifyPartyHP(99999)
  +setConversationWithoutBars(Ada)
  +waitMS(100)
  +:utils-transition-to-vr-fade-in(floor2ChallengeEntrance, MarkerVRLanding, true)
  +endConversation()

#Floor2InstVr1Sign
  action,this
@this
  +setConversation(ada)
  +:ld(Ada, up)
  +walkPartyToFormation()
  Narrator: "Welcome to <color=LIGHTPURPLE>Regem Ludos Instance 1</>!  Your task is to defeat both bosses in this area."
  Narrator: "One is to the north, and one is to the south."
  Narrator: "Once you have defeated both of them and collected their <color=LIGHTBLUE>idols</>, please return to the dispenser here and deposit them for your reward."
  +endConversation()

#floor2InstVR1_NPC1
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor2InstVR1_NPC1)
  floor2InstVR1_NPC1: "Before this day, I kinda liked most woodland critters."
  floor2InstVR1_NPC1: "But now I've decided that I <shake>HATE</> them."
  floor2InstVR1_NPC1: "Bears in particular."
  +endConversation()

#floor2InstVR1_NPC2
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor2InstVR1_NPC2)
  floor2InstVR1_NPC2: "The boss in the north is giving our party a lot of problems."
  floor2InstVR1_NPC2: "None of us has a weapon with a PIERCE attack that can get rid of its armor!"
  floor2InstVR1_NPC2: "They all went back into the arcade to see if they could buy something."
  +endConversation()

#floor2InstVR1_NPC3
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor2InstVR1_NPC3)
  floor2InstVR1_NPC3: "I have no idea how they make the mud in here actually feel so gross to walk through."
  +endConversation()

#floor2InstVR1_NPC4
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor2InstVR1_NPC4)
  floor2InstVR1_NPC4: "I've got a little advice for ya."
