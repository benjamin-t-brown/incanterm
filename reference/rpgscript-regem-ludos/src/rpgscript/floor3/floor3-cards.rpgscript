#floorCards_EntranceOpenRedDoorsToEmployeeHub
  step-first,floor3Cards_OpenRedDoorsToElevatorBCKOpen
  step-off,floor3Cards_OpenRedDoorsToElevatorBCKClose
@floor3Cards_OpenRedDoorsToElevatorBCKOpen
  +playSound(sliding_door_open)
  +:openDoor(MarkerRedDoorBCK2, RED_DOOR_BCKL)
  +:openDoor(MarkerRedDoorBCK1, RED_DOOR_BCKR)
@floor3Cards_OpenRedDoorsToElevatorBCKClose
  +playSound(sliding_door_close)
  +:closeDoor(MarkerRedDoorBCK2, RED_DOOR_BCKL)
  +:closeDoor(MarkerRedDoorBCK1, RED_DOOR_BCKR)

#floorCards_EntranceOpenSecretBlockDoorsIn
  action,this
@this
  +setConversationWithoutBars()
  +playSound(sliding_door_open)
  +:openDoor(MarkerBlockDoor1, DARK_BLOCK_BCK)
  +:openDoor(MarkerBlockDoor2, DARK_BLOCK_BCK)
  +walkToMarker(Party, MarkerBlockDoorIn)
  +walkToMarker(Party, MarkerBlockDoorOut)
  +playSound(sliding_door_close)
  +:closeDoor(MarkerBlockDoor1, DARK_BLOCK_BCK)
  +:closeDoor(MarkerBlockDoor2, DARK_BLOCK_BCK)
  +endConversation()

#floorCards_EntranceOpenSecretBlockDoorsOut
  action,this
@this
  +setConversationWithoutBars()
  +playSound(sliding_door_open)
  +:openDoor(MarkerBlockDoor1, DARK_BLOCK_BCK)
  +:openDoor(MarkerBlockDoor2, DARK_BLOCK_BCK)
  +walkToMarker(Party, MarkerBlockDoorOut)
  +walkToMarker(Party, MarkerBlockDoorIn)
  +playSound(sliding_door_close)
  +:closeDoor(MarkerBlockDoor1, DARK_BLOCK_BCK)
  +:closeDoor(MarkerBlockDoor2, DARK_BLOCK_BCK)
  +endConversation()

// BLACK JACK ----------------------------------------------------------------------------
#floor3Cards_BlackJackDealer
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_BlackJackDealer)
  floor3Cards_BlackJackDealer: "Welcome to the <color=LIGHTBLUE>Black Jack</> table.  If you would like to play, please take a position opposite me."
  +endConversation()

#floor3Cards_BlackJackGame
  action,this
@this
  +setSpeed(Ada, 1.5)
  +setUnskippable(true)
  +setWallCollisionEnabled(false)
  +setConversation()
  +setFacing(Ada, leftup)
  +walkPartyToFormation(true)
  +walkToMarker(Ada, MarkerBlackJackWalk)
  +setFacing(Ada, leftup)
  +:shakeZ(floor3Cards_BlackJackDealer)
  floor3Cards_BlackJackDealer: "Welcome to the <color=LIGHTBLUE>Black Jack</> table.  Please place your bets."
  +none()
  +setConversationWithoutBars()
  +fadeOut(750)
  +setAtMarker(Ada, MarkerBlackJackWalk)
  +runArcadeCabinetGame(BLACKJACK)
  +setAtMarker(Ada, MarkerBlackJackWalk, 32, 0)
  +fadeIn(50)
  +setWallCollisionEnabled(true)
  +setUnskippable(false)
  +setSpeed(Ada)
  +endConversation()

#floor3Cards_BlackJackBob
  action,?once('44d781d1'):floor3Cards_BlackJackBob1
  action,floor3Cards_BlackJackBob2
@floor3Cards_BlackJackBob1
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_BlackJackBob)
  floor3Cards_BlackJackBob: "Well, well, well.  A new challenger approaches?"
  floor3Cards_BlackJackBob: "Come and join, honey, my streak's just getting started!"
  +endConversation()
@floor3Cards_BlackJackBob2
