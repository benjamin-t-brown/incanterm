#floor3Cards_PresidentPresident
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_PresidentPresident)
  +stopAi(floor3Cards_PresidentBodyguard1)
  +walkToCharacter(floor3Cards_PresidentBodyguard1, Ada)
  +:ld(floor3Cards_PresidentBodyguard1, rightdown)
  +loopExpr("+offsetCharacter(Ada, 4);\n+:w(33)", 4)
  floor3Cards_PresidentBodyguard1: "Step back, miss.  No need to be so close."
  +walkToMarker(floor3Cards_PresidentBodyguard1, MarkerBodyguard1)
  +:ld(floor3Cards_PresidentBodyguard1, leftdown)
  +:la(Ada, floor3Cards_PresidentBodyguard1)
  Ada: "<cascade-letters>......"
  +:shakeZ(floor3Cards_PresidentPresident)
  +:la(Ada, floor3Cards_PresidentPresident)
  floor3Cards_PresidentPresident: "Just a precaution, miss.  Please do not be alarmed.  It comes with my station, I'm afraid."
  floor3Cards_PresidentPresident: "In this game, I am the <color=LIGHTRED>President</>.  No, really.  It's not <italic>that</> big of a deal, but still.  The station must be respected of course."
  floor3Cards_PresidentPresident: "And before you ask, it is merely a <italic>simple coincidence</> that my name happens to also be <color=LIGHTBLUE>President</>."
  +resetAi(floor3Cards_PresidentBodyguard1)
  +endConversation()

