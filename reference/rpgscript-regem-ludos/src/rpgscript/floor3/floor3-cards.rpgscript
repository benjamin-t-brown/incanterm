  +endConversation()

#floor3Cards_BlackJackJoe
  action,?once('373f69cd'):floor3Cards_BlackJackJoe1
  action,floor3Cards_BlackJackJoe2
@floor3Cards_BlackJackJoe1
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_BlackJackJoe)
  floor3Cards_BlackJackJoe: "If you're gonna play, make sure you know <italic>how</> to play."
  floor3Cards_BlackJackJoe: "I don't like playing with incompetence at the table."
  +endConversation()
@floor3Cards_BlackJackJoe2
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_BlackJackJoe)
  floor3Cards_BlackJackJoe: "Step up or go away, and don't bother me.  I'm concentrating."
