#floor3Cards_BlackJackWatcher
  action,this
@this
  +setConversation(Ada)
  +:leach(Ada, floor3Cards_BlackJackWatcher)
  floor3Cards_BlackJackWatcher: "I'm just watching.  These guys are really imposing, so I don't think I want to play with them."
  +endConversation()

@floor3Cards_onBlackJackGameCompleted
  +?is(vars.cardz.BlackJackCheat):{
    +?all(gt(vars.cardz.BlackJackPlays, 0), once('bd2f2bce')):{
      +setConversationWithoutBars(Ada)
      +?func(inParty, Anjana):{
        Anjana: "Something's wrong here.  I think the dealer is cheating."
        Ada: "How do you know?"
        Anjana: "Haven't you noticed?  The dealer's cards never bust."
        Anjana: "Neither do the other players' cards."
      }
      Ada: "Hmpf.  Perhaps I should take my tokens elsewhere."
      +endConversation()
    }
  }

