#Floor3_ThugLeader
  action,?once('e1b177ae'):Floor3_ThugLeaderQuest_Start
  action,?all(func(questStepEQ, FauxCasino, 3), with(BlueberrySwirl)): Floor3_ThugLeader_BringDrink
  action,Floor3_ThugLeader_Generic
@Floor3_ThugLeaderQuest_Setup
  +walkToMarker(Party, MarkerSashes)
  +:face(Party, rightup)
  +walkPartyToFormation()
  +setConversation(Ada)
  +:la(Ada, Floor3_ThugLeader)
  +stopAi(Floor3_Thug2)
  +:face(Floor3_Thug2, rightdown)
  +:face(Floor3_Thug1, leftup)
  +:face(Floor3_Thug3, down)
@Floor3_ThugLeaderQuest_Start
  +:Floor3_ThugLeaderQuest_Setup()
  +setConversationGroup(Ada, Floor3_ThugLeader)
  Floor3_ThugLeader: "Well if it isn't the <italic>lost lamb</> from before."
  +?func(inParty, Skye):{
    +:la(Skye, Ada)
    Skye: "You know these guys?"
  }
  +setConversationGroup(Ada, Floor3_ThugLeader)
  +:la(Skye, Floor3_ThugLeader)
  +:la(Ada, Floor3_ThugLeader)
  Ada: "I have very little interest in speaking with you."
  +setAnimationState(Floor3_ThugLeader, idle)
  +:la(Floor3_ThugLeader, Ada)
  Floor3_ThugLeader: "Yet you still walked up to <color=LIGHTBLUE>The Leader of the Sashes</> on your own."
  Ada: "<cascade-letters>...... I am already regretting it."
  +:la(Floor3_ThugLeader, Ada)
  Floor3_ThugLeader: "Come to test your luck at this fine casino?"
  Ada: "I am not here to gamble."
  Floor3_ThugLeader: "That's surprising to hear."
  Floor3_ThugLeader: "Did you see anything in the store here that caught your eye?  Something that might assist you against <color=LIGHTRED cascade-letters=33>a certain robot</>?"
  +:exclaimShort(Anjana)
  +:exclaimShort(Skye)
  +:exclaim(Ada)
  Ada: "How do you know about that?"
  +?func(inParty, Anjana):{
    Anjana: "Have you been following us?"
  }
  +setConversationGroup(Ada, Floor3_ThugLeader)
  +:laughObnoxiously(Floor3_ThugLeader)
  Floor3_ThugLeader: "When you're a big shot, you can learn a lot about the goings-on in this place."
  +?func(inParty, Anjana):{
    Anjana: "You wish you were a big shot, don't you?"
    +:la(Floor3_ThugLeader, Anjana)
    +:smirk(Floor3_ThugLeader)
    Floor3_ThugLeader: "You tell me which one of us can use the VIP elevator."
  }
  +setConversationGroup(Ada, Floor3_ThugLeader)
  +:la(Floor3_ThugLeader, Ada)
  Floor3_ThugLeader: "That store is expensive and it only takes <color=YELLOW>Tokens</>.  It's designed to force you to gamble."
  Floor3_ThugLeader: "You can win big, you know;\n<cascade-letters=50 italic>if you're in the club."
  Ada: "What is that supposed to mean?"
  Floor3_ThugLeader: "Have you noticed something odd about this <italic>casino</>."
  +?is(vars.hasNoticedCasinoCheating):{
    Ada: "Yes.  It seems like <italic>certain</> people win more than others."
    Floor3_ThugLeader: "Bingo.  I'm guessing you haven't had much luck yourself?"
  }
  +?isnot(vars.hasNoticedCasinoCheating):{
    Ada: "I told you.  I am not here to gamble."
    Floor3_ThugLeader: "When you're in Rome, dear, sometimes you must do as the Romans do."
  }
  Ada: "It is clearly a waste of time to engage with the games here."
  Floor3_ThugLeader: "Yet you need <color=YELLOW>Tokens</>.  A conundrum, wouldn't you say?"
  +?func(inParty, Anjana):{
    Anjana: "Just spill it already."
  }
  Floor3_ThugLeader: "I can tell you the secret to winning here.  Or at least, the secret to <italic>not losing</>."
  Ada: "Yes?  What is it?"
  Floor3_ThugLeader: "Tsk. Tsk.  Just because I can, doesn't mean I will."
  Floor3_ThugLeader: "Without a little <italic>something</> in return, I don't think I can help you."
  Ada: "What do you want?\n  <color=LIGHTGREY>And do not ask me to play some stupid game again."
  +:ld(Floor3_ThugLeader, rightdown)
  Floor3_ThugLeader: "I'm not really sure what I want<cascade-letters>....."
  +:la(Floor3_ThugLeader, Ada)
  Floor3_ThugLeader: "Well, right now I can tell you I'm parched."
  Floor3_ThugLeader: "How about something to drink?  Would you be so kind?"
  +?func(inParty, Anjana):{
    +:leach(Ada, Anjana)
    +:angry(Anjana)
    Anjana: "Don't be this snake's servant.  You're way above that."
  }
  +:leach(Ada, Floor3_ThugLeader)
  Ada: "If I get you a drink, will you tell me what I need to know?"
  +:shrug(Floor3_ThugLeader)
  Floor3_ThugLeader: "It would certainly help."
  +:shakeZ(Floor3_ThugLeader)
  Floor3_ThugLeader: "By the way, I'm partial to the <color=LIGHTBLUE>Blueberry Swirl</> they serve at the bar."
  +none()
  +startQuest(FauxCasino)
  +startAi(Floor3_Thug2)
  +panCameraBackToPlayer()
  +endConversation()
@Floor3_ThugLeader_BringDrink
  +:Floor3_ThugLeaderQuest_Setup()
  Ada: "I have your <italic>delicious</> drink for you."
  Ada: "I am assuming you already know how much of a pain it was to get."
  Floor3_ThugLeader: "Why, thank you so much! I never would have guessed!"
  +:none()
  +removeItem(BlueberrySwirl)
  Floor3_ThugLeader: "Yum.  I'll enjoy some of that later."
  Floor3_ThugLeader: "But I've also suddenly realized how hungry I am.  Though, not for anything normal. I could use something exotic."
  Ada: "I am not your personal servant."
  Floor3_ThugLeader: "Oh no, I'm not implying that at all!"
  Floor3_ThugLeader: "But if you were to bring me some kind of fancy <color=LIGHTRED>Hors d'oeuvre</>, I might be persuaded to aid you in your <italic>quest</>."
  +:angry(Ada)
  Ada: "I am not on a quest!  And no more of these vagaries!  If I get you your stupid food, you <italic>will</> tell me what I need to know."
  +walkToOffset(Ada, 0, -4)
  Ada: "Got it?"
  Floor3_ThugLeader: "<cascade-letters>Fine. <cascade-letters=75>Fine. </>This is the last thing I'll ask for."
  Floor3_ThugLeader: "Hurry up though, I'm <italic>certain</> I'm going to starve."
  +none()
  +completeQuestStep(FauxCasino, 3)
  +startAi(Floor3_Thug2)
  +endConversation()

@Floor3_ThugLeader_Generic
  +:Floor3_ThugLeaderQuest_Setup()
  Floor3_ThugLeader: "Come back when you have something to give me."
  +startAi(Floor3_Thug2)
  +endConversation()

