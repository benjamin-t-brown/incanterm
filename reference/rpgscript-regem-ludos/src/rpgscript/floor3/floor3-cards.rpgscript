#floor3CardsBar_Solitaire
  action,this
@this
  +setConversation(Ada)
  +stopAi(Floor3Cards_Bartender)
  +setFacing(Ada, rightup)
  +:la(Floor3Cards_Bartender, Ada)
  +:question(Floor3Cards_Bartender)
  Floor3Cards_Bartender: "Wanna play a game of <color=LIGHTBLUE>Solitaire</>?"
  +none()
  +setSpeed(Floor3Cards_Bartender, 1.8)
  +walkToMarker(Floor3Cards_Bartender, MarkerSolitaire, 0, -32)
  +:la(Floor3Cards_Bartender, Ada)
  Floor3Cards_Bartender: "I'll set up the cards for you."
  +none()
  +fadeOut(500)
  +setSpeed(Floor3Cards_Bartender)
  +setAtMarker(Ada, MarkerSolitaire)
  +runArcadeCabinetGame(SOLITAIRE)
  +fadeIn(50)
  +endConversation()
  +startAi(Floor3Cards_Bartender)

@floor3CardsBar_SolitaireWonAGame
  +setConversation(Ada)
  +:face(Ada, rightup)
  +walkPartyToFormation()
  +spawnCharacterAtMarker(Floor3Cards_SolitaireTrophyGiver, MarkerFromNorth)
  +stopAi(Floor3Cards_Bartender)
  +walkToMarker(Floor3Cards_Bartender, MarkerSolitaire, 0, -32, true)
  +:leach(Ada, Floor3Cards_SolitaireTrophyGiver)
  +panCameraToFitCharacters(700, false, Ada, Floor3Cards_SolitaireTrophyGiver)
  +:leach(Floor3Cards_SolitaireTrophyGiver, Ada)
  +:shakeZ(Floor3Cards_SolitaireTrophyGiver)
  Floor3Cards_SolitaireTrophyGiver: "Aha.  There you are!"
  +walkToCharacter(Floor3Cards_SolitaireTrophyGiver, Ada, 16, 0, true)
  +panCameraBackToPlayer(1000)
  +:la(Party, Floor3Cards_SolitaireTrophyGiver)
  Floor3Cards_SolitaireTrophyGiver: "Pardon me.  Do you happen to be the one who just won a game of <color=LIGHTBLUE>Solitaire</>?"
  +:la(Party, Floor3Cards_SolitaireTrophyGiver)
  +:face(Floor3Cards_Bartender, leftdown)
  Ada: "Yes, that was me."
  Floor3Cards_SolitaireTrophyGiver: "Great!  I'm in the right spot."
  Floor3Cards_SolitaireTrophyGiver: "I have a <color=LIGHTBLUE>Trophy</> for you.  Here you go."
  +none()
  +walkToCharacter(Floor3Cards_SolitaireTrophyGiver, Ada, 8, 0)
  +:la(Floor3Cards_SolitaireTrophyGiver, Ada)
  +acquireItem(SolitaireTrophy)
  +walkToCharacter(Floor3Cards_SolitaireTrophyGiver, Ada, 16, 0)
  +:leach(Floor3Cards_SolitaireTrophyGiver, Ada)
  Floor3Cards_SolitaireTrophyGiver: "Make sure to put it somewhere safe!"
  Floor3Cards_SolitaireTrophyGiver: "Have a good day!"
  +none()
  +walkToMarker(Floor3Cards_SolitaireTrophyGiver, MarkerFromNorth)
  +despawnCharacter(Floor3Cards_SolitaireTrophyGiver)
  +?func(inParty, Anjana):{
    +:leach(Anjana, Ada)
    Anjana: "Um.  What was the point of that?"
  }
  +?func(inParty, Skye):{
    +:leach(Skye, Ada)
    Skye: "Do they give out trophies for everything around here?"
  }
  +:shakeZ(Floor3Cards_Bartender)
  +:la(Party, Floor3Cards_Bartender)
  Floor3Cards_Bartender: "That guy has been doing that ever since I've worked here."
  +:question(Ada)
  Ada: "You mean, this isn't something the Casino does?"
  Floor3Cards_Bartender: "Nope.  He just likes to give out trophies, I guess."
  +:ld(Ada, rightdown)
  Ada: "Strange..."
  +:ld(Ada, down)
  Ada: "I bet <color=YELLOW>Conscience</> would have liked him."
  +endConversation()
  +startAi(Floor3Cards_Bartender)


// STORE ---------------------------------------------------------------------------------

#floor3CardsNorth_vipElevator
  action,?once('f2a2de67'):floor3CardsNorth_vipElevator_1
  action,?once('1fca3da9'):floor3CardsNorth_vipElevator_2
  action,floor3CardsNorth_vipElevator_3
@floor3CardsNorth_vipElevatorStart
  +setConversation(Ada)
  +walkToMarker(Ada, MarkerElevatorButton)
  +:ld(Ada, rightup)
  +walkPartyToFormation()
  +:bumpY(Ada, -2)
  +playSound(terminal_beep)
  +:w(750)
  +playSound(terminal_cancel)
  Narrator: "This elevator is for <color=LIGHTPURPLE>VIP</> access only."
  Narrator: "A <color=LIGHTPURPLE>VIP</> is not present in your current surroundings."
@floor3CardsNorth_vipElevator_1
  +:floor3CardsNorth_vipElevatorStart()
  +assert("+?all(func(inParty, Skye),func(inParty, Anjana))", "+endConversation()")
  +:angry(Ada)
  Ada: "How are we supposed to get out of this place?"
  +:leach(Skye, Ada)
  Skye: "We could ask to be VIPs?  I wouldn't mind that."
  +:flat(Anjana)
  Anjana: "I'd rather spare us the lecture we would get asking an employee about that."
  +:ld(Anjana, down)
  Anjana: "We'll have to go back the way we came."
  +:la(Skye, Anjana)
  Skye: "And face that huge robot?"
  Skye: "I like to smash hunks of metal as much as the next girl, but I'm not sure we can take that thing."
  +:bored(Ada)
  +:la(Ada, Skye)
  Ada: "I have to agree."
  Anjana: "Well, that Alternate <color=LIGHTRED>Scout</> told us we could find a way through here.  Let's keep looking."
  +:lightbulb(Anjana)
  Anjana: "Maybe he meant we could find something in this Casino that would help us proceed."
  +endConversation()
@floor3CardsNorth_vipElevator_2
  +:floor3CardsNorth_vipElevatorStart()
  +assert("+?all(func(inParty, Skye),func(inParty, Anjana))", "+endConversation()")
  +:leach(Anjana, Ada)
  +:sarcasm(Anjana)
  Anjana: "If you just sit here and keep pressing the button over and over, I'll start calling you <color=LIGHTBLUE>Stanley</>."
  +:teardrop(Ada)
  +:la(Ada, Anjana)
  Ada: "<cascade-letters>Point taken."
  +endConversation()
@floor3CardsNorth_vipElevator_3
  +:floor3CardsNorth_vipElevatorStart()
  +endConversation()

