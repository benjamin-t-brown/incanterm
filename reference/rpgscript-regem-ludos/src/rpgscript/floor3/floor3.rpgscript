#floor3North_SigmaKnocksBoxesDown
  step,?once('e2e23216'):floor3North_SigmaKnocksBoxesDown
@floor3North_SigmaKnocksBoxesDown
  +stopAi(Foreman)
  +setConversationGroup(Foreman, floor3North_WagonHauler1)
  +setWallCollisionEnabled(false)
  +spawnCharacterAtMarker(Sigma, MarkerSigmaSpawn)
  +walkToOffset(Ada, 16, 0)
  +walkPartyToFormation(true)
  +walkToOffset(Foreman, 32, 32, true)
  +panCameraToFitCharacters(1500, false, Foreman)
  +panCameraRelativeToCurrentPosition(0, 55, 500)
  +:exclaim(Foreman)
  Foreman: "Why did you bring this stuff here?"
  Foreman: "I told you we don't have any more room!"
  +:shakeZ(floor3North_WagonHauler1)
  floor3North_WagonHauler1: "It's just a few boxes and things, boss."
  floor3North_WagonHauler1: "The shopkeep said we could store them here."
  +:angry(Foreman)
  +walkToOffset(Foreman, 12, 0)
  +:la(Foreman, floor3North_WagonHauler1)
  Foreman: "Absolutely not."
  +:jump(Foreman)
  Foreman: "I don't care what they said!"
  Foreman: "Go. Back. The. <shake>WAY YOU CAME</>!"
  +:teardrop(floor3North_WagonHauler1)
  floor3North_WagonHauler1: "But... we don't have any space over there either!"
  +:none()
  +walkToMarker(Sigma, MarkerSigma1, 0, 0, true)
  +panCameraRelativeToCurrentPosition(50, 10, 500)
  +walkToMarker(Sigma, MarkerSigma2, 0, 0)
  +:ld(Sigma, down)
  +:w(100)
  +:lookAround(Sigma)
  +:w(100)
  +:ld(Sigma, left)
  +:jump(Sigma)
  +:exclaim(Sigma)
  Sigma: "Moo!!!"
  +none()
  +:la(floor3North_WagonHauler1, Sigma)
  +:la(floor3North_WagonHauler2, Sigma)
  Sigma: "Moo!!! Moo!! Mooo!"
  +none()
  +:jump(Sigma)
  +setSpeed(Sigma, 3)
  +walkToMarker(Sigma, MarkerSigmaWagonWalk, 0, 0, true)
  +panCameraRelativeToCurrentPosition(-50, 10, 500)
  +playSound(thunk)
  +:bumpY(Sigma, -2)
  +walkToMarker(floor3North_cowWagon, MarkerCollide1, 0, 0, true)
  +setSpeed(Sigma, 3.9)
  +:exclaim(Sigma)
  +walkToMarker(Sigma, MarkerCollide1, 0, 0, true)
  +:w(100)
  +:face(floor3North_WagonHauler1, leftdown)
  +:face(floor3North_WagonHauler2, leftdown)
  +panCameraRelativeToCurrentPosition(-50, 10, 400, true)
  +walkToMarker(Sigma, MarkerWagonLeave, 0, 0, true)
  +walkToMarker(floor3North_cowWagon, MarkerWagonLeave, 0, 0, true)
  +playSound(knock)
  +playSound(knock)
  +playSound(knock)
  +:floor3North_cratesFall()
  +despawnCharacter(Sigma)
  +despawnCharacter(floor3North_cowWagon)
  +panCameraToFitCharacters(500, false, Foreman, floor3North_WagonHauler1)
  +setConversationGroup(Foreman, floor3North_WagonHauler1)
  +setSpeed(Foreman, 3)
  +walkToOffset(Foreman, 0, 16)
  +:exclaim(Foreman)
  +:jump(Foreman)
  +:ld(Foreman, leftdown)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_NERVOUS_SWEAT, Foreman, normal)
  Foreman: "No!  <scale=1.5>No!  <scale=2.0>No!"
  +:ld(Foreman, leftdown)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_NERVOUS_SWEAT, Foreman, normal)
  Foreman: "<scale=1.25>What in the world was that?!?!"
  +:angry(Foreman)
  +:ld(Foreman, rightdown)
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_NERVOUS_SWEAT, Foreman, normal)
  Foreman: "Oh... this is going to set us back for weeks!"
  Foreman: "<cascade-letters>WEEKS I TELL YOU!"
  +:none()
  +walkToOffset(floor3North_WagonHauler2, -16, 0)
  +:w(500)
  +:la(floor3North_WagonHauler2, floor3North_WagonHauler1)
  floor3North_WagonHauler2: "That wasn't our fault was it?"
  +:la(floor3North_WagonHauler1, Foreman)
  floor3North_WagonHauler1: "Um.  What about this wagon boss?"
  floor3North_WagonHauler1: "We can't really go back now."
  +:none()
  +:la(Foreman, floor3North_WagonHauler1)
  Foreman: "<italic cascade-letters>Just push it..."
  Foreman: "<scale=2.0 cascade=200> OUT OF THE WAY!!!"
  +none()
  +:shakeZ(floor3North_WagonHauler2)
  floor3North_WagonHauler2: "Right away, boss!"
  +none()
  +setSpeed(floor3North_regularWagon, 2.5)
  +setSpeed(floor3North_WagonHauler1, 2.5)
  +setSpeed(floor3North_WagonHauler2, 2.5)
  +walkToMarker(floor3North_regularWagon, MarkerWagonHaulersEnd, 0, 0, true)
  +walkToMarker(floor3North_WagonHauler1, MarkerWagonHaulersEnd, 0, 0, true)
  +walkToMarker(floor3North_WagonHauler2, MarkerWagonHaulersEnd, 0, 0)
  +walkToMarker(floor3North_regularWagon, MarkerWagonHaulersEnd2, 0, 0, true)
  +walkToMarker(floor3North_WagonHauler1, MarkerWagonHaulersEnd2, 0, 0, true)
  +walkToMarker(floor3North_WagonHauler2, MarkerWagonHaulersEnd2, 0, 0)
  +endConversation(100, true)
  +panCameraToFitCharacters(500, false, Foreman)
  +setConversation()
  +:jump(Foreman)
  Foreman: "<scale=2.0>LISTEN UP EVERYONE!"
  +none()
  +walkToOffset(floor3North_BoxHauler1, 20, -62, true)
  +walkToOffset(floor3North_BoxHauler3, 40, 40, true)
  +walkToOffset(floor3North_BoxHauler5, 0, 64, true)
  +walkToOffset(floor3North_BoxHauler6, 0, 64)
  +:w(500)
  +lookAtCharacter(floor3North_BoxHauler1, Foreman)
  +lookAtCharacter(floor3North_BoxHauler3, Foreman)
  +lookAtCharacter(floor3North_BoxHauler4, Foreman)
  +lookAtCharacter(floor3North_BoxHauler5, Foreman)
  +lookAtCharacter(floor3North_BoxHauler6, Foreman)
  +:ld(Foreman, leftdown)
  Foreman: "I have to go report this <shake>MISHAP</> to HQ!"
  +lookAtCharacter(floor3North_BoxHauler1, Foreman)
  +:ld(Foreman, down)
  Foreman: "You all better have this cleaned up by the time I get back!"
  +:ld(Foreman, up)
  Foreman: "Or else you'll be on <color=red>WAGON DUTY</> for the rest of the month!"
  +:ld(Foreman, rightdown)
  Foreman: "You all got that?"
  +:shakeZ(floor3North_BoxHauler1)
  floor3North_BoxHauler1: "Right away, boss."
  +:shakeZ(floor3North_BoxHauler3)
  floor3North_BoxHauler3: "Yes of course, boss."
  +none()
  +:shakeZ(Foreman)
  Foreman: "<color=LIGHTGREY /> The things I have to deal with..."
  +none()
  +walkToMarker(Foreman, MarkerForemanLeave, 0, 0, true)
  +setWallCollisionEnabled(true)
  +fadeOut(700)
  +panCameraBackToPlayer(1)
  +changeRoom(floor3North, MarkerPartySpawn)
  +:face(Ada, rightdown)
  +walkPartyToFormation()
  +fadeIn(700)
  +endConversation()

#floor3North_cratesFall
  step-first,?once('f9748d67'):this
@this
  +setConversation(Ada)
  +playSound(click)
  +:w(100)
  +changePropAnim(PropCratesFall3, "animated-props/crates_falling_anim")
  +:w(50)
  +playSound(collapse)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SMOKE_FAST, MarkerSmoke2, rise, 0, 0)
  +changePropAnim(PropCratesFall2, "animated-props/crates_falling_anim")
  +:w(100)
  +changePropAnim(PropCratesFall1, "animated-props/crates_falling_anim")
  +:w(50)
  +changePropAnim(PropCratesFall6, "animated-props/crates_falling_up_anim", -78, -42)
  +:w(50)
  +spawnParticleAtMarker(EFFECT_TEMPLATE_SMOKE_FAST, MarkerSmoke1, rise, 0, 0)
  +changePropAnim(PropCratesFall5, "animated-props/crates_falling_up2_anim", -78, -42)
  +:w(100)
  +changePropAnim(PropCratesFall4, "animated-props/crates_falling_up_anim", -78, -42)
  +endConversation()

#floor3North_cannotProceed
  action,?is(vars.floor3North_blocked):floor3North_cannotProceed_1
  action,floor3North_cannotProceed_2
@floor3North_cannotProceed_1
  +:ld(Ada, leftdown)
  +setConversation(Ada)
  Ada: "It seems like we need to wait for the employees to clean this up before we can get through."
  +endConversation()
@floor3North_cannotProceed_2
  +:ld(Ada, leftdown)
  +setConversation(Ada)
  Ada: "I certainly hope the crates do not fall this time."
  +endConversation()

