#floor3North_BoxHauler5
  action,?once('6cb1523c'):floor3North_BoxHauler5_1
  action,?once('72a25deb'):floor3North_BoxHauler5_2
  action,?once('2f5ba150'):floor3North_BoxHauler5_3
  action,floor3North_BoxHauler5_4
@floor3North_BoxHauler5_1
  +setConversationGroup(floor3North_BoxHauler5, floor3North_BoxHauler6)
  +walkToMarker(Party, MarkerAdaWalkWagonConvo1)
  +:ld(Ada, leftup)
  +walkPartyToFormation()
  +:ld(floor3North_BoxHauler5, leftup)
  +:ld(floor3North_BoxHauler6, leftup)
  floor3North_BoxHauler5: "See, I told you they wouldn't fit in the wagon."
  floor3North_BoxHauler5: "It's way too small."
  floor3North_BoxHauler6: "I guess you were right."
  +:leach(floor3North_BoxHauler5, floor3North_BoxHauler6)
  floor3North_BoxHauler6: "But I brought the thing all the way over here, the least we could do is try to use it."
  +:ld(floor3North_BoxHauler6, leftup)
  floor3North_BoxHauler6: "Maybe you could sit in it and I could pull you around?"
  +:smirk(floor3North_BoxHauler5)
  floor3North_BoxHauler5: "Better not let the Foreman see us."
  +panCameraBackToPlayer(500, true);
  +endConversation()
@floor3North_BoxHauler5_2
  +walkToMarker(Party, MarkerAdaWalkWagonConvo1)
  +:ld(Ada, leftup)
  +setConversationGroup(floor3North_BoxHauler5, floor3North_BoxHauler6)
  +walkPartyToFormation()
  +:ld(floor3North_BoxHauler5, leftup)
  +:ld(floor3North_BoxHauler6, leftup)
  floor3North_BoxHauler5: "On second thought, the wagon seems kinda dangerous."
  floor3North_BoxHauler6: "Oh c'mon!  It'll be fun!"
  floor3North_BoxHauler5: "Maybe we can trick an <color=LIGHTGREEN>Alternate</> into pulling it for us."
  floor3North_BoxHauler6: "Nah, they hate manual labor."
  +panCameraBackToPlayer(500, true);
  +endConversation()
@floor3North_BoxHauler5_3
  +walkToMarker(Party, MarkerAdaWalkWagonConvo1)
  +:ld(Ada, leftup)
  +setConversationGroup(floor3North_BoxHauler5, floor3North_BoxHauler6)
  +walkPartyToFormation()
  +:ld(floor3North_BoxHauler5, leftup)
  +:ld(floor3North_BoxHauler6, leftup)
  floor3North_BoxHauler5: "So they don't have any bigger wagons?"
  floor3North_BoxHauler6: "They do, but I'm not gonna haul it over here."
  floor3North_BoxHauler5: "It has wheels, how heavy can it be?"
  floor3North_BoxHauler6: "It's not the weight, it's the size."
  floor3North_BoxHauler6: "They don't fit through the automatic doors very well."
  +panCameraBackToPlayer(500, true);
  +endConversation()
@floor3North_BoxHauler5_4
  +walkToMarker(Party, MarkerAdaWalkWagonConvo1)
  +:ld(Ada, leftup)
  +setConversationGroup(floor3North_BoxHauler5, floor3North_BoxHauler6)
  +walkPartyToFormation()
  +:ld(floor3North_BoxHauler5, leftup)
  +:ld(floor3North_BoxHauler6, leftup)
  floor3North_BoxHauler5: "It's too bad the wagon is smaller than the boxes."
  +panCameraBackToPlayer(500, true);
  +endConversation()

#floor3EmployeeHub_DeskEmployee
  action,?once('7216e742'):floor3EmployeeHub_DeskEmployee1
  action,floor3EmployeeHub_DeskEmployee2
@floor3EmployeeHub_DeskEmployee1
  +setConversation(Ada)
  +:leach(floor3EmployeeHub_DeskEmployee, Ada)
  // +walkPartyToFormation()
  floor3EmployeeHub_DeskEmployee: "You best be on your way to your station.  Don't wanna get chewed out by the <color=LIGHTRED>Foreman</>, do you."
  +:shakeZ(Ada)
  Ada: "...Right.  Where are we, exactly?"
  +:flat(floor3EmployeeHub_DeskEmployee)
  floor3EmployeeHub_DeskEmployee: "Did you sleep through training or something?"
  floor3EmployeeHub_DeskEmployee: "This is the <color=LIGHTPURPLE>Employee Hub</> for the third floor."
  +:la(floor3EmployeeHub_DeskEmployee, Ada)
  floor3EmployeeHub_DeskEmployee: "Employees come through here to get to their stations, or to take a break."
  +:ld(floor3EmployeeHub_DeskEmployee, right)
  floor3EmployeeHub_DeskEmployee: "Over there is the entrance to the <color=LIGHTPURPLE>Faux Casino</>, I assume you are stationed there, why else would you be here?"
  +:ld(floor3EmployeeHub_DeskEmployee, leftdown)
  floor3EmployeeHub_DeskEmployee: "There's also some useful teleporters to various parts of the floor, but you need certain access to use them."
  +:la(floor3EmployeeHub_DeskEmployee, Ada)
  floor3EmployeeHub_DeskEmployee: "And... with all due respect, <italic>I don't think you have that access</>."
  +?func(inParty, Skye):{
    Skye: "What's that supposed to mean?"
  }
  +:smirk(floor3EmployeeHub_DeskEmployee)
  floor3EmployeeHub_DeskEmployee: "Look.  I've been working here longer than you honey, I know who's who and who <italic>ain't</>."
  +?func(inParty, Skye):{
    +:angry(Skye)
    +:jump(Skye)
    Skye: "Why you..."
    +?func(inParty, Anjana):{
      +setSpeed(Anjana, 2.5)
      +setSpeed(Skye, 2.5)
      +walkToCharacter(Anjana, Skye)
      +:w(100)
      +walkToOffset(Anjana, 48, 0, true)
      +:face(Ada, Anjana)
      +offsetCharacter(Skye, 8, 0)
      +:w(33)
      +loopExpr("+offsetCharacter(Skye, 4, 0)\n+playSound(knock)\n+:w(33)", 14)
      +:la(Ada, Anjana)
      +:shakeZ(Anjana)
      Anjana: "Just shut up and let's move on."
      Anjana: "She's dumb enough to think we are employees, after all."
    }
    +walkToOffset(Ada, 32, 0)
  }
  +endConversation()
@floor3EmployeeHub_DeskEmployee2
  +setConversation(Ada)
  +:leach(floor3EmployeeHub_DeskEmployee, Ada)
  floor3EmployeeHub_DeskEmployee: "Not to nit pick you or anything, but you really should be in uniform, even back here in an <color=LIGHTPURPLE>Employee Hub</>."
  floor3EmployeeHub_DeskEmployee: "I've been chewed out for that before."
  +endConversation()

#floor3EmployeeHub_Vending
  action,this
@this
  +showStore(FLOOR3_EMPLOYEE_HUB_VENDING_MACHINE)

#floor3EmployeeHub_VendingEmployee
  action,?once('fc6dddb7'):floor3EmployeeHub_VendingEmployee1
  action,floor3EmployeeHub_VendingEmployee2
@floor3EmployeeHub_VendingEmployee1
  +setConversation(Ada)
  +:leach(floor3EmployeeHub_VendingEmployee, Ada)
  floor3EmployeeHub_VendingEmployee: "I really want an <color=LIGHTBLUE>Almond Milk Latte</> but the vending machine is out of them."
  floor3EmployeeHub_VendingEmployee: "They're <italic>never</> in stock though, so I don't know why I keep looking."
  +:ld(floor3EmployeeHub_VendingEmployee, leftup)
  floor3EmployeeHub_VendingEmployee: "I guess I could settle for a <color=LIGHTBLUE>Bubble Pop</>, but it's just so darn expensive..."
  +:floor3EmployeeHub_VendingEmployeeBubblePop()
  +endConversation()
@floor3EmployeeHub_VendingEmployee2
  +setConversation(Ada)
  +:leach(floor3EmployeeHub_VendingEmployee, Ada)
  +?is(vars.givenBubblePop):{
    floor3EmployeeHub_VendingEmployee: "I need to bug the Foreman about restocking this vending machine."
  }
