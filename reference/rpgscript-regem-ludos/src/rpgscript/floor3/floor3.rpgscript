#floor3North_load
  load,this
@this
  +?is(vars.floor3North_blocked):{
    +changePropAnim(PropCratesFall1, "animated-props/crates_falling_completed")
    +changePropAnim(PropCratesFall2, "animated-props/crates_falling_completed")
    +changePropAnim(PropCratesFall3, "animated-props/crates_falling_completed")
    +changePropAnim(PropCratesFall4, "animated-props/crates_falling_up_completed", -78, -42)
    +changePropAnim(PropCratesFall5, "animated-props/crates_falling_up2_completed", -78, -42)
    +changePropAnim(PropCratesFall6, "animated-props/crates_falling_up_completed", -78, -42)
    +despawnCharacter(floor3North_Foreman)
    +despawnCharacter(floor3North_WagonHauler1)
    +despawnCharacter(floor3North_WagonHauler2)
    +despawnCharacter(floor3North_regularWagon)
    +despawnCharacter(floor3North_cowWagon)
  }
  +?once('528d3a5c'):{
    +setStorage(vars.floor3North_blocked, true)
  }

#floor3North_toEmployeeHub
  step,this
@this
