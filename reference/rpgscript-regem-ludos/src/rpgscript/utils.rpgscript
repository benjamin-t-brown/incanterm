  +playSound(menu_choice_open)
  +showUISection(CharacterStatus)
@utils-kioskStats_no_bracer
// +setCharacterText('This kiosk requires a Haptic Bracer.');
@utils-kioskStats_action_cancel
  +playSound(terminal_cancel)

