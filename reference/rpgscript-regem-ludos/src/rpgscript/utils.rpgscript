  }
  +setConversationSpeaker(none)
  +offsetCharacter([ARG0], 0, 0, 2)
  +waitMS(33)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33)
  +offsetCharacter([ARG0], 0, 0, 2)
  +waitMS(33)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33)
  +offsetCharacter([ARG0], 0, 0, 0)
  +waitMS(300)
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:unlockCamera()
  }
@shakeZ
