// ARG0 = marker where left-most door is
// ARG1 = door sprite, eg RED_DOOR_BCK
@openDoubleDoors
  +changeTileAtMarker([ARG0], [ARG1]_OPEN2)
  +changeTileAtMarker([ARG0], [ARG1]_OPEN1, 16, 0)
@closeDoubleDoors
  +changeTileAtMarker([ARG0], [ARG1]_CLOSED2)
  +changeTileAtMarker([ARG0], [ARG1]_CLOSED1, 16, 0)

// ARG0 = marker where left-most door is
// ARG1 = door sprite, eg RED_DOOR
@openDoubleDoorsBck
  +changeTileAtMarker([ARG0], [ARG1]_BCK_OPEN2)
  +changeTileAtMarker([ARG0], [ARG1]_BCK_OPEN1, 16, 0)
@closeDoubleDoorsBck
  +changeTileAtMarker([ARG0], [ARG1]_BCK_CLOSED2)
  +changeTileAtMarker([ARG0], [ARG1]_BCK_CLOSED1, 16, 0)

// ARG0 = marker where the left-most door is
// ARG1 = door sprite, eg FANCY_DOOR
@openDoubleDoorsFwd
  +changeTileAtMarker([ARG0], [ARG1]_FWD_OPEN1)
  +changeTileAtMarker([ARG0], [ARG1]_FWD_OPEN2, 0, -16)
@closeDoubleDoorsFwd
  +changeTileAtMarker([ARG0], [ARG1]_FWD_CLOSED1)
  +changeTileAtMarker([ARG0], [ARG1]_FWD_CLOSED2, 0, -16)

// ARG0 = marker where the door is
// ARG1 = door sprite, eg TALL_RED_DOOR_BCK
@openDoor
  +changeTileAtMarker([ARG0], [ARG1]_OPEN)
@closeDoor
  +changeTileAtMarker([ARG0], [ARG1]_CLOSED)

// ARG0 = name of character to bump
// ARG1 = negative or positive px value to bump
@bumpX
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:lockCamera()
  }
  +setConversationSpeaker(none)
  +waitMS(100)
  +offsetCharacter([ARG0], [ARG1]/2, 0, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], [ARG1]/2, 0, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], -[ARG1]/2, 0, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], -[ARG1]/2, 0, 0)
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +?isnot([ARG2]):{
      +:unlockCamera()
    }
  }

// ARG0 = name of character to bump
// ARG1 = negative or positive px value to bump
@bumpY
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:lockCamera()
  }
  +setConversationSpeaker(none)
  +waitMS(100)
  +offsetCharacter([ARG0], 0, [ARG1]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, [ARG1]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, -[ARG1]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, -[ARG1]/2, 0)
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +?isnot([ARG2]):{
      +:unlockCamera()
    }
  }

// ARG0 = name of character to bump
// ARG1 = negative or positive px value to bump
// ARG2 = don't unlock
@bumpZ
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:lockCamera()
  }
  +setConversationSpeaker(none)
  +waitMS(100, '', true)
  +offsetCharacter([ARG0], 0, 0, [ARG1])
  +waitMS(100, '', true)
  +offsetCharacter([ARG0], 0, 0, -[ARG1])
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +?isnot([ARG2]):{
      +:unlockCamera()
    }
  }

// ARG0 = name of character to bump
// ARG1 = negative or positive px value to bump x
// ARG2 = negative or positive px value to bump y
@bumpXY
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:lockCamera()
  }
  +setConversationSpeaker(none)
  +waitMS(100)
  +offsetCharacter([ARG0], [ARG1]/2, [ARG2]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], [ARG1]/2, [ARG2]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], -[ARG1]/2, -[ARG2]/2, 0)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], -[ARG1]/2, -[ARG2]/2, 0)
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +?isnot([ARG3]):{
      +:unlockCamera()
    }
  }

