@utils-vr-step
// +playSound(beep);
// +setCharacterText('The Haptic Bracer is vibrating.');

// ARG0 = name of map to transition to
// ARG1 = name of marker to place player at
// ARG2 = boolean: should spawn party members?
@utils-transition-to-vr
  +:utils-transition-to-vr-fade-out()
  +:utils-transition-to-vr-fade-in([ARG0], [ARG1], [ARG2])

// like utils-transition-to-vr but only emits a fade out
@utils-transition-to-vr-fade-out
  +setConversation(Ada)
  +stopMusic(500)
// +setCharacterText('');
  +walkToMarker('Ada', MarkerVRLanding)
  +setFacing('Ada', 'down')
  +walkPartyToFormation()
  +playSound('vr_portal_buzz')
  +waitMS(500, '', true)
  +playSound('vr_portal_focus')
  +setAnimation('Ada', 'ada_enter_vr_portal')
  +waitMS(225, '', true)
  +playSound('vr_portal_start')
  +waitMS(850, '', true)
  +playSound('battle_jump')
  +waitMS(150, '', true)
  +playSound('battle_jump')
  +waitMS(250, '', true)
  +playSound('battle_jump')
  +waitMS(750, '', true)
  +playSound('battle_encountered')
  +disableAnimationSounds()
  +setConversationWithoutBars(Ada)
  +fadeOutColor(255, 255, 255, 1000)
  +changeRoom('black')
  +spawnParticleAtCharacter('EFFECT_TEMPLATE_VR_PORTAL', 'Ada', 'normal')
  +playSound('vr_portal_zoom')
  +fadeInColor(255, 255, 255, 1000)
  +waitMS(2000, '', true)
  +fadeOut()

// ARG0 = name of map to transition to
// ARG1 = name of marker to place player at
// ARG2 = boolean: should spawn party members?
@utils-transition-to-vr-fade-in
  +playSound('vr_portal_landed')
  +changeRoom([ARG0], [ARG1])
  +?is([ARG2]):{
  // +spawnPartyMembersInFormation();
    +walkPartyToFormation()
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_PORTAL_SPAWN, Party, 'normal')
  }
  +?isnot([ARG2]):{
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_PORTAL_SPAWN, 'Ada', 'normal')
  }
  +fadeIn()
//wait for the spawn particles to finish
  +waitMS(300)
  +setAnimationState('Ada', 'idle')
  +enableAnimationSounds()

@utils-transition-to-instance-fade-out
  +setConversation(Ada)
  +none()
  +stopMusic(500)
  +walkToMarker('Ada', MarkerVRLanding)
  +setFacing('Ada', 'down')
  +walkPartyToFormation()
  +playSound('vr_portal_buzz')
  +:w(500)
  +setPlayerVisibility(false)
  +playSound('spawn_enemy')
  +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  +despawnCharacter(Party)
  +:w(1000)
  +fadeOut(500)

@utils-transition-to-instance-fade-in
  +playSound('vr_portal_landed')
  +changeRoom([ARG0], [ARG1])
  +:w(200)
  +playSound('spawn_enemy')
  +?is([ARG2]):{
  // +spawnPartyMembersInFormation();
    +walkPartyToFormation()
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  }
  +?isnot([ARG2]):{
    +spawnParticleAtCharacter(EFFECT_TEMPLATE_SPAWN, Party, 'normal')
  }
  +setPlayerVisibility(true)
  +fadeIn(500)
//wait for the spawn particles to finish
  +waitMS(300)
  +setAnimationState('Ada', 'idle')
  +enableAnimationSounds()

#utils-show-ticket-token-exchange
  action,this
@this
  +setConversation(Ada)
  +:lm(Party, MarkerTicketMachine)
  Narrator: "Would you like to exchange tickets or sell items?"
  +awaitChoice("Exchange Tickets.", "Sell Items.")
  +?eq(lastChoiceIndex, 0):{
    +showStore(TICKET_EXCHANGE_MACHINE)
  }
  +?eq(lastChoiceIndex, 1):{
    +showStore(SELL)
  }
  +endConversation()

// ARG0 = name of character to spawn particles at
@utils-character-jump
  +setConversationSpeaker(none)
  +jump([ARG0])
@jump
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:lockCamera()
  }
  +callScript(utils-character-jump,[ARG0])
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +:unlockCamera()
  }

