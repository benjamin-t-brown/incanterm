  +setFacing([ARG0], 'left')
  +waitMS(33)
  +setFacing([ARG0], 'leftdown')
  +waitMS(33)
  +setFacing([ARG0], 'down')
  +none()

// ARG0 = name of first character
// ARG1 = name of other character
// returns tmp.shouldLockCamera
@checkShouldLockCamera
  +setStorage(tmp.shouldLockCamera, false)
  +?isnot(func(isCameraOnPlayer)):{
    +sbreak()
  }
  +?any(eq([ARG0], Ada), eq([ARG0], ada)):{
    +setStorage(tmp.shouldLockCamera, true)
  }
  +?any(eq([ARG0], Party), eq([ARG0], party)):{
    +setStorage(tmp.shouldLockCamera, true)
  }

// ARG0 = name of first character
// ARG1 = name of other character
// returns tmp.shouldLockCamera
@checkShouldLockCameraLeach
  +setStorage(tmp.shouldLockCamera, false)
  +?isnot(func(isCameraOnPlayer)):{
    +sbreak()
  }
  +?any(eq([ARG0], Ada), eq([ARG0], ada), eq([ARG1], Ada), eq([ARG1], ada)):{
    +setStorage(tmp.shouldLockCamera, true)
  }
  +?any(eq([ARG0], Party), eq([ARG0], party), eq([ARG1], Party), eq([ARG1], party)):{
    +setStorage(tmp.shouldLockCamera, true)
  }

// alias for setFacing
@face
  +setFacing([ARG0], [ARG1])
// alias for look direction
@ld
  +:checkShouldLockCamera([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:lockCamera(true)
  }
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, 2)
  +setFacing([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:unlockCamera(true)
  }

//alias for lookAtCharacter
@la
  +:checkShouldLockCamera([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:lockCamera(true)
  }
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, 2)
  +lookAtCharacter([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:unlockCamera(true)
  }

// alias for lookAtMarker
@lm
  +:checkShouldLockCamera([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:lockCamera(true)
  }
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, 2)
  +lookAtMarker([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:unlockCamera(true)
  }

//alias for lookAtEachOther
@leach
  +:checkShouldLockCameraLeach([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:lockCamera(true)
  }
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, -2)
  +waitMS(33, '', true)
  +offsetCharacter([ARG0], 0, 0, 2)
  +lookAtEachOther([ARG0], [ARG1])
  +?is(tmp.shouldLockCamera):{
    +:unlockCamera(true)
  }

@feach
  +lookAtEachOther([ARG0], [ARG1])

@w
  +waitMS([ARG0])

// ARG0 = party member name
@removePartyMember
  +playSound(lose_item)
  +removePartyMemberFromActiveParty([ARG0])
  Narrator: "<color=ORANGE>{ARG0}</> has been removed from the party."

// ARG0 = party member name
@addPartyMember
  +playSound(rez)
  +addPartyMemberToActiveParty([ARG0])
  Narrator: "<color=ORANGE>{ARG0}</> has joined the party."

@lockCamera
  +lockCamera([ARG0])
  // +panCameraRelativeToCurrentPosition(0, 0, 1, true)

@unlockCamera
  +unlockCamera([ARG0])
  // +panCameraBackToPlayer(1)

// ARG0 = chName
@laughObnoxiously
  +none()
  +:ld([ARG0], down)
  +playSound(boy_laugh)
  +waitMS(100)
  +:ld([ARG0], down)
  +playSound(boy_laugh)
  +waitMS(100)
  +:ld([ARG0], down)
  +playSound(boy_laugh)
  +waitMS(100)
  +:ld([ARG0], down)
  +playSound(boy_laugh)
  +waitMS(150)
  +:ld([ARG0], down)
  +playSound(boy_laugh)
  +waitMS(350)


// [ARG0] Marker Name
// [ARG1] Facing Direction
// [ARG2?] Party offset
@walkPartyToMarker
  +walkToMarker(Ada, [ARG0], 16, 0)
  +:ld(Ada, [ARG1])
  +walkPartyToFormation(false, [ARG2])