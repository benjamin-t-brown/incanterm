#load@library2Load
  +:items_restoreTrashState()
  +setPlayerWalkCh(Johnathan, 3x3)

#library2Update
  timer,library2Updater,2000
@library2Updater
  // move stuff skip wait

@library2_isUpstairs
  +[chPos]=+getChPos(John)
  +[result]=?all(gte([chPos]->0, 84), lte([chPos]->1, 13))
  <[result]

@library2_ICantReachThat
  +setConv()
  Johnathan: "I can't reach that from here."
  +endConv()

#@library2_toMaintenance
  +setConv()
  +?is(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +walkToMarker(player, FromMaintenancePanel)
  +:ld(player, up)
  +setAnimState(player, interact up)
  +setPropAnimState(doorDownstairs, open)
  +waitMs(400)
  +walkToMarker(player, FromMaintenance)
  +:ld(player, up)
  +waitMs(100)
  +changeScene(maintenance, FromLibrary2)
  +endConv()

#@library2_toMaintenanceUp
  +setConv()
  +?isnot(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +walkToMarker(player, FromMaintenanceUpPanel)
  +:ld(player, up)
  +setAnimState(player, interact up)
  +setPropAnimState(doorUpstairs, open)
  +waitMs(400)
  +walkToOffset(player, -2, 0)
  +:ld(player, up)
  +waitMs(100)
  +changeScene(maintenance, FromLibrary2Up)
  +endConv()

#step@library2_toLibrary1
  +changeScene(library1, FromLibrary2)

#library2_toLibrary1Up
  step,library2_toLibrary1Up
  action,library2_toLibrary1Up
@library2_toLibrary1Up
  +?once(library2_toLibrary1UpUnlock):{
    +setConv()
    Johnathan: "I'll make sure this is unlocked."
    +:ld(Johnathan, right)
    +schoolPuzzle.library1UpUnlocked=true
    +waitMs(500)
    +:ld(Johnathan, down)
    +waitMs(300)
    +endConv()
  }
  +changeScene(library1, FromLibrary2Up)
  +setPropAnimState(door1up, closed)

@library2_pushShelf(instance)
  +?is(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +setConv()
  +[reached]=approachSlideProp([instance])
  +?once(library2_pushShelfRealizedPushShelve):{
    Johnathan: "The bookshelves in this room all have sliding wheels on them, so they're easy to move around."
    Johnathan: "I think they use it to help clean the room."
  }
  +?isnot([reached]):{
    Johnathan: "I can't reach that."
    +endConv()
    <
  }
  +[direction]=choosePropPush([instance])
  +?eq([direction], cancel):{
    +endConv()
    <
  }
  +[settled]=slideProp([instance], [direction])
  +?isnot([settled]):{
    +log("I can't push the shelf that way.")
    +endConv()
    <
  }
  +[route]=getPropClimbPath(MarkerPathFloor2, shelfCenters)
  +?in(0, [route]):{
    Johnathan: "I think I can make it to the top."
    +:library2_runClimb([route])
    <
  }
  +endConv()

#@library2_resetShelves
  +setConv()
  +walkToMarker(player, ShelfResetSafe)
  // The marker is at (47,20); Johnathan's walk anchor is one column left.
  +[pos]=getChPos(player)
  +?all(eq([pos]->0, 46), eq([pos]->1, 20)):{
    +:ld(player, up)
    +[reset]=resetPropSlides(ShelfResetSafe)
    +?is([reset]):{
      +log("The shelves are back in place.")
    }
    +endConv()
    <
  }
  +log("I can't reach the shelf reset from here.")
  +endConv()

#@library2_checkClimbPath
  +[route]=getPropClimbPath(MarkerPathFloor2)
  +?in(0, [route]):{
    +log("Climb check: valid route to MarkerPathFloor2.")
    <
  }
  +log("Climb check: no reachable route to MarkerPathFloor2 from here.")

#@library2_climb
  +[route]=getPropClimbPath(MarkerPathFloor2, shelfCenters)
  +?isnot(in(0, [route])):{
    +log("Climb: no reachable route from here.")
    <
  }
  +:library2_runClimb([route])

@library2_runClimb(route)
  +[top]=getMarkerPos(MarkerPathFloorTop)
  +[entry]=[route]->0
  +[entryX]=[entry]->0
  +[entryY]=[entry]->1
  +[start]=getChPos(player)
  +[startX]=[start]->0
  +[startY]=[start]->1
  +[dx]=[entryX]-[startX]
  +[dy]=[entryY]-[startY]
  +setConv()
  +walkToOffset(player, [dx], [dy])
  +[arrived]=getChPos(player)
  +?isnot(all(eq([arrived]->0, [entryX]), eq([arrived]->1, [entryY]))):{
    +log("Climb: Johnathan couldn't reach the first shelf.")
    +endConv()
    <
  }
  +setChForeground(player, true)
  // Skip the walking entry and the logical landing. Visit each shelf once.
  +setAnimState(player, jump)
  +waitMs(100)
  +[i]=1
  +[next]=2
  +?while in([next], [route]):{
    +[stop]=[route]->[i]
    +setChPos(player, [stop]->0, [stop]->1)
    +setAnimState(player, jump)
    +waitMs(175)
    +[stopY]=[stop]->1
    +[yMinus1]=[stopY]-1
    +setChPos(player, [stop]->0, [yMinus1])
    +waitMs(100)
    +[i]=[next]
    +[next]=[next]+1
  }
  +setChPos(player, [top]->0, [top]->1)
  +setAnimState(player, idle)
  +setChForeground(player, false)
  Johnathan: "Phew... that was precarious. Let's shelve that idea and use the stairs from now on."
  +endConv()

#@library2_terminalReset
  +setConv()
  +walkToMarker(Johnathan, MarkerTerminalReset)
  +setFacing(Johnathan, up)
  +?once(library2_terminalReset):{
    Johnathan: "Hmm. What does this terminal do?"
    Terminal: "HELLO! This is a Bookshelf Management terminal."
  }
  +awaitChoice("Would you like to reset the bookshelves in this room?", "Yes", "No")
  +?switch(lastChoiceIndex):{
    0:{
      +fadeOut(300)
      +resetPropSlides(ShelfResetSafe)
      +waitMs(100)
      +fadeIn(300)
    }
    1: {
      Terminal: "Please return when you have Bookshelf Management needs!"
    }
  }
  +endConv()
