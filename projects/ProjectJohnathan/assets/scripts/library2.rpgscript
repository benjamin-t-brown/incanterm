#load@library2Load
  +setPlayerWalkCh(Johnathan, 3x3)

#library2Update
  timer,library2Updater,2000
@library2Updater
  // move stuff skip wait

@library2_isUpstairs
  +[chPos]=+getChPos(John)
  +[result]=?all(gte([chPos]->0, 84), lte([chPos]->1, 13))
  <[result]

@library2_ICantReachThat
  +setConv()
  Johnathan: "I can't reach that from here."
  +endConv()

#@library2_toMaintenance
  +setConv()
  +?is(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +walkToMarker(player, FromMaintenancePanel)
  +:ld(player, up)
  +setAnimState(player, interact up)
  +setPropAnimState(doorDownstairs, open)
  +waitMs(400)
  +walkToMarker(player, FromMaintenance)
  +:ld(player, up)
  +waitMs(100)
  +changeScene(maintenance, FromLibrary2)
  +endConv()

#@library2_toMaintenanceUp
  +setConv()
  +?isnot(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +walkToMarker(player, FromMaintenanceUpPanel)
  +:ld(player, up)
  +setAnimState(player, interact up)
  +setPropAnimState(doorUpstairs, open)
  +waitMs(400)
  +walkToMarker(player, FromMaintenance)
  +:ld(player, up)
  +waitMs(100)
  +changeScene(maintenance, FromLibrary2Up)
  +endConv()

#step@library2_toLibrary1
  +changeScene(library1, FromLibrary2)

#step@library2_toLibrary1Up
  +changeScene(library1, FromLibrary2Up)

@library2_pushShelf(instance)
  +?is(+:library2_isUpstairs()):{
    +:library2_ICantReachThat()
    <
  }
  +setConv()
  +[reached]=approachSlideProp([instance])
  +?isnot([reached]):{
    Johnathan: "I can't reach that."
    +endConv()
    <
  }
  +[direction]=choosePropPush([instance])
  +?eq([direction], cancel):{
    +endConv()
    <
  }
  +[settled]=slideProp([instance], [direction])
  +?isnot([settled]):{
    +log("I can't push the shelf that way.")
  }
  +endConv()

#@library2_resetShelves
  +setConv()
  +walkToMarker(player, ShelfResetSafe)
  // The marker is at (47,20); Johnathan's walk anchor is one column left.
  +[pos]=getChPos(player)
  +?all(eq([pos]->0, 46), eq([pos]->1, 20)):{
    +:ld(player, up)
    +[reset]=resetPropSlides(ShelfResetSafe)
    +?is([reset]):{
      +log("The shelves are back in place.")
    }
    +endConv()
    <
  }
  +log("I can't reach the shelf reset from here.")
  +endConv()
