  }
  +walkToMarker(John, MarkerBooksD)
  +:ld(John, up)
  +?once(library1_bookshelf6):{
    Johnathan: "Adventure books. Well I like adventure games so maybe these are good."
    +:library1_animateGetBook(up)
    +acquireItem("Book: In the Seeing Mirror by Allison Vonderland")
  }
  +?else:{
