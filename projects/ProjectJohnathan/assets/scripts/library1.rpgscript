  }
  +walkToMarker(John, MarkerBooksC)
  +:ld(John, up)
  +?once(library1_bookshelf5):{
    Johnathan: "There's some old literature here, for sure."
    +:library1_animateGetBook(up)
    +acquireItem("Book: Leo Tolstoy's Legacy by Warren Peece")
  }
  +?else:{
