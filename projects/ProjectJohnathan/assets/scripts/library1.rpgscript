  }
  +walkToMarker(John, MarkerBooksB)
  +:ld(John, right)
  +?once(library1_bookshelf4):{
    Johnathan: "Hmm, let's see... This one looks like it provides a sturdy foundation."
    +:library1_animateGetBook(right)
    +acquireItem("Book: Statics and Architecture by Bill Ding")
  }
  +?else:{
    Johnathan: "I don't need more books from there."
  }
  +endConv()

