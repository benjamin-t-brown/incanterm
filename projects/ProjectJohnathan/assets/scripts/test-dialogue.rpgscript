// A small integration smoke test. Each keypress advances one spoken line.
@testDialogue1
  Guide: "Welcome to Incanterm."
  Guide: "The crate  is waiting for you."
  +:testDialogue2()

@testDialogue2
  Guide: "See you soon."
  +setStorage(a, true)
  +log("A is set")
  +?is(a):{
    +setStorage(a, false)
    +log("A is set")
  }
  +?else():{

  }

@testDialogue3
  +vars.test1=56
  +?switch(a56):{
    a: {
      +log("raw vars test1")
    }
    "{vars.test1}": {
      +log("56 somehow")
    }
    false: {
      +log("pizza false")
    }
    true: {
      +log("pizza true")
    }
    "*": {

    }
    *:{
      +log("default")
    }
  }