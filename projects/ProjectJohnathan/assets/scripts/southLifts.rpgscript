#load@southLiftsLoad
  +:items_restoreTrashState()
  +setPlayerWalkCh(Johnathan, 3x3)

#southLiftsUpdate
  timer,southLiftsUpdater,2000
@southLiftsUpdater
  // move stuff skip wait

#step@southLifts_toHallway2
  +changeScene(hallway2, FromSouthLifts)

#step@southLifts_toLibrary1
  +changeScene(library1, FromSouthLifts)
  +setPropAnimState(door1_diag_1, closing)

@southLifts_MaintenanceTalk
  +:schoolPuzzle_talkMaintenance()

@southLifts_HaddyTalk
  +setConv2(Johnathan, Haddy)
  +?once(southLifts_HaddyTalk1):{
    Johnathan: "Uh, it's Hadassah, right?"
    Haddy: "Haddy."
    Johnathan&embarrassed: "Right, sorry."
    Haddy: "Don't worry about it."
    Johnathan&confused: "Are you... waiting for something?"
    Haddy: "Yeah. These lifts. It's been several minutes and none have come yet."
    +?is(schoolPuzzle.knowsElevatorsAreDown):{
      +schoolPuzzle.toldHaddyAboutElevators=true
      Johnathan: "Apparently the elevators are down, and Maintenance is working on it."
      Haddy: "Oh yeah? Well that explains things."
      +waitMs(750)
      Johnathan&confused: "Are you... gonna leave now?"
      Haddy: "No, why? What else am I gonna do except wait for the elevators to work? We're not supposed to use the stairs."
      Johnathan&thinking: "Yeah I guess so."
    }
    +?else:{
      Johnathan&thinking: "Weird."
      Haddy: "Yep. So I guess I'll just keep on waiting."
    }
  }
  +?else:{
    +?all(once(southLifts_HaddyTalk2), isnot(schoolPuzzle.toldHaddyAboutElevators), is(schoolPuzzle.knowsElevatorsAreDown)):{
      +schoolPuzzle.toldHaddyAboutElevators=true
      Johnathan: "Apparently the elevators are down, and Maintenance is working on it."
      Haddy: "Oh yeah? Well that explains things."
      +waitMs(750)
      Johnathan&confused: "Are you... gonna leave now?"
      Haddy: "No, why? What else am I gonna do except wait for the elevators to work? We're not supposed to use the stairs."
      Johnathan&thinking: "Yeah I guess so."
    }
    +?else:{
      Johnathan: "Still waiting?"
      Haddy: "Yeppers."
    }
  }
  +endConv()

#@southLifts_elevators
  +setConv()
  +walkToMarker(player, MarkerLifts)
  +:ld(Johnathan, down)
  Johnathan: "I don't need to use the elevators right now."
  +endConv()

#@southLifts_elevatorsButton
  +setConv()
  +walkToMarker(player, MarkerLifts)
  +:ld(Johnathan, down)
  +waitMs(500)
  +:ld(Johnathan, right)
  Johnathan: "I think she already hit the button."
  +endConv()
