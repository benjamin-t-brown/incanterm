#load@hallwayGymLoad
  +:items_restoreTrashState()
  +setPlayerWalkCh(Johnathan, 3x3)
  +?all(is(schoolPuzzle.isTryingToGetPastBlueDoor), isnot(schoolPuzzle.askedViviOut)):{
    +:hallwayGym_spawnVivi()
  }

#hallwayGymUpdate
  timer,hallwayGymUpdater,2000
@hallwayGymUpdater
  // move stuff skip wait

#step@hallwayGym_toHallway1
  +changeScene(hallway1, FromGym)

@hallwayGym_spawnVivi
  +spawnCh(Vivi, 3x3, MarkerVivi)
  +:ld(Vivi, left)

#@hallwayGym_vendEnergy
  +?is(schoolPuzzle.drinkRequested):{
    +walkToMarkerInt(player, EnergyMarker)
    +:ld(player, up)
    +:schoolPuzzle_buyEnergyDrink()
    <
  }
  +setConv()
  +^tmp.hallwayGymEnergyTalk=0
  +walkToMarkerInt(player, EnergyMarker)
  +:ld(player, up)
  +?switch(tmp.hallwayGymEnergyTalk):{
    0: {
      Johnathan: "The energy drinks in this machine are so gross. They have flavors like salty bubblegum or lightly-spiced water. Even if I had money I wouldn't spend it here."
      +tmp.hallwayGymEnergyTalk=1
    }
    1: {
      Johnathan: "Just looking at the energy drink machine makes me tired."
      +tmp.hallwayGymEnergyTalk=2
    }
    *: {
      Johnathan: "Yeah, I'm not putting any money in that thing."
    }
  }
  +endConv()

#@hallwayGym_vendLime
  +setConv()
  +^tmp.hallwayGymLimeTalk=0
  +walkToMarkerInt(player, LimeMarker)
  +:ld(player, up)
  +?switch(tmp.hallwayGymLimeTalk):{
    0: {
      Johnathan: "Lime soda. It was a fad last year but I don't think this machine has been touched since then. Not worth the cash." // voice v_5196b899-1d74-4582-88db-efed8fd1069c
      +tmp.hallwayGymLimeTalk=1
    }
    1: {
      Johnathan: "The cans are probably more carbonated dust than drink by now."
      +tmp.hallwayGymLimeTalk=2
    }
    *: {
      Johnathan: "I'll pass."
    }
  }
  +endConv()

#@hallwayGym_trash
  +walkToMarkerInt(player, TrashMarker)
  +:ld(player, up)
  +:items_searchTrash()

#@hallwayGym_trianglePoster
  +^tmp.hallwayGymTriangleTalk=0
  +setConv()
  +walkToMarkerInt(player, MarkerPoster)
  +:ld(Johnathan, up)
  +?switch(tmp.hallwayGymTriangleTalk):{
    0: {
      Johnathan: "A poster of a triangle. Geometry pride, I guess?"
      +tmp.hallwayGymTriangleTalk=1
    }
    1: {
      Johnathan: "It says something about 'finding your angle.' Cute."
      +tmp.hallwayGymTriangleTalk=2
    }
    *: {
      Johnathan: "Still just a triangle."
    }
  }
  +endConv()

#@hallwayGym_blueBanners
  +setConv()
  +:ld(Johnathan, up)
  Johnathan: "The blue banners salute basketball excellence from the past years. I used to be able to dunk but my knees went out on me."
  +endConv()

#@hallwayGym_redBanner
  +setConv()
  +:ld(Johnathan, up)
  Johnathan: "The red banner is for some kind of virtual game called GDL. Not really sure what it is, honestly, but apparently Erran Valley High School has some sort of award for it."
  +endConv()

#@hallwayGym_gymDoor
  +setConv()
  +^tmp.hallwayGymGymDoorTalk=0
  +walkToMarkerInt(John, MarkerGym)
  +:ld(John, right)
  +?switch(tmp.hallwayGymGymDoorTalk):{
    0: {
      Johnathan: "This leads to the gym. Basketball practice should be starting soon."
      +tmp.hallwayGymGymDoorTalk=1
    }
    1: {
      Johnathan: "This is the wrong way if I'm supposed to be taking this envelope to the office."
      +tmp.hallwayGymGymDoorTalk=2
    }
    *: {
      Johnathan: "I don't need to go in the gym right now."
    }
  }
  +endConv()

#@hallwayGym_outsideDoor
  +setConv()
  +^tmp.hallwayGymOutsideTalk=0
  +walkToMarkerInt(John, MarkerOutside)
  +:ld(John, up)
  +?switch(tmp.hallwayGymOutsideTalk):{
    0: {
      Johnathan: "That leads outside. I'm not leaving yet, I need to get this envelope to the office!"
      +tmp.hallwayGymOutsideTalk=1
    }
    1: {
      Johnathan: "Fresh air can wait. Envelope first."
      +tmp.hallwayGymOutsideTalk=2
    }
    *: {
      Johnathan: "As much as I'd like to get to my job interview, I'm not heading out yet."
    }
  }
  +endConv()

#@hallwayGym_bathroomDoor
  +^tmp.hallwayGymBathroomTalk=0
  +setConv()
  +?switch(tmp.hallwayGymBathroomTalk):{
    0: {
      Johnathan: "The bathroom. I don't need to go."
      +tmp.hallwayGymBathroomTalk=1
    }
    *: {
      Johnathan: "I don't need to go."
    }
  }
  +endConv()

#hallwayGym_talkVivi1Step
  step,?all(is(schoolPuzzle.isTryingToGetPastBlueDoor), isnot(schoolPuzzle.askedViviOut)):hallwayGym_talkVivi1
@hallwayGym_talkVivi1
  +setConv()
  Johnathan: "Oh! Vivi! Over here!"
  +walkToMarker(Vivi, MarkerVivi2, true)
  +walkToMarker(John, MarkerJohn2, true)
  +waiMs(3000)
  +setConv2(Vivi, Johnathan)
  Johnathan: "Hey Vivi."
  Vivi: "Hey."
  Johnathan&happy: "So.. uh... you got basketball practice today?"
  Vivi&shy: "Yeah."
  Vivi: "Playoffs are soon. So..."
  Vivi&confident: "Gotta practice."
  Johnathan: "Yeah? Nice."
  +waitMs(1000)
  Vivi&happy: "Did you want something?"
  Johnathan&bored: "*sigh* Always to the point, aren't you? I was building towards it."
  Vivi&confused: "Towards what?"
  Johnathan: "I've always thought you were pretty cool... And that I'd like to get to know you better."
  Vivi: "Oh..."
  Johnathan&thinking: "Yeah."
  Johnathan: "Do you want to go out with me? Maybe we can get a coffee sometime?"
  Vivi&patient: "Um..."
  +:ld(Vivi, down)
  Vivi&shy: "Well... I... um..."
  +:ld(Vivi, left)
  Vivi&patient: "Um...."
  Johnathan&surprised: "Are you okay?"
  +:ld(Vivi, right)
  Vivi&sad: "No thanks. I'm... not interested."
  Johnathan&bored: "Oof."
  Johnathan&sad: "Well okay then."
  Vivi&sad: "I'm really sorry."
  Vivi: "I just can't."
  Vivi&sad: "Sorry."
  Vivi: "I'm really sorry!"
  Johnathan&pleased: "It's okay. Honestly now I'm just relieved that's over."
  +walkToOffset(Vivi, -1, 0)
  Vivi&sad: "Thats... not what I meant."

  // Otis walks over
  +spawnCh(Otis, default, hallwayGym_bathroomDoor)
  +waitMs(500)
  +walkToMarker(Otis, MarkerOtis2)
  +:ld(Otis, up)

  +setConv()
  Otis&happy: "Would you look at that? Here are my two favorite people."
  Otis: "What's the happs with you two love birds?"
  +:ld(Otis, left)
  Otis&angry: "Wait a sec... What's going on? Why do you look so sad?"
  +walkToOffset(Vivi, 0, 1)
  Vivi: "Hey..."
  +setConv2(Vivi, Otis)
  Vivi&angry: "Did you put him up to this?"
  Otis&surprised: "Whoah whoah, slow down. Up to what?"
  Vivi&angry: "I can't believe this. Are you trying to piss me off?"
  Otis&happy: "What? No!"
  +setConv2(Vivi, Johnathan)
  Vivi: "Johnathan, tell me the truth. Did Otis tell you to ask me out?"
  Johnathan&embarrassed: "Yeah... he did. He said we'd be a good match."
  Vivi&angry: "I knew it!"
  +setConv()
  Otis&angry: "Well, yeah, cuz you are a good match!"
  +setConv2(Vivi, Otis)
  Vivi&angry: "That isn't the point, and you know it!"
  Vivi&sad: "You know I can't. Not right now."
  Otis&angry: "Oh come on, Vivi. You don't have to do whatever you're told all the time."
  Vivi&angry: "Ohh... I can't stand you sometimes!"
  Vivi&angry: "Stop trying to run my life!"
  +walkToOffset(Vivi, -23, 0)
  +despawnCh(Vivi)
  Otis&angry: "Hey! Don't you have basketball practice?"
  +walkToOffset(Otis, -2, 0)
  Otis: "You're gonna miss it!"
  
  +schoolPuzzle.askedViviOut=true
  +endConv()
